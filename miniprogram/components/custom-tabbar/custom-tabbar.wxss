/* components/custom-tabbar/custom-tabbar.wxss */
.custom-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 999;
}

/* 中间占位区域保持透明 */
.center-placeholder {
  width: 60rpx;
  height: 60rpx;
}

/* 中间凸起按钮容器 */
.center-button {
  position: absolute;
  left: 50%;
  bottom: 20rpx;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 1001;
}

/* 凸起按钮主体 */
.center-button-inner {
  width: 108rpx;
  height: 108rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 50%;
  border: 4rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.45);
  margin-bottom: 6rpx;
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  animation: bounce 3s ease-in-out infinite;
}

@keyframes bounce {

  0%,
  100% {
    transform: translateY(0);
  }

  50% {
    transform: translateY(-8rpx);
  }
}

.center-button-inner:active {
  transform: scale(0.9) translateY(0);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

/* 服务文字 */
.center-button-text {
  font-size: 22rpx;
  color: #667eea;
  font-weight: 500;
  margin-top: 4rpx;
}
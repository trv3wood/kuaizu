.auth-badge {
  flex-shrink: 0;
}

.auth-badge--verified.auth-badge--default {
  width: 40rpx;
  height: 40rpx;
}

.auth-badge--unverified.auth-badge--default {
  width: 70rpx;
  height: 70rpx;
}

.auth-badge--verified.auth-badge--compact {
  width: 32rpx;
  height: 32rpx;
}

.auth-badge--unverified.auth-badge--compact {
  width: 54rpx;
  height: 54rpx;
}

.auth-badge--verified.auth-badge--tiny {
  width: 24rpx;
  height: 24rpx;
}

.auth-badge--unverified.auth-badge--tiny {
  width: 40rpx;
  height: 40rpx;
}

.auth-badge--clickable {
  cursor: pointer;
}

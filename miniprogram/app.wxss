@import "styles/common.wxss";

/** app.wxss **/

/* ==========================================
   1. CSS 变量与基础重置 (CSS Variables & Reset)
   ========================================== */
page {
  /* 定义全局主题颜色 */
  --primary-color: #5bb4ff; /* 主色调：按钮、图标的蓝色 */
  --color-primary: var(--primary-color);
  --bg-color: #f5f7fa;      /* 页面最底层的浅灰白背景色 */
  --bg-page-soft: #f5f7fa;
  --bg-page-muted: #f6f7fb;
  --card-bg: #ffffff;       /* 卡片背景色 */
  --bg-hero-blue: #cff4ff;
  --bg-pill-blue: #cff2fe;
  --bg-soft-blue: #e8f4ff;
  --bg-muted-chip: #f5f5f5;
  --bg-gradient-start: #c4f1ff;
  --bg-gradient-mid: #eaf4fc;
  --bg-gradient-end: #fafbfc;
  
  /* 定义全局文字颜色 */
  --text-main: #333333;     /* 主标题/正文颜色 */
  --color-text-main: var(--text-main);
  --text-gray: #999999;     /* 辅助说明/次要文字颜色 */
  --color-text-secondary: var(--text-gray);
  --text-light: #cccccc;    /* 极浅的灰色文字 */
  --color-text-tertiary: #b6bec8;
  --color-text-inverse: #ffffff;

  /* 圆角、边框与阴影 */
  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 40rpx;
  --radius-pill: 999rpx;
  --border-light: #f0f0f0;
  --border-muted: #e8edf2;
  --shadow-sm: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 4rpx 4rpx 12rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 12rpx 36rpx rgba(0, 0, 0, 0.12);
  --shadow-hero: 0 4rpx 14rpx rgba(0, 0, 0, 0.12);
  --shadow-fab: 0 16rpx 28rpx rgba(76, 149, 246, 0.34);

  /* 间距 */
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 44rpx;

  /* 基础页面设置 */
  background-color: var(--bg-color);
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica,
    Segoe UI, Arial, Roboto, 'PingFang SC', 'miui', 'Hiragino Sans GB', 'Microsoft Yahei',
    sans-serif;
  font-size: 28rpx;
  color: var(--text-main);
  box-sizing: border-box;
}

/* 重置所有基础组件的盒模型 */
view, text, scroll-view, image, button, input {
  box-sizing: border-box;
}

/* 去除 button 的默认边框和背景 */
button {
  margin: 0;
  padding: 0;
  background-color: transparent;
  border-radius: 0;
}
button::after {
  border: none;
}

/* ==========================================
   2. Flex 布局工具类 (Flexbox Utilities)
   ========================================== */
/* 基础 Flex */
.flex { display: flex; }
.flex-row { display: flex; flex-direction: row; }
.flex-col { display: flex; flex-direction: column; }

/* 居中对齐 */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 垂直居中 */
.flex-y-center {
  display: flex;
  align-items: center;
}

/* 水平居中 */
.flex-x-center {
  display: flex;
  justify-content: center;
}

/* 两端对齐 */
.flex-space-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 占满剩余空间 */
.flex-1 { flex: 1; }

/* ==========================================
   3. 通用 UI 组件 (Common UI Components)
   ========================================== */

/* 统一卡片样式 (对应图中的白色模块) */
.card {
  background-color: var(--card-bg);
  border-radius: 32rpx; /* 大圆角 */
  padding: 30rpx;
  margin: 0 30rpx 30rpx 30rpx; /* 统一的外边距 */
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04); /* 柔和的阴影 */
}

/* 页面顶部的浅蓝色渐变背景 (可以通过固定定位放在最底层) */
.page-top-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 60vh;
  background: linear-gradient(to bottom, #d5edff 0%, #e8f4ff 40%, var(--bg-color) 100%);
  z-index: -1;
}

/* 分割线 (卡片内部的虚线) */
.divider-dashed {
  width: 100%;
  height: 1px;
  border-top: 1px dashed #e5e5e5;
  margin: 20rpx 0;
}

/* ==========================================
   4. 字体与排版工具类 (Typography Utilities)
   ========================================== */

/* 字号 */
.font-xl { font-size: 44rpx; } /* 超大标题，如“快组校园” */
.font-l  { font-size: 36rpx; }  /* 模块标题，如“校园项目”、“个人中心名字” */
.font-m  { font-size: 28rpx; }  /* 常规正文 */
.font-s  { font-size: 24rpx; }  /* 辅助文字，如底部“了解快组校园” */

/* 字重 */
.text-bold { font-weight: bold; }
.text-medium { font-weight: 500; }

/* 颜色 */
.color-main { color: var(--text-main); }
.color-gray { color: var(--text-gray); }
.color-primary { color: var(--primary-color); }
.color-white { color: #ffffff; }

/* 文本截断 (单行省略号) */
.text-ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* ==========================================
   5. 安全距离边距 (Safe Area Padding)
   ========================================== */
/* 由于使用了自定义顶部导航和自定义底部TabBar，需要预留空间 */

/* 顶部内容区域下推距离 (具体数值需根据自定义导航栏高度计算) */
.padding-top-nav {
  padding-top: 180rpx; 
}

/* 底部留白，防止内容被自定义 TabBar 遮挡 */
.padding-bottom-tabbar {
  padding-bottom: 220rpx;
}

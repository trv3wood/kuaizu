<!-- custom-tab-bar/index.wxml -->
<van-tabbar active="{{ active }}" bind:change="onChange" active-color="#1989fa" inactive-color="#7d7e80" z-index="999">
  <!-- 首页 -->
  <van-tabbar-item icon="wap-home-o">首页</van-tabbar-item>
  <!-- 人才 -->
  <van-tabbar-item icon="friends-o">人才</van-tabbar-item>
  <!-- 服务 -->
  <van-tabbar-item class="service-tab-item">
    <view slot="icon" class="service-icon-wrapper">
      <van-icon name="diamond-o" size="24px" color="#fff" />
    </view>
    <view slot="icon-active" class="service-icon-wrapper active">
      <van-icon name="diamond-o" size="24px" color="#fff" />
    </view>
    服务
  </van-tabbar-item>
  <!-- 我的 -->
  <van-tabbar-item icon="user-o">我的</van-tabbar-item>
</van-tabbar>
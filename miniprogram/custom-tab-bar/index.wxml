<!-- custom-tab-bar/index.wxml -->
<van-tabbar active="{{ active }}" bind:change="onChange" active-color="#1989fa" inactive-color="#7d7e80" z-index="999">
  <!-- 导览 -->
  <van-tabbar-item icon="guide-o">导览</van-tabbar-item>
  <!-- 发布 (中间凸起按钮) -->
  <van-tabbar-item>
    <view slot="icon" class="center-btn-wrapper">
      <van-icon name="plus" size="26px" color="#fff" />
    </view>
    <view slot="icon-active" class="center-btn-wrapper active">
      <van-icon name="plus" size="26px" color="#fff" />
    </view>
    发布
  </van-tabbar-item>
  <!-- 我的 -->
  <van-tabbar-item icon="user-o">我的</van-tabbar-item>
</van-tabbar>
<!-- 发布选项弹窗 -->
<van-action-sheet show="{{ showPublishPopup }}" actions="{{ publishActions }}" cancel-text="取消" bind:close="onClosePublishPopup" bind:cancel="onClosePublishPopup" bind:select="onPublishSelect" />

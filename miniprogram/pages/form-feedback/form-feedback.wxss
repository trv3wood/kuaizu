/* pages/form-feedback/form-feedback.wxss */

.feedback-container {
  min-height: 100vh;
  padding: 30rpx;
  padding-bottom: 120rpx;
  background-color: #efefef;
}

.feedback-section {
  margin-bottom: 30rpx;
}

.feedback-textarea {
  width: 100%;
  min-height: 320rpx;
  background-color: #fff;
  border-radius: 30rpx;
  padding: 20rpx;
  font-size: 30rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.email-section {
  background-color: #fff;
  border-radius: 30rpx;
  padding: 20rpx 20rpx 30rpx 20rpx;
  margin-bottom: 30rpx;
}

.email-tip {
  font-size: 28rpx;
  color: #323233;
  margin-bottom: 20rpx;
}

.email-input-wrapper {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.email-label {
  font-size: 30rpx;
  color: #323233;
  white-space: nowrap;
}

.email-input {
  flex: 1;
  background-color: #f0f0f0;
  height: 70rpx;
  border-radius: 20rpx;
  padding-left: 15rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.button-placeholder {
  height: 100rpx;
}

.submit-section {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 100%;
  padding: 20rpx 30rpx 30rpx 30rpx;
  background-color: #fff;
  z-index: 100;
  box-sizing: border-box;
}

.submit-button {
  width: 80%;
  border-radius: 30rpx;
  color: #fff;
  background-color: rgb(0, 177, 38);
  margin: 0 auto;
  display: block;
}

.submit-button::after {
  border: none;
}

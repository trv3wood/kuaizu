/* pages/project-detail/project-detail.wxss */

/* ===== 页面容器 ===== */
.project-detail-container {
    min-height: 100vh;
    padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

/* ===== 顶部白色头部 ===== */
.header-area {
    background: var(--card-bg);
    padding: 24rpx 36rpx 30rpx;
    box-shadow: var(--shadow-sm);
}

/* 学校徽章 */
.school-badge {
    padding: 6rpx 24rpx 6rpx 12rpx;
    margin-bottom: 20rpx;
}

.school-icon {
    font-size: 28rpx;
    margin-right: 8rpx;
}

.school-badge-text {
    font-size: 24rpx;
    font-weight: 600;
    color: #000000;
}

/* 项目标题 */
.project-title {
    font-size: 48rpx;
    font-weight: 700;
    color: #000000;
    line-height: 1.35;
    margin-bottom: 16rpx;
}

/* 阅读量 */
.view-count-row {
    display: flex;
    align-items: center;
    gap: 8rpx;
}

.view-count-text {
    font-size: 30rpx;
    font-weight: 600;
    color: #989da5;
}

/* ===== 标签行 ===== */
.tag-row {
    display: flex;
    gap: 16rpx;
    padding: 30rpx 36rpx 10rpx;
}

.info-pill {
    padding: 10rpx 24rpx;
    gap: 6rpx;
}

.pill-icon {
    font-size: 26rpx;
}

.pill-text {
    font-size: 32rpx;
    font-weight: 500;
    color: #000000;
}

/* ===== 描述卡片 ===== */
.desc-card {
    margin: 20rpx 36rpx 24rpx;
    padding: 32rpx 36rpx;
}

.desc-text {
    font-size: 32rpx;
    color: rgba(0, 0, 0, 0.8);
    line-height: 1.65;
    white-space: pre-wrap;
    word-break: break-all;
}

/* ===== 底部操作区 ===== */
.bottom-actions {
    padding: 0 36rpx;
}

/* 投递名片按钮 */
.deliver-btn {
    margin-bottom: 20rpx;
}

/* 分享按钮行 */
.share-row {
    display: flex;
    justify-content: center;
    gap: 24rpx;
    margin-top: 10rpx;
}

/* ===== 公开联系方式 ===== */
.public-contact-row {
    display: flex;
    gap: 16rpx;
    padding: 4rpx 36rpx 0;
    flex-wrap: wrap;
}

.contact-pill {
    min-width: 0;
    flex: 1 1 200rpx;
    height: 88rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12rpx;
    padding: 0 24rpx;
    background: linear-gradient(135deg, #8fc1ff 0%, #6fa6f5 100%);
    border-radius: var(--radius-xl);
    box-shadow: 0 8rpx 16rpx rgba(111, 166, 245, 0.22);
    box-sizing: border-box;
}

.contact-pill-text {
    min-width: 0;
    font-size: 24rpx;
    font-weight: 600;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* ===== 底部声明 ===== */
.footer-note {
    padding: 40rpx 60rpx 20rpx;
}

.footer-divider {
    height: 1rpx;
    background: #e0e0e0;
    margin-bottom: 20rpx;
}

.footer-text {
    display: block;
    font-size: 28rpx;
    color: rgba(0, 0, 0, 0.3);
}

/* ===== 空状态 ===== */
.empty-container {
    padding: 100rpx 0;
}

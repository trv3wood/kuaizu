/* pages/project-detail/project-detail.wxss */
.project-detail-container {
    min-height: 100vh;
    background: var(--bg-color);
    padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 加载中 */
.loading-container {
    padding: 100rpx 0;
    display: flex;
    justify-content: center;
}

/* 头部卡片 */
.project-header {
    background: #e8f4ff;
    padding: 40rpx 40rpx;
    margin: 30rpx;
    border-radius: 32rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.header-content {
    color: var(--primary-color);
}

.project-name {
    display: block;
    font-size: 36rpx;
    font-weight: bold;
    margin-bottom: 16rpx;
}

.status-row {
    display: flex;
    gap: 12rpx;
}

/* 内容区块 */
.section {
    background: var(--card-bg);
    border-radius: 24rpx;
    padding: 30rpx;
    margin: 0 30rpx 30rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.section-title {
    display: block;
    font-size: 32rpx;
    font-weight: 500;
    color: var(--text-main);
    margin-bottom: 16rpx;
}

.section-content {
    font-size: 32rpx;
    color: var(--text-gray);
    line-height: 1.8;
    white-space: pre-wrap;
}

/* 信息行 */
.info-row {
    display: flex;
    align-items: center;
    gap: 12rpx;
    margin-bottom: 16rpx;
}

.info-row:last-child {
    margin-bottom: 0;
}

.info-text {
    font-size: 28rpx;
    color: var(--text-gray);
}

/* 发起人信息 */
.creator-info {
    display: flex;
    align-items: center;
    gap: 20rpx;
}

.creator-avatar {
    width: 96rpx;
    height: 96rpx;
    border-radius: 50%;
    background: #f0f0f0;
}

.creator-detail {
    flex: 1;
}

.creator-name {
    display: block;
    font-size: 32rpx;
    font-weight: 500;
    color: var(--text-main);
    margin-bottom: 6rpx;
}

.creator-uid,
.creator-contact {
    display: block;
    font-size: 24rpx;
    color: var(--text-gray);
}

/* 底部操作栏 */
.action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 30rpx 40rpx;
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    background: var(--card-bg);
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.apply-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 96rpx;
    background: var(--primary-color);
    color: #ffffff;
    font-size: 28rpx;
    font-weight: 500;
    border-radius: 48rpx;
    border: none;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.apply-btn::after {
    border: none;
}

.apply-btn[disabled] {
    background: var(--text-main);
    opacity: 0.12;
    color: var(--text-main);
}

/* 空状态 */
.empty-container {
    padding: 100rpx 0;
}
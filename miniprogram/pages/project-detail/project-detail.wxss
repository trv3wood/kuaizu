/* pages/project-detail/project-detail.wxss */
.project-detail-container {
    min-height: 100vh;
    background: var(--color-bg-base);
    padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 加载中 */
.loading-container {
    padding: 100rpx 0;
    display: flex;
    justify-content: center;
}

/* 头部卡片 */
.project-header {
    background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary-dark) 100%);
    padding: 40rpx var(--spacing-md);
    margin: var(--spacing-sm);
    border-radius: var(--radius-lg);
}

.header-content {
    color: var(--color-text-inverse);
}

.project-name {
    display: block;
    font-size: 40rpx;
    font-weight: bold;
    margin-bottom: 16rpx;
}

.status-row {
    display: flex;
    gap: 12rpx;
}

/* 内容区块 */
.section {
    background: var(--color-bg-card);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm);
    margin: 0 var(--spacing-sm) var(--spacing-sm);
}

.section-title {
    display: block;
    font-size: 28rpx;
    font-weight: 500;
    color: var(--color-text-main);
    margin-bottom: 16rpx;
}

.section-content {
    font-size: 28rpx;
    color: var(--color-text-secondary);
    line-height: 1.8;
    white-space: pre-wrap;
}

/* 信息行 */
.info-row {
    display: flex;
    align-items: center;
    gap: 12rpx;
    margin-bottom: 16rpx;
}

.info-row:last-child {
    margin-bottom: 0;
}

.info-text {
    font-size: 28rpx;
    color: var(--color-text-secondary);
}

/* 发起人信息 */
.creator-info {
    display: flex;
    align-items: center;
    gap: 20rpx;
}

.creator-avatar {
    width: 96rpx;
    height: 96rpx;
    border-radius: 50%;
    background: var(--color-bg-base);
}

.creator-detail {
    flex: 1;
}

.creator-name {
    display: block;
    font-size: 30rpx;
    font-weight: 500;
    color: var(--color-text-main);
    margin-bottom: 6rpx;
}

.creator-uid,
.creator-contact {
    display: block;
    font-size: 26rpx;
    color: var(--color-text-tertiary);
}

/* 底部操作栏 */
.action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--spacing-sm) var(--spacing-md);
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    background: var(--color-bg-card);
    box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.apply-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 96rpx;
    background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary-dark) 100%);
    color: var(--color-text-inverse);
    font-size: 32rpx;
    font-weight: 500;
    border-radius: 48rpx;
    border: none;
}

.apply-btn::after {
    border: none;
}

.apply-btn[disabled] {
    opacity: 0.7;
}

/* 空状态 */
.empty-container {
    padding: 100rpx 0;
}
<!-- pages/project-detail/project-detail.wxml -->
<view class="project-detail-container">
    <!-- 加载中 -->
    <view class="loading-container" wx:if="{{loading}}">
        <van-loading size="24px">加载中...</van-loading>
    </view>

    <block wx:elif="{{project}}">
        <!-- 顶部白色头部区域 -->
        <view class="header-area">
            <!-- 学校标签 -->
            <view class="school-badge ui-pill ui-pill--blue" wx:if="{{project.schoolName}}">
                <text class="school-icon ui-pill__icon">🏫</text>
                <text class="school-badge-text">{{project.schoolName}}</text>
            </view>
            <!-- 项目名称 -->
            <view class="project-title">{{project.name}}</view>
            <!-- 阅读量 -->
            <view class="view-count-row">
                <van-icon name="eye-o" size="16px" color="#989da5" />
                <text class="view-count-text">{{project.viewCount || 0}}</text>
            </view>
        </view>

        <!-- 标签行 -->
        <view class="tag-row">
            <!-- 方向标签 -->
            <view class="info-pill ui-pill ui-pill--card">
                <text class="pill-icon ui-pill__icon">🏆</text>
                <text class="pill-text ui-pill__text">{{project.directionText}}方向</text>
            </view>
            <!-- 跨校标签 -->
            <view class="info-pill ui-pill ui-pill--card">
                <text class="pill-icon ui-pill__icon" wx:if="{{project.isCrossSchool}}">✅</text>
                <text class="pill-text ui-pill__text">{{project.isCrossSchool ? '允许跨校' : '⚠️仅限本校'}}</text>
            </view>
            <!-- 团队人数标签 -->
            <view class="info-pill ui-pill ui-pill--card">
                <text class="pill-icon ui-pill__icon">👥</text>
                <text class="pill-text ui-pill__text">团队{{project.memberCount || 0}}人</text>
            </view>
        </view>

        <!-- 项目描述卡片 -->
        <view class="desc-card ui-card ui-card--xl">
            <text class="desc-text" user-select="true">{{project.description || '暂无描述'}}</text>
        </view>

        <!-- 底部操作区 -->
        <view class="bottom-actions" wx:if="{{project.status === projectStatusEnum.Approved && viewStrategy.showApplyAction}}">
            <!-- 投递名片按钮 -->
            <view class="deliver-btn ui-btn ui-btn--block ui-btn--pill ui-btn--lg ui-btn--primary-soft {{applying ? 'disabled' : ''}}" bindtap="handleApply">
                {{applying ? '提交中...' : '投递名片'}}
            </view>

            <!-- 分享按钮组 -->
            <view class="share-row">
                <button class="share-icon-btn ui-btn ui-btn--share-icon" open-type="share">
                    <van-icon name="share-o" size="24px" color="#333" />
                </button>
            </view>
        </view>

        <!-- 公开联系方式 -->
        <view class="public-contact-row" wx:if="{{viewStrategy.showPublicContact && publicContacts.length}}">
            <view
                class="contact-pill"
                wx:for="{{publicContacts}}"
                wx:key="type"
                data-value="{{item.value}}"
                data-label="{{item.label}}"
                bindtap="handleContactTap"
            >
                <van-icon name="{{item.icon}}" size="20px" color="#ffffff" />
                <text class="contact-pill-text">{{item.value}}</text>
            </view>
        </view>

        <!-- 底部声明 -->
        <view class="footer-note">
            <view class="footer-divider"></view>
            <text class="footer-text">@所有项目快组校园团队均对于内容进行资料审查</text>
        </view>
    </block>

    <!-- 空状态 -->
    <view class="empty-container" wx:else>
        <van-empty description="项目不存在" />
    </view>
</view>

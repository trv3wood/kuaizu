/* pages/profile/profile.wxss */

/* ==============================
   Container & Background
   ============================== */
.profile-container {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.profile-bg {
  position: fixed;
  top: -300rpx;
  left: -140rpx;
  width: 980rpx;
  height: 1960rpx;
  z-index: 0;
  pointer-events: none;
}

.content {
  position: relative;
  z-index: 1;
  padding-left: 48rpx;
  padding-right: 48rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

/* ==============================
   Header: Avatar + Settings
   ============================== */
.header-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding-top: 20rpx;
}

.avatar {
  width: 176rpx;
  height: 170rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.settings-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(0, 0, 0, 0.56);
  border-radius: 40rpx;
  padding: 12rpx 28rpx;
  margin-top: 60rpx;
}

.settings-icon {
  color: white;
}

.settings-text {
  font-size: 28rpx;
  font-weight: 800;
  color: #ffffff;
  font-family: 'PingFang SC', sans-serif;
}

/* ==============================
   User Info: Name + Badge + School
   ============================== */
.user-info {
  margin-bottom: 40rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.name {
  font-size: 40rpx;
  font-weight: 800;
  color: #000000;
  font-family: 'PingFang SC', sans-serif;
}

.badge-icon {
  width: 70rpx;
  height: 70rpx;
  flex-shrink: 0;
}

.badge-icon-success {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.school-text {
  display: flex;
  flex-direction: column;
  font-size: 26rpx;
  color: #000000;
  line-height: 1.6;
  font-family: 'PingFang SC', sans-serif;
}

.placeholder {
  font-size: 26rpx;
  color: #999999;
}

/* ==============================
   Feature Cards: 名片 + 橄榄枝
   ============================== */
.feature-cards {
  display: flex;
  gap: 38rpx;
  margin-bottom: 34rpx;
}

.feature-card-wrap {
  flex: 1;
  height: 188rpx;
  border-radius: 24rpx;
  position: relative;
  overflow: hidden;
  box-shadow: 6rpx 4rpx 8rpx rgba(0, 0, 0, 0.25);
}

.feature-card-img {
  position: absolute;
  top: 0;
  left: 10rpx;
  width: 100%;
  height: 100%;
}

.card-title {
  position: absolute;
  top: 18rpx;
  left: 24rpx;
  z-index: 1;
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
  font-family: 'PingFang SC', sans-serif;
}

/* ==============================
   Menu Cards: 我的项目 / 我的申请
   ============================== */
.menu-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 6rpx 4rpx 8rpx rgba(0, 0, 0, 0.2);
}

.menu-icon {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.menu-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 700;
  color: #000000;
  font-family: 'PingFang SC', sans-serif;
}

.menu-arrow {
  width: 24rpx;
  height: 24rpx;
  flex-shrink: 0;
}

/* ==============================
   Other Services: 其他服务
   ============================== */
.services-section {
  margin-top: 10rpx;
  margin-bottom: 30rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #000000;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  font-family: 'PingFang SC', sans-serif;
}

.services-card {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 24rpx 16rpx;
  display: flex;
  justify-content: space-around;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  flex: 1;
}

.service-icon {
  width: 56rpx;
  height: 56rpx;
}

.service-name {
  font-size: 24rpx;
  color: #404040;
  font-family: 'PingFang SC', sans-serif;
}

/* ==============================
   Logout & Version
   ============================== */
.logout-section {
  padding: 40rpx 0 20rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #ffffff;
  color: #ff4d4d;
  font-size: 28rpx;
  border-radius: 24rpx;
  border: 1rpx solid #ffe5e5;
  box-shadow: 0 2rpx 8rpx rgba(255, 77, 77, 0.1);
}

.logout-btn::after {
  border: none;
}

.version {
  text-align: center;
  padding: 30rpx 0;
  font-size: 28rpx;
  color: #aaaaaa;
  font-family: 'PingFang SC', sans-serif;
}
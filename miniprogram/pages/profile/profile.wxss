/* pages/profile/profile.wxss */
.profile-container {
  min-height: 100vh;
  background: var(--color-bg-base);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 用户信息卡片 */
.user-card {
  margin: var(--spacing-sm);
  padding: var(--spacing-md);
  background: var(--color-primary);
  border-radius: 24rpx;
  color: var(--color-text-inverse);
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  flex-shrink: 0;
}

.info-content {
  flex: 1;
  margin-left: var(--spacing-sm);
  overflow: hidden;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: var(--spacing-xxs);
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--color-text-inverse);
}

.user-meta {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 数据统计 */
.stats-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: var(--spacing-md);
  padding-top: var(--spacing-sm);
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: var(--color-text-inverse);
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 未登录卡片 */
.login-card {
  margin: var(--spacing-sm);
  padding: var(--spacing-md);
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-sm);
}

.avatar-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--color-bg-base);
  flex-shrink: 0;
}

.login-hint {
  flex: 1;
  margin-left: var(--spacing-sm);
}

.login-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--color-text-main);
}

.login-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  margin-top: 4rpx;
}

/* 功能菜单 */
.menu-section {
  margin-top: var(--spacing-sm);
}

/* 退出登录 */
.logout-section {
  padding: 40rpx var(--spacing-sm);
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: var(--color-bg-card);
  color: var(--color-danger);
  font-size: 32rpx;
  border-radius: var(--radius-md);
  border: none;
}

.logout-btn::after {
  border: none;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: var(--spacing-sm) 0;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

@import "./profile-wxa-auto-dark.wxss";
/* pages/profile/profile.wxss */
.profile-container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  position: relative;
}

/* Background decoration */
.profile-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 400rpx;
  background: linear-gradient(180deg, #e8f4ff 0%, #f5f7fa 100%);
  z-index: 0;
}

/* User profile section */
.user-section {
  position: relative;
  z-index: 1;
  margin: 40rpx 30rpx 30rpx;
  padding: 30rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
}

.user-section.login-prompt {
  cursor: pointer;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 3rpx solid #e8f4ff;
  flex-shrink: 0;
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
  overflow: hidden;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.placeholder {
  font-size: 24rpx;
  color: #999;
}

.user-meta {
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.settings-btn {
  padding: 8rpx;
  flex-shrink: 0;
}

/* Feature cards */
.feature-cards {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 20rpx;
  margin: 0 30rpx 30rpx;
}

.card {
  flex: 1;
  height: 160rpx;
  border-radius: 24rpx;
  background: #3279ec;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(50, 121, 236, 0.2);
}

.card-content {
  position: relative;
  z-index: 2;
  padding: 30rpx;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.card-count {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
}

.business-card::before {
  content: '';
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 120rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.olive-branch::before {
  content: '';
  position: absolute;
  bottom: -30rpx;
  right: -30rpx;
  width: 140rpx;
  height: 140rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

/* Menu cards */
.menu-card {
  position: relative;
  z-index: 1;
  margin: 0 30rpx 20rpx;
  padding: 30rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.menu-card-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-card-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

/* Other services */
.other-services {
  position: relative;
  z-index: 1;
  margin: 30rpx 30rpx 0;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 4rpx;
}

.services-container {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  display: flex;
  justify-content: space-around;
}

.service-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx;
  flex: 1;
}

.service-name {
  font-size: 24rpx;
  color: #666;
}

/* Logout section */
.logout-section {
  position: relative;
  z-index: 1;
  padding: 40rpx 30rpx 20rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #ffffff;
  color: #ff4d4d;
  font-size: 28rpx;
  border-radius: 24rpx;
  border: 1rpx solid #ffe5e5;
  box-shadow: 0 2rpx 8rpx rgba(255, 77, 77, 0.1);
}

.logout-btn::after {
  border: none;
}

/* Version info */
.version {
  position: relative;
  z-index: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: #999;
}
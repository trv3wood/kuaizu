/* pages/profile/profile.wxss */
.profile-container {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 用户信息卡片 */
.user-card {
  margin: 30rpx;
  padding: 40rpx;
  background: var(--primary-color);
  border-radius: 32rpx;
  color: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #e8f4ff;
  flex-shrink: 0;
}

.info-content {
  flex: 1;
  margin-left: 30rpx;
  overflow: hidden;
}

.nickname-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}

.user-meta {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 数据统计 */
.stats-row {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.2);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 4rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 未登录卡片 */
.login-card {
  margin: 30rpx;
  padding: 40rpx;
  background: var(--card-bg);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.avatar-placeholder {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #f0f0f0;
  flex-shrink: 0;
}

.login-hint {
  flex: 1;
  margin-left: 30rpx;
}

.login-title {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-main);
}

.login-desc {
  display: block;
  font-size: 28rpx;
  color: var(--text-gray);
  margin-top: 4rpx;
}

/* 功能菜单 */
.menu-section {
  margin-top: 30rpx;
}

/* 退出登录 */
.logout-section {
  padding: 40rpx 30rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #f5f7fa;
  color: #ff4d4d;
  font-size: 28rpx;
  border-radius: 24rpx;
  border: none;
}

.logout-btn::after {
  border: none;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 30rpx 0;
  font-size: 24rpx;
  color: var(--text-gray);
}


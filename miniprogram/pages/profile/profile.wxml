<!-- pages/profile/profile.wxml -->
<view class="profile-container">
  <!-- Background decoration -->
  <view class="profile-bg"></view>

  <!-- User profile section -->
  <view class="user-section" wx:if="{{isLoggedIn}}">
    <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" bindtap="handleEditProfile" />
    <view class="user-info">
      <view class="name-row">
        <text class="name">{{displayName}}</text>
        <van-tag wx:if="{{isVerified}}" type="success" size="small" plain>已认证</van-tag>
      </view>
      <text class="user-meta" wx:if="{{userMeta}}">{{userMeta}}</text>
      <text class="placeholder" wx:else>待完善...</text>
    </view>
    <view class="settings-btn" bindtap="handleSettings">
      <van-icon name="setting-o" size="20px" color="#666" />
    </view>
  </view>

  <!-- Login prompt for non-logged-in users -->
  <view class="user-section login-prompt" wx:else bindtap="handleLogin">
    <image class="avatar" src="https://kuaizu-img-file.oss-cn-hangzhou.aliyuncs.com/kuaizu-img/imges/images/user-avatar.jpg" mode="aspectFill" />
    <view class="user-info">
      <text class="name">点击登录</text>
      <text class="placeholder">登录后体验更多功能</text>
    </view>
    <van-icon name="arrow" color="#999" size="18px" />
  </view>

  <!-- Feature cards -->
  <view class="feature-cards">
    <view class="card business-card" bindtap="handleBusinessCard">
      <view class="card-content">
        <text class="card-title">名片</text>
      </view>
    </view>
    <view class="card olive-branch" bindtap="handleOliveBranchTap">
      <view class="card-content">
        <text class="card-title">橄榄枝</text>
        <text class="card-count">{{oliveBranchCount || 0}}</text>
      </view>
    </view>
  </view>

  <!-- My projects -->
  <view class="menu-card" bindtap="handleMyProjects">
    <view class="menu-card-left">
      <van-icon name="orders-o" size="20px" color="#3279ec" />
      <text class="menu-card-title">我的项目</text>
    </view>
    <van-icon name="arrow" color="#999" size="16px" />
  </view>

  <!-- My applications -->
  <view class="menu-card" bindtap="handleMyApplications">
    <view class="menu-card-left">
      <van-icon name="records" size="20px" color="#3279ec" />
      <text class="menu-card-title">我的申请</text>
    </view>
    <van-icon name="arrow" color="#999" size="16px" />
  </view>

  <!-- Other services -->
  <view class="other-services">
    <text class="section-title">其他服务</text>
    <view class="services-container">
      <view class="service-item" wx:for="{{services}}" wx:key="name" data-url="{{item.url}}" bindtap="handleServiceTap">
        <van-icon name="{{item.icon}}" size="22px" color="#3279ec" />
        <text class="service-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- Logout button -->
  <view class="logout-section" wx:if="{{isLoggedIn}}">
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>

  <!-- Version info -->
  <view class="version">3.0版本</view>
</view>
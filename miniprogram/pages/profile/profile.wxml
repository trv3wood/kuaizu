<!-- pages/profile/profile.wxml -->
<view class="profile-container">
  <!-- 用户信息卡片 -->
  <view class="user-card" wx:if="{{isLoggedIn}}">
    <view class="user-info" bindtap="handleEditProfile">
      <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
      <view class="info-content">
        <view class="nickname-row">
          <text class="nickname">{{displayName}}</text>
          <van-tag wx:if="{{isVerified}}" type="success" size="medium">已认证</van-tag>
          <van-tag wx:else type="warning" size="medium">未认证</van-tag>
        </view>
        <view class="user-meta">
          <text wx:if="{{user.school}}">{{user.school.schoolName}}</text>
          <text wx:if="{{user.major}}">· {{user.major.majorName}}</text>
          <text wx:if="{{user.grade}}">· {{user.grade}}级</text>
        </view>
      </view>
      <van-icon name="arrow" color="#999" size="18px" />
    </view>
    <!-- 数据统计 -->
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-value">{{oliveBranchCount || 0}}</text>
        <text class="stat-label">橄榄枝</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value">{{user.freeBranchUsedToday || 0}}/5</text>
        <text class="stat-label">今日免费</text>
      </view>
    </view>
  </view>
  <!-- 未登录状态 -->
  <view class="login-card" wx:else bindtap="handleLogin">
    <image class="avatar-placeholder" src="/assets/default-avatar.png" mode="aspectFill" />
    <view class="login-hint">
      <text class="login-title">点击登录</text>
      <text class="login-desc">登录后体验更多功能</text>
    </view>
    <van-icon name="arrow" color="#999" size="18px" />
  </view>
  <!-- 功能菜单 -->
  <view class="menu-section">
    <van-cell-group inset>
      <van-cell wx:for="{{menuList}}" wx:key="title" title="{{item.title}}" is-link data-url="{{item.url}}" bindtap="handleMenuTap">
        <van-icon slot="icon" name="{{item.icon}}" size="20px" color="#667eea" custom-style="margin-right: 12px;" />
      </van-cell>
    </van-cell-group>
  </view>
  <!-- 退出登录按钮 -->
  <view class="logout-section" wx:if="{{isLoggedIn}}">
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>
  <!-- 版本信息 -->
  <view class="version-info">
    <text>快组校园 v1.0.0</text>
  </view>
</view>
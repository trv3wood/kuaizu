/* pages/my-applications/my-applications.wxss */
.my-applications-container {
    min-height: 100vh;
    background: linear-gradient(180deg, #f6f7fb 0%, #eef1f8 100%);
}

/* 状态筛选标签 */
.status-tabs {
    display: flex;
    background: #fff;
    padding: 20rpx 24rpx;
    gap: 16rpx;
    position: sticky;
    top: 0;
    z-index: 10;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
    flex: 1;
    text-align: center;
    padding: 16rpx 0;
    font-size: 28rpx;
    color: #666;
    background: #f5f5f5;
    border-radius: 40rpx;
    transition: all 0.3s ease;
}

.tab-item.active {
    color: #fff;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    font-weight: 500;
}

/* 加载状态 */
.loading-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 120rpx 0;
}

/* 申请列表 */
.application-list {
    padding: 24rpx;
}

.application-card {
    background: #fff;
    border-radius: 24rpx;
    padding: 32rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

/* 项目信息 */
.project-info {
    display: flex;
    align-items: center;
    gap: 12rpx;
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.08) 100%);
    padding: 20rpx 24rpx;
    border-radius: 16rpx;
    margin-bottom: 20rpx;
}

.project-name {
    flex: 1;
    font-size: 30rpx;
    color: #333;
    font-weight: 500;
}

/* 状态行 */
.status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20rpx;
}

.apply-time {
    font-size: 24rpx;
    color: #999;
}

/* 申请理由 */
.apply-reason,
.reply-msg {
    background: #f8f9fc;
    padding: 20rpx 24rpx;
    border-radius: 12rpx;
    margin-bottom: 16rpx;
}

.apply-reason .label,
.reply-msg .label {
    font-size: 26rpx;
    color: #666;
    margin-right: 8rpx;
}

.apply-reason .content,
.reply-msg .content {
    font-size: 26rpx;
    color: #333;
    line-height: 1.6;
}

.reply-msg {
    border-left: 4rpx solid #667eea;
    background: rgba(102, 126, 234, 0.05);
}

/* 联系方式 */
.contact-info {
    display: flex;
    align-items: center;
    gap: 8rpx;
    padding: 16rpx 20rpx;
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
    border-radius: 12rpx;
}

.contact-text {
    font-size: 28rpx;
    color: #667eea;
    font-weight: 500;
}

/* 加载更多 */
.load-more,
.no-more {
    display: flex;
    justify-content: center;
    padding: 40rpx 0;
}

.no-more text {
    font-size: 26rpx;
    color: #999;
}

/* 空状态 */
.empty-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 120rpx 0;
}
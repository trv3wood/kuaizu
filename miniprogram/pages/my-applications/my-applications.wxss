/* pages/my-applications/my-applications.wxss */
.my-applications-container {
    min-height: 100vh;
    background: var(--color-bg-base);
}

/* 状态筛选标签 */
.status-tabs {
    display: flex;
    background: #fff;
    padding: 20rpx var(--spacing-sm);
    gap: var(--spacing-xs);
    position: sticky;
    top: 0;
    z-index: 10;
    box-shadow: var(--shadow-sm);
}

.tab-item {
    flex: 1;
    text-align: center;
    padding: 16rpx 0;
    font-size: 28rpx;
    color: var(--color-text-secondary);
    background: var(--color-bg-base);
    border-radius: 40rpx;
    transition: all 0.3s ease;
}

.tab-item.active {
    color: var(--color-text-inverse);
    background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary-dark) 100%);
    font-weight: 500;
}

/* 加载状态 */
.loading-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 120rpx 0;
}

/* 申请列表 */
.application-list {
    padding: var(--spacing-sm);
}

.application-card {
    background: var(--color-bg-card);
    border-radius: var(--radius-lg);
    padding: var(--spacing-md);
    margin-bottom: var(--spacing-sm);
    box-shadow: var(--shadow-sm);
}

/* 项目信息 */
.project-info {
    display: flex;
    align-items: center;
    gap: 12rpx;
    background: linear-gradient(135deg, rgba(79, 70, 229, 0.08) 0%, rgba(55, 48, 163, 0.08) 100%);
    padding: 20rpx var(--spacing-sm);
    border-radius: var(--radius-md);
    margin-bottom: 20rpx;
}

.project-name {
    flex: 1;
    font-size: 30rpx;
    color: var(--color-text-main);
    font-weight: 500;
}

/* 状态行 */
.status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20rpx;
}

.apply-time {
    font-size: 24rpx;
    color: var(--color-text-tertiary);
}

/* 申请理由 */
.apply-reason,
.reply-msg {
    background: var(--color-bg-base);
    padding: 20rpx var(--spacing-sm);
    border-radius: var(--radius-sm);
    margin-bottom: var(--spacing-xs);
}

.apply-reason .label,
.reply-msg .label {
    font-size: 26rpx;
    color: var(--color-text-secondary);
    margin-right: var(--spacing-xxs);
}

.apply-reason .content,
.reply-msg .content {
    font-size: 26rpx;
    color: var(--color-text-main);
    line-height: 1.6;
}

.reply-msg {
    border-left: 4rpx solid var(--color-primary);
    background: rgba(79, 70, 229, 0.05);
}

/* 联系方式 */
.contact-info {
    display: flex;
    align-items: center;
    gap: var(--spacing-xxs);
    padding: 16rpx 20rpx;
    background: linear-gradient(135deg, rgba(79, 70, 229, 0.1) 0%, rgba(55, 48, 163, 0.1) 100%);
    border-radius: var(--radius-sm);
}

.contact-text {
    font-size: 28rpx;
    color: var(--color-primary);
    font-weight: 500;
}

/* 加载更多 */
.load-more,
.no-more {
    display: flex;
    justify-content: center;
    padding: 40rpx 0;
}

.no-more text {
    font-size: 26rpx;
    color: var(--color-text-tertiary);
}

/* 空状态 */
.empty-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 120rpx 0;
}
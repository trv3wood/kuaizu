/* pages/my-applications/my-applications.wxss */
/* 状态筛选标签 */
.status-tabs {
    display: flex;
    background: var(--card-bg);
    padding: 20rpx 30rpx;
    gap: 16rpx;
    position: sticky;
    top: 0;
    z-index: 10;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
    flex: 1;
    text-align: center;
    padding: 16rpx 0;
    font-size: 28rpx;
    color: var(--text-gray);
    background: var(--card-bg);
    border-radius: 40rpx;
    transition: all 0.3s ease;
}

.tab-item.active {
    color: #ffffff;
    background: var(--primary-color);
    font-weight: 500;
}

/* 加载状态 */
.loading-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 120rpx 0;
}

/* 申请列表 */
.application-list {
    padding: 30rpx;
}

.application-card {
    padding: 40rpx;
    margin-bottom: 30rpx;
}

/* 项目信息 */
.project-info {
    gap: 12rpx;
    padding: 20rpx 30rpx;
    margin-bottom: 20rpx;
}

.project-name {
    flex: 1;
    font-size: 32rpx;
    color: var(--text-main);
    font-weight: 500;
}

/* 状态行 */
.status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20rpx;
}

.apply-time {
    font-size: 24rpx;
    color: var(--text-gray);
}

/* 申请理由 */
.apply-reason,
.reply-msg {
    padding: 20rpx 30rpx;
    margin-bottom: 16rpx;
}

.apply-reason .label,
.reply-msg .label {
    font-size: 28rpx;
    color: var(--text-gray);
    margin-right: 8rpx;
}

.apply-reason .content,
.reply-msg .content {
    font-size: 28rpx;
    color: var(--text-main);
    line-height: 1.6;
}

.reply-msg {
    border-left: 4rpx solid var(--primary-color);
}

/* 联系方式 */
.contact-info {
    display: flex;
    align-items: center;
    gap: 8rpx;
    padding: 16rpx 20rpx;
    background: var(--bg-soft-blue);
    border-radius: var(--radius-sm);
}

.contact-text {
    font-size: 32rpx;
    color: var(--primary-color);
    font-weight: 500;
}

/* 加载更多 */
.load-more,
.no-more {
    display: flex;
    justify-content: center;
    padding: 40rpx 0;
}

.no-more text {
    font-size: 28rpx;
    color: var(--text-gray);
}

/* 空状态 */
.empty-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 120rpx 0;
}

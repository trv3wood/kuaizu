<view class="olive-branches-page">
    <view class="page-hero">
        <view class="hero-nav" style="padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + navBarHeight}}px;">
            <view class="hero-nav-row">
                <view class="nav-action {{showBackButton ? '' : 'nav-back-hidden'}}" bindtap="handleBack">
                    <van-icon name="arrow-left" size="18px" color="#101010" />
                </view>
                <text class="hero-title">橄榄枝</text>
                <view class="nav-capsule-placeholder"></view>
            </view>
        </view>

        <view class="view-tabs">
            <view class="view-tab {{viewMode === 'received' ? 'active' : ''}}" data-mode="received" bindtap="handleViewModeChange">
                <text>收到的</text>
            </view>
            <view class="view-tab {{viewMode === 'sent' ? 'active' : ''}}" data-mode="sent" bindtap="handleViewModeChange">
                <text>发出的</text>
            </view>
        </view>

        <view class="status-tabs">
            <view wx:for="{{statusTabs}}" wx:key="label" class="status-tab {{currentStatus === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="handleStatusChange">
                <text>{{item.label}}</text>
            </view>
        </view>
    </view>

    <view class="page-content">
        <view class="loading-container" wx:if="{{listLoading}}">
            <van-loading size="24px" color="#58a7ff">加载中...</van-loading>
        </view>

        <block wx:elif="{{branches.length > 0}}">
            <view class="branch-list">
                <view class="branch-card ui-card ui-card--xl branch-card-{{viewMode}}" wx:for="{{branches}}" wx:key="id">
                    <block wx:if="{{viewMode === 'received'}}">
                        <text class="sms-tip" wx:if="{{item.hasSmsNotice}}">项目曾向您发送短信</text>

                        <view class="project-shell" data-project-id="{{item.relatedProjectId}}" bindtap="handleViewProject">
                            <view class="project-icon-wrap">
                                <van-icon name="orders-o" size="16px" color="#58a7ff" />
                            </view>
                            <text class="project-title">{{item.projectLabel}}</text>
                            <van-icon name="arrow" size="14px" color="#d8d8d8" />
                        </view>

                        <view class="received-footer">
                            <text class="contact-tip" wx:if="{{item.isAccepted}}">联系方式已在项目主页公开</text>

                            <view class="received-actions" wx:if="{{item.isPending}}">
                                <view class="circle-action reject-action {{processingId === item.id ? 'is-disabled' : ''}}" data-id="{{item.id}}" bindtap="handleReject">
                                    <van-icon name="cross" size="18px" color="#ffffff" />
                                </view>
                                <view class="circle-action accept-action {{processingId === item.id ? 'is-disabled' : ''}}" data-id="{{item.id}}" bindtap="handleAccept">
                                    <van-icon name="success" size="18px" color="#ffffff" />
                                </view>
                            </view>

                            <view class="status-pill ui-pill ui-pill--status {{item.statusPillClass}}" wx:else>
                                <text>{{item.statusText}}</text>
                            </view>
                        </view>
                    </block>

                    <block wx:else>
                        <view class="sent-top">
                            <view class="sent-status {{item.statusClass}}">
                                <view class="status-dot {{item.statusDotClass}}"></view>
                                <text>{{item.statusText}}</text>
                            </view>
                            <text class="sent-project">发出项目：{{item.projectLabel}}</text>
                        </view>

                        <view class="sent-main" data-receiver="{{item.receiver}}" bindtap="handleViewReceiver">
                            <image wx:if="{{item.avatarUrl}}" class="profile-avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
                            <view wx:else class="profile-avatar avatar-placeholder">
                                <van-icon name="contact" size="28px" color="#c8c8c8" />
                            </view>

                            <view class="profile-body">
                                    <view class="profile-headline">
                                        <view class="name-wrap">
                                            <text class="profile-name">{{item.displayName}}</text>
                                            <auth-badge authStatus="{{item.counterpart.authStatus}}" size="tiny" />
                                        </view>
                                        <text class="mbti-label" style="color: {{item.mbtiColor}};">{{item.mbtiLabel}}</text>
                                    </view>

                                <!-- <text class="profile-school">{{item.schoolLabel}}</text>
                                <text class="profile-major">{{item.majorLabel}}</text> -->
                                <view class="tag-row ui-tag-list" wx:if="{{item.skillTags.length > 0}}">
                                    <view class="tag-chip ui-tag" wx:for="{{item.skillTags}}" wx:key="*this">
                                        <text>{{item}}</text>
                                    </view>
                                </view>
                            </view>
                        </view>

                        <view class="sent-footer" wx:if="{{item.showSmsAction}}">
                            <button class="sms-button ui-btn ui-btn--pill {{item.hasSmsNotice ? 'is-sent' : ''}}" data-id="{{item.id}}" bindtap="handleSmsNotify">
                                {{item.smsActionText}}
                            </button>
                        </view>
                    </block>
                </view>
            </view>

            <view class="load-more" wx:if="{{listLoadingMore}}">
                <van-loading size="20px" color="#58a7ff">加载中...</van-loading>
            </view>

            <view class="page-footer" wx:elif="{{!listHasMore}}">
                <text class="footer-line">已显示全部橄榄枝</text>
            </view>
        </block>

        <view class="empty-container" wx:else>
            <van-empty description="{{viewMode === 'sent' ? '暂无发出的橄榄枝' : '暂无收到的橄榄枝'}}" />
        </view>
    </view>
</view>

/* pages/olive-branches/olive-branches.wxss */
.olive-branches-container {
    min-height: 100vh;
    background: var(--md-sys-color-background);
}

/* 视图切换标签 */
.view-tabs {
    display: flex;
    background: var(--md-sys-color-surface-container-lowest);
    padding: 24rpx 48rpx;
    border-bottom: 1rpx solid var(--md-sys-color-outline-variant);
}

.view-tab {
    flex: 1;
    text-align: center;
    padding: 20rpx 0;
    font-size: var(--md-sys-typescale-title-small);
    color: var(--md-sys-color-on-surface-variant);
    position: relative;
    transition: all 0.3s ease;
}

.view-tab.active {
    color: var(--md-sys-color-primary);
    font-weight: 600;
}

.view-tab.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 64rpx;
    height: 6rpx;
    background: var(--md-sys-color-primary);
    border-radius: 3rpx;
}

/* 状态筛选标签 */
.status-tabs {
    display: flex;
    background: var(--md-sys-color-surface-container-lowest);
    padding: 20rpx var(--spacing-sm);
    gap: var(--spacing-xs);
    position: sticky;
    top: 0;
    z-index: 10;
    box-shadow: var(--md-sys-elevation-1);
}

.tab-item {
    flex: 1;
    text-align: center;
    padding: 16rpx 0;
    font-size: var(--md-sys-typescale-label-large);
    color: var(--md-sys-color-on-surface-variant);
    background: var(--md-sys-color-surface);
    border-radius: 40rpx;
    transition: all 0.3s ease;
}

.tab-item.active {
    color: var(--md-sys-color-on-primary);
    background: var(--md-sys-color-primary);
    font-weight: 500;
}

/* 加载状态 */
.loading-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 120rpx 0;
}

/* 邀请列表 */
.branch-list {
    padding: var(--spacing-sm);
}

.branch-card {
    background: var(--md-sys-color-surface-container-lowest);
    border-radius: var(--md-sys-shape-corner-large);
    padding: var(--spacing-md);
    margin-bottom: var(--spacing-sm);
    box-shadow: var(--md-sys-elevation-1);
}

/* 卡片头部 */
.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-sm);
}

.sender-info {
    display: flex;
    align-items: center;
    gap: 20rpx;
}

.avatar {
    width: 88rpx;
    height: 88rpx;
    border-radius: 50%;
    border: 4rpx solid var(--md-sys-color-surface-container);
}

.info {
    display: flex;
    flex-direction: column;
    gap: 6rpx;
}

.name {
    font-size: var(--md-sys-typescale-title-medium);
    font-weight: 600;
    color: var(--md-sys-color-on-surface);
}

.type {
    font-size: var(--md-sys-typescale-label-small);
    color: var(--md-sys-color-primary);
    background: var(--md-sys-color-primary-container);
    padding: 4rpx 12rpx;
    border-radius: var(--md-sys-shape-corner-small);
}

/* 项目信息 */
.project-info {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    background: var(--md-sys-color-surface-container);
    padding: 20rpx 24rpx;
    border-radius: var(--md-sys-shape-corner-medium);
    margin-bottom: 20rpx;
}

.project-name {
    flex: 1;
    font-size: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface);
    font-weight: 500;
}

/* 邀请消息 */
.message {
    background: var(--md-sys-color-surface-container-low);
    padding: 24rpx;
    border-radius: var(--md-sys-shape-corner-medium);
    margin-bottom: 20rpx;
    border-left: 4rpx solid var(--md-sys-color-primary);
}

.message text {
    font-size: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface-variant);
    font-style: italic;
    line-height: 1.6;
}

/* 时间 */
.time {
    margin-bottom: 20rpx;
}

.time text {
    font-size: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-outline);
}

/* 操作按钮 */
.actions {
    display: flex;
    justify-content: flex-end;
    gap: 20rpx;
    padding-top: 20rpx;
    border-top: 1rpx solid var(--md-sys-color-outline-variant);
}

/* 加载更多 */
.load-more,
.no-more {
    display: flex;
    justify-content: center;
    padding: 40rpx 0;
}

.no-more text {
    font-size: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-outline);
}

/* 空状态 */
.empty-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 120rpx 0;
}
/* pages/olive-branches/olive-branches.wxss */
.olive-branches-container {
    min-height: 100vh;
    background: var(--color-bg-base);
}

/* 视图切换标签 */
.view-tabs {
    display: flex;
    background: var(--color-bg-card);
    padding: 24rpx 48rpx;
    border-bottom: 1rpx solid var(--color-border);
}

.view-tab {
    flex: 1;
    text-align: center;
    padding: 20rpx 0;
    font-size: 30rpx;
    color: var(--color-text-secondary);
    position: relative;
    transition: all 0.3s ease;
}

.view-tab.active {
    color: var(--color-primary);
    font-weight: 600;
}

.view-tab.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 64rpx;
    height: 6rpx;
    background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary-dark) 100%);
    border-radius: 3rpx;
}

/* 状态筛选标签 */
.status-tabs {
    display: flex;
    background: var(--color-bg-card);
    padding: 20rpx var(--spacing-sm);
    gap: var(--spacing-xs);
    position: sticky;
    top: 0;
    z-index: 10;
    box-shadow: var(--shadow-sm);
}

.tab-item {
    flex: 1;
    text-align: center;
    padding: 16rpx 0;
    font-size: 28rpx;
    color: var(--color-text-secondary);
    background: var(--color-bg-base);
    border-radius: 40rpx;
    transition: all 0.3s ease;
}

.tab-item.active {
    color: var(--color-text-inverse);
    background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary-dark) 100%);
    font-weight: 500;
}

/* 加载状态 */
.loading-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 120rpx 0;
}

/* 邀请列表 */
.branch-list {
    padding: var(--spacing-sm);
}

.branch-card {
    background: var(--color-bg-card);
    border-radius: var(--radius-lg);
    padding: var(--spacing-md);
    margin-bottom: var(--spacing-sm);
    box-shadow: var(--shadow-sm);
}

/* 卡片头部 */
.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-sm);
}

.sender-info {
    display: flex;
    align-items: center;
    gap: 20rpx;
}

.avatar {
    width: 88rpx;
    height: 88rpx;
    border-radius: 50%;
    border: 4rpx solid var(--color-bg-base);
}

.info {
    display: flex;
    flex-direction: column;
    gap: 6rpx;
}

.name {
    font-size: 32rpx;
    font-weight: 600;
    color: var(--color-text-main);
}

.type {
    font-size: 24rpx;
    color: var(--color-primary);
    background: rgba(79, 70, 229, 0.1);
    padding: 4rpx 12rpx;
    border-radius: 8rpx;
}

/* 项目信息 */
.project-info {
    display: flex;
    align-items: center;
    gap: var(--spacing-xs);
    background: linear-gradient(135deg, rgba(79, 70, 229, 0.08) 0%, rgba(55, 48, 163, 0.08) 100%);
    padding: 20rpx 24rpx;
    border-radius: var(--radius-md);
    margin-bottom: 20rpx;
}

.project-name {
    flex: 1;
    font-size: 28rpx;
    color: var(--color-text-main);
    font-weight: 500;
}

/* 邀请消息 */
.message {
    background: var(--color-bg-base);
    padding: 24rpx;
    border-radius: var(--radius-md);
    margin-bottom: 20rpx;
    border-left: 4rpx solid var(--color-primary);
}

.message text {
    font-size: 28rpx;
    color: var(--color-text-secondary);
    font-style: italic;
    line-height: 1.6;
}

/* 时间 */
.time {
    margin-bottom: 20rpx;
}

.time text {
    font-size: 24rpx;
    color: var(--color-text-tertiary);
}

/* 操作按钮 */
.actions {
    display: flex;
    justify-content: flex-end;
    gap: 20rpx;
    padding-top: 20rpx;
    border-top: 1rpx solid var(--color-border);
}

/* 加载更多 */
.load-more,
.no-more {
    display: flex;
    justify-content: center;
    padding: 40rpx 0;
}

.no-more text {
    font-size: 26rpx;
    color: var(--color-text-tertiary);
}

/* 空状态 */
.empty-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 120rpx 0;
}
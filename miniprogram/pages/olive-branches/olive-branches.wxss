/* pages/olive-branches/olive-branches.wxss */
.olive-branches-container {
    min-height: 100vh;
    background: var(--bg-color);
}

/* 视图切换标签 */
.view-tabs {
    display: flex;
    background: var(--card-bg);
    padding: 24rpx 48rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.view-tab {
    flex: 1;
    text-align: center;
    padding: 20rpx 0;
    font-size: 28rpx;
    color: var(--text-gray);
    position: relative;
    transition: all 0.3s ease;
}

.view-tab.active {
    color: var(--primary-color);
    font-weight: 600;
}

.view-tab.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 64rpx;
    height: 6rpx;
    background: var(--primary-color);
    border-radius: 3rpx;
}

/* 状态筛选标签 */
.status-tabs {
    display: flex;
    background: var(--card-bg);
    padding: 20rpx 30rpx;
    gap: 16rpx;
    position: sticky;
    top: 0;
    z-index: 10;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
    flex: 1;
    text-align: center;
    padding: 16rpx 0;
    font-size: 28rpx;
    color: var(--text-gray);
    background: var(--card-bg);
    border-radius: 40rpx;
    transition: all 0.3s ease;
}

.tab-item.active {
    color: #ffffff;
    background: var(--primary-color);
    font-weight: 500;
}

/* 加载状态 */
.loading-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 120rpx 0;
}

/* 邀请列表 */
.branch-list {
    padding: 30rpx;
}

.branch-card {
    background: var(--card-bg);
    border-radius: 32rpx;
    padding: 40rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 卡片头部 */
.card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30rpx;
}

.sender-info {
    display: flex;
    align-items: center;
    gap: 20rpx;
}

.avatar {
    width: 88rpx;
    height: 88rpx;
    border-radius: 50%;
    border: 4rpx solid #f5f7fa;
}

.info {
    display: flex;
    flex-direction: column;
    gap: 6rpx;
}

.name {
    font-size: 32rpx;
    font-weight: 600;
    color: var(--text-main);
}

.type {
    font-size: 20rpx;
    color: var(--primary-color);
    background: #e8f4ff;
    padding: 4rpx 12rpx;
    border-radius: 16rpx;
}

/* 项目信息 */
.project-info {
    display: flex;
    align-items: center;
    gap: 16rpx;
    background: #f5f7fa;
    padding: 20rpx 24rpx;
    border-radius: 24rpx;
    margin-bottom: 20rpx;
}

.project-name {
    flex: 1;
    font-size: 32rpx;
    color: var(--text-main);
    font-weight: 500;
}

/* 邀请消息 */
.message {
    background: var(--bg-color);
    padding: 24rpx;
    border-radius: 24rpx;
    margin-bottom: 20rpx;
    border-left: 4rpx solid var(--primary-color);
}

.message text {
    font-size: 28rpx;
    color: var(--text-gray);
    font-style: italic;
    line-height: 1.6;
}

/* 时间 */
.time {
    margin-bottom: 20rpx;
}

.time text {
    font-size: 24rpx;
    color: var(--text-gray);
}

/* 操作按钮 */
.actions {
    display: flex;
    justify-content: flex-end;
    gap: 20rpx;
    padding-top: 20rpx;
    border-top: 1rpx solid #f0f0f0;
}

/* 加载更多 */
.load-more,
.no-more {
    display: flex;
    justify-content: center;
    padding: 40rpx 0;
}

.no-more text {
    font-size: 28rpx;
    color: var(--text-gray);
}

/* 空状态 */
.empty-container {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 120rpx 0;
}
.olive-branches-page {
    min-height: 100vh;
    padding-bottom: calc(56rpx + env(safe-area-inset-bottom));
}

.page-hero {
    background: var(--card-bg);
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.14);
    position: sticky;
    top: 0;
    z-index: 20;
}

.hero-nav-row {
    padding: 0 18rpx;
}

.view-tabs {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 168rpx;
    padding: 12rpx 48rpx 22rpx;
    border-bottom: 1rpx solid #f1f1f1;
}

.view-tab {
    position: relative;
    padding: 16rpx 0 14rpx;
    color: #9a9a9a;
    font-size: 30rpx;
    line-height: 1.2;
}

.view-tab.active {
    color: #58a7ff;
    font-weight: 700;
}

.view-tab.active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 72rpx;
    height: 6rpx;
    border-radius: 999rpx;
    background: #58a7ff;
    transform: translateX(-50%);
}

.status-tabs {
    display: flex;
    gap: 18rpx;
    padding: 18rpx 26rpx 24rpx;
}

.status-tab {
    flex: 1;
    height: 64rpx;
    border-radius: 999rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9d9d9d;
    font-size: 28rpx;
    background: transparent;
}

.status-tab.active {
    background: linear-gradient(180deg, #6bb8ff 0%, #54a8f8 100%);
    color: #ffffff;
    font-weight: 700;
}

.page-content {
    padding-top: 22rpx;
}

.loading-container,
.empty-container {
    display: flex;
    justify-content: center;
    padding: 160rpx 0;
}

.branch-list {
    padding: 0 24rpx;
}

.branch-card {
    background: var(--card-bg);
    border-radius: var(--radius-xl);
    box-shadow: 0 0 8rpx rgba(0, 0, 0, 0.16);
    margin-bottom: 24rpx;
}

.branch-card-received {
    padding: 16rpx 20rpx 18rpx;
}

.branch-card-sent {
    padding: 16rpx 18rpx 12rpx;
}

.sms-tip {
    display: block;
    margin-bottom: 14rpx;
    font-size: 20rpx;
    line-height: 1.2;
    color: #8c8c8c;
}

.project-shell {
    background: var(--bg-page-muted);
    border-radius: 30rpx;
    min-height: 132rpx;
    display: flex;
    align-items: center;
    padding: 0 22rpx;
    gap: 18rpx;
}

.project-icon-wrap {
    width: 38rpx;
    height: 38rpx;
    border-radius: 10rpx;
    background: linear-gradient(180deg, #8cc8ff 0%, #58a7ff 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.project-title {
    flex: 1;
    min-width: 0;
    color: #111111;
    font-size: 38rpx;
    line-height: 1.22;
    font-weight: 800;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.received-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 72rpx;
    padding-top: 20rpx;
}

.contact-tip {
    flex: 1;
    color: #9a9a9a;
    font-size: 20rpx;
    line-height: 1.4;
    font-weight: 700;
    text-align: center;
}

.received-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 18rpx;
}

.circle-action {
    width: 58rpx;
    height: 58rpx;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.circle-action.is-disabled {
    opacity: 0.5;
}

.reject-action {
    background: #e95342;
}

.accept-action {
    background: #43cf76;
}

.status-pill {
    min-width: 140rpx;
    height: 50rpx;
    padding: 0 24rpx;
    border-radius: 999rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: auto;
}

.status-pill text {
    font-size: 22rpx;
    line-height: 1;
    color: #ffffff;
    font-weight: 700;
}

.status-pill-accepted {
    background: rgba(12, 193, 96, 0.92);
}

.status-pill-rejected {
    background: rgba(216, 30, 6, 0.82);
}

.status-pill-ignored {
    background: rgba(145, 145, 145, 0.92);
}

.sent-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16rpx;
    margin-bottom: 16rpx;
}

.sent-status {
    display: flex;
    align-items: center;
    gap: 8rpx;
    flex-shrink: 0;
    font-size: 22rpx;
    line-height: 1;
    font-weight: 700;
}

.status-pending {
    color: #ffb759;
}

.status-accepted {
    color: #32eb92;
}

.status-rejected {
    color: #de4936;
}

.status-ignored {
    color: #969696;
}

.status-dot {
    width: 18rpx;
    height: 18rpx;
    border-radius: 50%;
}

.status-dot-pending {
    background: #ffb759;
}

.status-dot-accepted {
    background: #32eb92;
}

.status-dot-rejected {
    background: #de4936;
}

.status-dot-ignored {
    background: #969696;
}

.sent-project {
    flex: 1;
    min-width: 0;
    font-size: 22rpx;
    line-height: 1.2;
    color: #909090;
    font-weight: 700;
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sent-main {
    display: flex;
    align-items: flex-start;
    gap: 16rpx;
}

.profile-avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    background: #eeeeee;
    flex-shrink: 0;
}

.profile-headline {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16rpx;
    margin-bottom: 4rpx;
}

.name-wrap {
    display: flex;
    align-items: center;
    gap: 8rpx;
    min-width: 0;
}

.profile-name {
    font-size: 32rpx;
    line-height: 1.3;
    color: #111111;
    font-weight: 700;
}

.mbti-label {
    font-size: 34rpx;
    line-height: 1;
    font-weight: 800;
    flex-shrink: 0;
}

.profile-school {
    display: block;
    font-size: 24rpx;
    line-height: 1.35;
    color: #777777;
    margin-bottom: 6rpx;
}

.profile-major {
    display: block;
    font-size: 24rpx;
    line-height: 1.4;
    color: #111111;
    font-weight: 600;
    margin-bottom: 12rpx;
}

.tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8rpx;
}

.sent-footer {
    display: flex;
    justify-content: flex-end;
    padding-top: 16rpx;
}

.sms-button {
    min-width: 174rpx;
    height: 54rpx;
    padding: 0 24rpx;
    margin: 0;
    border: none;
    border-radius: 999rpx;
    background: #0cc160;
    color: #ffffff;
    font-size: 26rpx;
    line-height: 54rpx;
    font-weight: 700;
}

.sms-button.is-sent {
    background: #54a8f8;
}

.sms-button::after {
    border: none;
}

.load-more,
.page-footer {
    text-align: center;
    padding: 24rpx 0 12rpx;
}

.footer-line {
    font-size: 24rpx;
    color: #a0a0a0;
}

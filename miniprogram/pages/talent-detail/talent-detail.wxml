<!-- pages/talent-detail/talent-detail.wxml -->
<view class="talent-detail-container">
    <view class="hero-shell">
        <view class="hero-nav" style="padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + navBarHeight}}px;">
            <view class="hero-nav-row">
                <view class="nav-action" bindtap="handleBack">
                    <van-icon name="arrow-left" size="18px" color="#101010" />
                </view>
                <view class="nav-capsule-placeholder"></view>
            </view>
        </view>
    </view>

    <view class="loading-container" wx:if="{{loading}}">
        <van-loading size="24px" color="#5bb4ff">加载中...</van-loading>
    </view>

    <block wx:elif="{{profile}}">
        <scroll-view class="detail-scroll" scroll-y enable-flex>
            <view class="hero-profile">
                <text class="hero-mbti-bg" wx:if="{{profile.mbti}}" style="color: {{profile.mbtiColor}};">{{profile.mbti}}</text>

                <image wx:if="{{profile.avatarUrl}}" class="avatar" src="{{profile.avatarUrl}}" mode="aspectFill" />
                <view wx:else class="avatar avatar-placeholder">
                    <van-icon name="contact" size="36px" color="#b7bcc5" />
                </view>

                <view class="name-row">
                    <text class="name">{{profile.nickname || '匿名用户'}}</text>
                </view>

                <view class="pill-list">
                    <view class="info-pill ui-pill ui-pill--blue">
                        <text class="pill-icon ui-pill__icon">🏫</text>
                        <text class="pill-text ui-pill__text">{{profile.schoolLabel}}</text>
                    </view>
                    <view class="info-pill ui-pill ui-pill--blue">
                        <text class="pill-icon ui-pill__icon">📖</text>
                        <text class="pill-text ui-pill__text">{{profile.majorLabel}}</text>
                    </view>
                    <view class="info-pill ui-pill ui-pill--blue" wx:if="{{profile.gradeLabel}}">
                        <text class="pill-icon ui-pill__icon">🎓</text>
                        <text class="pill-text ui-pill__text">{{profile.gradeLabel}}</text>
                    </view>
                </view>
            </view>

            <view class="content-sections">
                <view class="section-card ui-card ui-card--xl ui-card--shadow-md" wx:if="{{viewStrategy.showPublicContact && profile.publicContacts.length}}">
                    <view class="section-title-row">
                        <view class="title-accent"></view>
                        <text class="section-title">联系方式</text>
                    </view>

                    <view class="public-contact-list">
                        <view
                            class="public-contact-item"
                            wx:for="{{profile.publicContacts}}"
                            wx:key="type"
                            data-value="{{item.value}}"
                            data-label="{{item.label}}"
                            bindtap="handleContactTap"
                        >
                            <view class="public-contact-main">
                                <van-icon name="{{item.icon}}" size="18px" color="#559dfc" />
                                <text class="public-contact-label">{{item.label}}</text>
                                <text class="public-contact-value">{{item.value}}</text>
                            </view>
                            <van-icon name="arrow" size="14px" color="#b6bdc7" />
                        </view>
                    </view>
                </view>

                <view class="section-card ui-card ui-card--xl ui-card--shadow-md" wx:if="{{profile.selfEvaluation || (profile.displaySkills && profile.displaySkills.length > 0)}}">
                    <view class="section-title-row">
                        <view class="title-accent"></view>
                        <text class="section-title">自我评价</text>
                    </view>

                    <text class="section-content" wx:if="{{profile.selfEvaluation}}">{{profile.selfEvaluation}}</text>

                    <view class="skill-grid ui-tag-list" wx:if="{{profile.displaySkills && profile.displaySkills.length > 0}}">
                        <view class="skill-chip ui-tag" wx:for="{{profile.displaySkills}}" wx:key="*this">
                            <text>{{item}}</text>
                        </view>
                    </view>
                </view>

                <view class="section-card ui-card ui-card--xl ui-card--shadow-md" wx:if="{{profile.projectExperience}}">
                    <view class="section-title-row">
                        <view class="title-accent"></view>
                        <text class="section-title">项目经历</text>
                    </view>

                    <text class="section-content section-content-pre">{{profile.projectExperience}}</text>
                </view>
            </view>

            <view class="detail-spacer"></view>
        </scroll-view>

        <view class="action-bar ui-bottom-bar ui-bottom-bar--transparent" wx:if="{{viewStrategy.showOliveBranchAction}}">
            <button class="send-btn ui-btn ui-btn--block ui-btn--pill ui-btn--lg ui-btn--gradient-blue" loading="{{sending}}" disabled="{{sending}}" bindtap="handleSendOliveBranch">发送橄榄枝</button>
        </view>
    </block>

    <view class="empty-container" wx:else>
        <van-empty description="人才信息不存在" />
    </view>

    <van-popup show="{{showProjectPicker}}" position="bottom" round bind:close="handleCloseProjectPicker" custom-style="max-height: 60vh;">
        <view class="project-picker-popup">
            <view class="popup-header">
                <text class="popup-title">选择关联项目</text>
                <van-icon name="cross" size="20px" color="#999" bindtap="handleCloseProjectPicker" />
            </view>
            <view class="project-loading" wx:if="{{loadingProjects}}">
                <van-loading size="24px" color="#5bb4ff">加载中...</van-loading>
            </view>
            <scroll-view class="project-list" scroll-y wx:elif="{{myProjects.length > 0}}">
                <view class="project-item" wx:for="{{myProjects}}" wx:key="id" data-index="{{index}}" bindtap="handleSelectProject">
                    <view class="project-item-info">
                        <text class="project-item-name">{{item.name}}</text>
                        <text class="project-item-desc">{{item.description}}</text>
                    </view>
                    <van-icon name="arrow" size="16px" color="#999" />
                </view>
            </scroll-view>
            <view class="project-empty" wx:else>
                <van-empty description="您还没有正在进行的项目" image="search" />
            </view>
        </view>
    </van-popup>

    <van-popup show="{{showPurchasePopup}}" position="bottom" round bind:close="handleClosePurchase" custom-style="max-height: 60vh;">
        <view class="purchase-popup">
            <view class="popup-header">
                <text class="popup-title">购买橄榄枝</text>
                <van-icon name="cross" size="20px" color="#999" bindtap="handleClosePurchase" />
            </view>
            <view class="product-info ui-card ui-card--soft ui-card--lg">
                <view class="product-icon">🫒</view>
                <view class="product-detail">
                    <text class="product-name">橄榄枝额度</text>
                    <text class="product-desc">用于向心仪人才发送邀请</text>
                </view>
                <text class="product-price">¥{{unitPrice}}/个</text>
            </view>
            <view class="quantity-section">
                <text class="quantity-label">购买数量</text>
                <van-stepper value="{{quantity}}" min="1" max="99" bind:change="handleQuantityChange" button-size="28px" input-width="50px" />
            </view>
            <view class="total-section">
                <text class="total-label">合计</text>
                <text class="total-price">¥{{quantity * unitPrice}}</text>
            </view>
            <van-button type="primary" block round loading="{{purchasing}}" loading-text="处理中..." custom-class="purchase-btn" bindtap="handlePurchase">
                立即购买
            </van-button>
        </view>
    </van-popup>
</view>

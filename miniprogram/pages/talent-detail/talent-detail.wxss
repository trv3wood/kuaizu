/* pages/talent-detail/talent-detail.wxss */
.talent-detail-container {
    min-height: 100vh;
    background: var(--md-sys-color-background);
    padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 加载中 */
.loading-container {
    padding: 100rpx 0;
    display: flex;
    justify-content: center;
}

/* 头部卡片 */
.profile-header {
    display: flex;
    align-items: center;
    background: var(--md-sys-color-primary-container);
    padding: 40rpx var(--spacing-md);
    margin: var(--spacing-sm);
    border-radius: var(--md-sys-shape-corner-large);
    box-shadow: var(--md-sys-elevation-1);
}

.avatar {
    width: 140rpx;
    height: 140rpx;
    border-radius: 50%;
    border: 4rpx solid rgba(255, 255, 255, 0.5);
    margin-right: var(--spacing-sm);
    background: var(--md-sys-color-surface-container-high);
}

.info {
    flex: 1;
}

.name {
    display: block;
    font-size: var(--md-sys-typescale-headline-small);
    font-weight: bold;
    color: var(--md-sys-color-on-primary-container);
    margin-bottom: 8rpx;
}

.school,
.major {
    display: block;
    font-size: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-primary-container);
    opacity: 0.85;
    margin-bottom: 4rpx;
}

/* 内容区块 */
.section {
    background: var(--md-sys-color-surface-container-lowest);
    border-radius: var(--md-sys-shape-corner-medium);
    padding: var(--spacing-sm);
    margin: 0 var(--spacing-sm) var(--spacing-sm);
    box-shadow: var(--md-sys-elevation-1);
}

.section-title {
    display: block;
    font-size: var(--md-sys-typescale-title-medium);
    font-weight: 500;
    color: var(--md-sys-color-on-surface);
    margin-bottom: var(--spacing-xs);
}

.section-content {
    font-size: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface-variant);
    line-height: 1.8;
    white-space: pre-wrap;
}

/* 技能标签 */
.skills {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
}

.skill-tag {
    margin: 0 !important;
}

/* 联系方式 */
.contact-section {
    background: linear-gradient(135deg, var(--md-sys-color-surface-container-low) 0%, var(--md-sys-color-surface-container) 100%);
}

.contact-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.contact-text {
    font-size: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface);
    font-weight: 500;
}

.copy-btn {
    padding: 12rpx 32rpx;
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    font-size: var(--md-sys-typescale-label-medium);
    border-radius: 32rpx;
    border: none;
}

.copy-btn::after {
    border: none;
}

/* 底部操作栏 */
.action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--spacing-sm) var(--spacing-md);
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    background: var(--md-sys-color-surface-container-lowest);
    box-shadow: var(--md-sys-elevation-2);
}

.send-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 96rpx;
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    font-size: var(--md-sys-typescale-label-large);
    font-weight: 500;
    border-radius: 48rpx;
    border: none;
}

.send-btn::after {
    border: none;
}

.send-btn[disabled] {
    background: var(--md-sys-color-on-surface);
    opacity: 0.12;
    color: var(--md-sys-color-on-surface);
}

/* 空状态 */
.empty-container {
    padding: 100rpx 0;
}

/* ==================== 项目选择弹窗 ==================== */
.project-picker-popup {
    padding: var(--spacing-md);
    padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
    background: var(--md-sys-color-surface);
}

.project-loading {
    padding: 60rpx 0;
    display: flex;
    justify-content: center;
}

.project-list {
    max-height: 50vh;
}

.project-item {
    display: flex;
    align-items: center;
    padding: var(--spacing-sm) var(--spacing-xs);
    border-bottom: 1rpx solid var(--md-sys-color-outline-variant);
}

.project-item:last-child {
    border-bottom: none;
}

.project-item-info {
    flex: 1;
    min-width: 0;
}

.project-item-name {
    display: block;
    font-size: var(--md-sys-typescale-body-large);
    font-weight: 500;
    color: var(--md-sys-color-on-surface);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.project-item-desc {
    display: block;
    font-size: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-on-surface-variant);
    margin-top: 4rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.project-empty {
    padding: 40rpx 0;
}

/* ==================== 购买弹窗 ==================== */
.purchase-popup {
    padding: var(--spacing-md);
    padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
    background: var(--md-sys-color-surface);
}

.popup-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-md);
}

.popup-title {
    font-size: var(--md-sys-typescale-title-large);
    font-weight: 600;
    color: var(--md-sys-color-on-surface);
}

/* 商品信息 */
.product-info {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    background: var(--md-sys-color-surface-container);
    padding: var(--spacing-md);
    border-radius: var(--md-sys-shape-corner-large);
    margin-bottom: var(--spacing-md);
}

.product-icon {
    font-size: 48rpx;
}

.product-detail {
    flex: 1;
}

.product-name {
    display: block;
    font-size: var(--md-sys-typescale-title-medium);
    font-weight: 600;
    color: var(--md-sys-color-on-surface);
    margin-bottom: 8rpx;
}

.product-desc {
    font-size: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-on-surface-variant);
}

.product-price {
    font-size: var(--md-sys-typescale-title-medium);
    font-weight: 600;
    color: var(--md-sys-color-primary);
}

/* 数量选择 */
.quantity-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 0;
    border-bottom: 1rpx solid var(--md-sys-color-outline-variant);
}

.quantity-label {
    font-size: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface);
}

/* 总价 */
.total-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32rpx 0;
}

.total-label {
    font-size: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface);
}

.total-price {
    font-size: 44rpx;
    font-weight: 700;
    color: var(--md-sys-color-error);
}

/* 购买按钮 */
.purchase-btn {
    margin-top: 16rpx;
    background: var(--md-sys-color-primary) !important;
    color: var(--md-sys-color-on-primary) !important;
    border: none !important;
}
/* pages/talent-detail/talent-detail.wxss */
.talent-detail-container {
    min-height: 100vh;
    background: var(--bg-color);
    padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 加载中 */
.loading-container {
    padding: 100rpx 0;
    display: flex;
    justify-content: center;
}

/* 头部卡片 */
.profile-header {
    display: flex;
    align-items: center;
    background: #e8f4ff;
    padding: 40rpx 40rpx;
    margin: 30rpx;
    border-radius: 32rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.avatar {
    width: 140rpx;
    height: 140rpx;
    border-radius: 50%;
    border: 4rpx solid rgba(255, 255, 255, 0.5);
    margin-right: 30rpx;
    background: #f0f0f0;
}

.info {
    flex: 1;
}

.name {
    display: block;
    font-size: 36rpx;
    font-weight: bold;
    color: var(--primary-color);
    margin-bottom: 8rpx;
}

.school,
.major {
    display: block;
    font-size: 28rpx;
    color: var(--primary-color);
    opacity: 0.85;
    margin-bottom: 4rpx;
}

/* 内容区块 */
.section {
    background: var(--card-bg);
    border-radius: 24rpx;
    padding: 30rpx;
    margin: 0 30rpx 30rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.section-title {
    display: block;
    font-size: 32rpx;
    font-weight: 500;
    color: var(--text-main);
    margin-bottom: 16rpx;
}

.section-content {
    font-size: 32rpx;
    color: var(--text-gray);
    line-height: 1.8;
    white-space: pre-wrap;
}

/* 技能标签 */
.skills {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
}

.skill-tag {
    margin: 0 !important;
}

/* 联系方式 */
.contact-section {
    background: linear-gradient(135deg, var(--bg-color) 0%, #f5f7fa 100%);
}

.contact-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.contact-text {
    font-size: 32rpx;
    color: var(--text-main);
    font-weight: 500;
}

.copy-btn {
    padding: 12rpx 32rpx;
    background: var(--primary-color);
    color: #ffffff;
    font-size: 24rpx;
    border-radius: 32rpx;
    border: none;
}

.copy-btn::after {
    border: none;
}

/* 底部操作栏 */
.action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 30rpx 40rpx;
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    background: var(--card-bg);
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.send-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 96rpx;
    background: var(--primary-color);
    color: #ffffff;
    font-size: 28rpx;
    font-weight: 500;
    border-radius: 48rpx;
    border: none;
}

.send-btn::after {
    border: none;
}

.send-btn[disabled] {
    background: var(--text-main);
    opacity: 0.12;
    color: var(--text-main);
}

/* 空状态 */
.empty-container {
    padding: 100rpx 0;
}

/* ==================== 项目选择弹窗 ==================== */
.project-picker-popup {
    padding: 40rpx;
    padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
    background: var(--card-bg);
}

.project-loading {
    padding: 60rpx 0;
    display: flex;
    justify-content: center;
}

.project-list {
    max-height: 50vh;
}

.project-item {
    display: flex;
    align-items: center;
    padding: 30rpx 16rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.project-item:last-child {
    border-bottom: none;
}

.project-item-info {
    flex: 1;
    min-width: 0;
}

.project-item-name {
    display: block;
    font-size: 32rpx;
    font-weight: 500;
    color: var(--text-main);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.project-item-desc {
    display: block;
    font-size: 24rpx;
    color: var(--text-gray);
    margin-top: 4rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.project-empty {
    padding: 40rpx 0;
}

/* ==================== 购买弹窗 ==================== */
.purchase-popup {
    padding: 40rpx;
    padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
    background: var(--card-bg);
}

.popup-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40rpx;
}

.popup-title {
    font-size: 36rpx;
    font-weight: 600;
    color: var(--text-main);
}

/* 商品信息 */
.product-info {
    display: flex;
    align-items: center;
    gap: 30rpx;
    background: #f5f7fa;
    padding: 40rpx;
    border-radius: 32rpx;
    margin-bottom: 40rpx;
}

.product-icon {
    font-size: 48rpx;
}

.product-detail {
    flex: 1;
}

.product-name {
    display: block;
    font-size: 32rpx;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 8rpx;
}

.product-desc {
    font-size: 24rpx;
    color: var(--text-gray);
}

.product-price {
    font-size: 32rpx;
    font-weight: 600;
    color: var(--primary-color);
}

/* 数量选择 */
.quantity-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 0;
    border-bottom: 1rpx solid #f0f0f0;
}

.quantity-label {
    font-size: 32rpx;
    color: var(--text-main);
}

/* 总价 */
.total-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32rpx 0;
}

.total-label {
    font-size: 32rpx;
    color: var(--text-main);
}

.total-price {
    font-size: 44rpx;
    font-weight: 700;
    color: #ff4d4d;
}

/* 购买按钮 */
.purchase-btn {
    margin-top: 16rpx;
    background: var(--primary-color) !important;
    color: #ffffff !important;
    border: none !important;
}
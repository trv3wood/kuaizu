/* pages/talent-detail/talent-detail.wxss */
.talent-detail-container {
    min-height: 100vh;
    background: #f5f6fa;
    padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 加载中 */
.loading-container {
    padding: 100rpx 0;
    display: flex;
    justify-content: center;
}

/* 头部卡片 */
.profile-header {
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 40rpx 32rpx;
    margin: 24rpx;
    border-radius: 20rpx;
}

.avatar {
    width: 140rpx;
    height: 140rpx;
    border-radius: 50%;
    border: 4rpx solid rgba(255, 255, 255, 0.5);
    margin-right: 24rpx;
    background: #f5f6fa;
}

.info {
    flex: 1;
}

.name {
    display: block;
    font-size: 36rpx;
    font-weight: bold;
    color: #fff;
    margin-bottom: 8rpx;
}

.school,
.major {
    display: block;
    font-size: 26rpx;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 4rpx;
}

/* 内容区块 */
.section {
    background: #fff;
    border-radius: 16rpx;
    padding: 24rpx;
    margin: 0 24rpx 24rpx;
}

.section-title {
    display: block;
    font-size: 28rpx;
    font-weight: 500;
    color: #333;
    margin-bottom: 16rpx;
}

.section-content {
    font-size: 28rpx;
    color: #666;
    line-height: 1.8;
    white-space: pre-wrap;
}

/* 技能标签 */
.skills {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
}

.skill-tag {
    margin: 0 !important;
}

/* 联系方式 */
.contact-section {
    background: linear-gradient(135deg, #f5f7fa 0%, #e4e8eb 100%);
}

.contact-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.contact-text {
    font-size: 30rpx;
    color: #333;
    font-weight: 500;
}

.copy-btn {
    padding: 12rpx 32rpx;
    background: #667eea;
    color: #fff;
    font-size: 26rpx;
    border-radius: 32rpx;
    border: none;
}

.copy-btn::after {
    border: none;
}

/* 底部操作栏 */
.action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24rpx 32rpx;
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    background: #fff;
    box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.send-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 96rpx;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
    font-size: 32rpx;
    font-weight: 500;
    border-radius: 48rpx;
    border: none;
}

.send-btn::after {
    border: none;
}

.send-btn[disabled] {
    opacity: 0.7;
}

/* 空状态 */
.empty-container {
    padding: 100rpx 0;
}

/* ==================== 购买弹窗 ==================== */
.purchase-popup {
    padding: 32rpx;
    padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.popup-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32rpx;
}

.popup-title {
    font-size: 36rpx;
    font-weight: 600;
    color: #333;
}

/* 商品信息 */
.product-info {
    display: flex;
    align-items: center;
    gap: 24rpx;
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.08) 0%, rgba(118, 75, 162, 0.08) 100%);
    padding: 32rpx;
    border-radius: 20rpx;
    margin-bottom: 32rpx;
}

.product-icon {
    font-size: 48rpx;
}

.product-detail {
    flex: 1;
}

.product-name {
    display: block;
    font-size: 32rpx;
    font-weight: 600;
    color: #333;
    margin-bottom: 8rpx;
}

.product-desc {
    font-size: 26rpx;
    color: #999;
}

.product-price {
    font-size: 30rpx;
    font-weight: 600;
    color: #667eea;
}

/* 数量选择 */
.quantity-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 0;
    border-bottom: 1rpx solid #f0f0f0;
}

.quantity-label {
    font-size: 30rpx;
    color: #333;
}

/* 总价 */
.total-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32rpx 0;
}

.total-label {
    font-size: 30rpx;
    color: #333;
}

.total-price {
    font-size: 44rpx;
    font-weight: 700;
    color: #ee0a24;
}

/* 购买按钮 */
.purchase-btn {
    margin-top: 16rpx;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
    border: none !important;
}
/* pages/talent-detail/talent-detail.wxss */
.talent-detail-container {
    min-height: 100vh;
    background: var(--color-bg-base);
    padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 加载中 */
.loading-container {
    padding: 100rpx 0;
    display: flex;
    justify-content: center;
}

/* 头部卡片 */
.profile-header {
    display: flex;
    align-items: center;
    background: var(--color-primary);
    padding: 40rpx var(--spacing-md);
    margin: var(--spacing-sm);
    border-radius: var(--radius-lg);
}

.avatar {
    width: 140rpx;
    height: 140rpx;
    border-radius: 50%;
    border: 4rpx solid rgba(255, 255, 255, 0.5);
    margin-right: var(--spacing-sm);
    background: var(--color-bg-base);
}

.info {
    flex: 1;
}

.name {
    display: block;
    font-size: 36rpx;
    font-weight: bold;
    color: var(--color-text-inverse);
    margin-bottom: 8rpx;
}

.school,
.major {
    display: block;
    font-size: 26rpx;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 4rpx;
}

/* 内容区块 */
.section {
    background: var(--color-bg-card);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm);
    margin: 0 var(--spacing-sm) var(--spacing-sm);
}

.section-title {
    display: block;
    font-size: 28rpx;
    font-weight: 500;
    color: var(--color-text-main);
    margin-bottom: var(--spacing-xs);
}

.section-content {
    font-size: 28rpx;
    color: var(--color-text-secondary);
    line-height: 1.8;
    white-space: pre-wrap;
}

/* 技能标签 */
.skills {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
}

.skill-tag {
    margin: 0 !important;
}

/* 联系方式 */
.contact-section {
    background: linear-gradient(135deg, var(--color-bg-base) 0%, #e4e8eb 100%);
}

.contact-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.contact-text {
    font-size: 30rpx;
    color: var(--color-text-main);
    font-weight: 500;
}

.copy-btn {
    padding: 12rpx 32rpx;
    background: var(--color-primary);
    color: var(--color-text-inverse);
    font-size: 26rpx;
    border-radius: 32rpx;
    border: none;
}

.copy-btn::after {
    border: none;
}

/* 底部操作栏 */
.action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--spacing-sm) var(--spacing-md);
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    background: var(--color-bg-card);
    box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.send-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 96rpx;
    background: var(--color-primary-dark);
    color: var(--color-text-inverse);
    font-size: 32rpx;
    font-weight: 500;
    border-radius: 48rpx;
    border: none;
}

.send-btn::after {
    border: none;
}

.send-btn[disabled] {
    opacity: 0.7;
}

/* 空状态 */
.empty-container {
    padding: 100rpx 0;
}

/* ==================== 购买弹窗 ==================== */
.purchase-popup {
    padding: var(--spacing-md);
    padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.popup-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-md);
}

.popup-title {
    font-size: 36rpx;
    font-weight: 600;
    color: var(--color-text-main);
}

/* 商品信息 */
.product-info {
    display: flex;
    align-items: center;
    gap: var(--spacing-sm);
    background: linear-gradient(135deg, rgba(79, 70, 229, 0.08) 0%, rgba(55, 48, 163, 0.08) 100%);
    padding: var(--spacing-md);
    border-radius: var(--radius-lg);
    margin-bottom: var(--spacing-md);
}

.product-icon {
    font-size: 48rpx;
}

.product-detail {
    flex: 1;
}

.product-name {
    display: block;
    font-size: 32rpx;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: 8rpx;
}

.product-desc {
    font-size: 26rpx;
    color: var(--color-text-tertiary);
}

.product-price {
    font-size: 30rpx;
    font-weight: 600;
    color: var(--color-primary);
}

/* 数量选择 */
.quantity-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 0;
    border-bottom: 1rpx solid var(--color-divider);
}

.quantity-label {
    font-size: 30rpx;
    color: var(--color-text-main);
}

/* 总价 */
.total-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32rpx 0;
}

.total-label {
    font-size: 30rpx;
    color: var(--color-text-main);
}

.total-price {
    font-size: 44rpx;
    font-weight: 700;
    color: var(--color-danger);
}

/* 购买按钮 */
.purchase-btn {
    margin-top: 16rpx;
    background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary-dark) 100%) !important;
    border: none !important;
}
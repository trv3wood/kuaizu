/* pages/talent-detail/talent-detail.wxss */
.talent-detail-container {
    min-height: 100vh;
}

.hero-shell {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 560rpx;
    background: linear-gradient(180deg, var(--bg-gradient-start) 0%, var(--bg-gradient-mid) 58%, var(--bg-page-muted) 100%);
    z-index: 0;
}

.hero-nav {
    z-index: 2;
}

.hero-nav-row {
    padding: 0 22rpx;
}

.detail-scroll {
    position: relative;
    z-index: 1;
    height: 100vh;
}

.loading-container,
.empty-container {
    padding: 220rpx 0;
    display: flex;
    justify-content: center;
}

.hero-profile {
    position: relative;
    padding: 110rpx 42rpx 36rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.hero-mbti-bg {
    position: absolute;
    top: 44rpx;
    left: 50%;
    transform: translateX(-50%);
    font-size: 164rpx;
    line-height: 1;
    font-weight: 800;
    opacity: 0.22;
    letter-spacing: 4rpx;
    text-transform: uppercase;
    white-space: nowrap;
}

.avatar {
    width: 176rpx;
    height: 176rpx;
    border-radius: 50%;
    background: #e9edf2;
    border: 6rpx solid rgba(255, 255, 255, 0.75);
    position: relative;
    z-index: 1;
}

.name-row {
    margin-top: 18rpx;
    position: relative;
    z-index: 1;
}

.name {
    font-size: 56rpx;
    line-height: 1.2;
    font-weight: 800;
    color: #111111;
}

.pill-list {
    margin-top: 20rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14rpx;
    position: relative;
    z-index: 1;
}

.info-pill {
    max-width: 100%;
}

.pill-text {
    font-size: 22rpx;
    line-height: 1.3;
    color: #111111;
    font-weight: 700;
}

.content-sections {
    padding: 0 21rpx;
}

.public-contact-list {
    display: flex;
    flex-direction: column;
    gap: 16rpx;
}

.public-contact-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20rpx;
    padding: 24rpx 20rpx;
    border-radius: 28rpx;
    background: linear-gradient(180deg, #f7fbff 0%, #edf5ff 100%);
}

.public-contact-main {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 14rpx;
}

.public-contact-label {
    flex-shrink: 0;
    font-size: 26rpx;
    line-height: 1.4;
    color: #4f6f96;
    font-weight: 700;
}

.public-contact-value {
    min-width: 0;
    font-size: 27rpx;
    line-height: 1.5;
    color: #111111;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.section-card {
    padding: 26rpx 22rpx 20rpx;
    margin-bottom: 24rpx;
}

.section-title-row {
    display: flex;
    align-items: center;
    gap: 10rpx;
    margin-bottom: 22rpx;
}

.title-accent {
    width: 20rpx;
    height: 8rpx;
    border-radius: 999rpx;
    background: linear-gradient(90deg, #88bcff 0%, rgba(255, 255, 255, 0) 100%);
    transform: rotate(-30deg);
}

.section-title {
    font-size: 32rpx;
    line-height: 1.3;
    font-weight: 700;
    color: #111111;
}

.section-content {
    display: block;
    font-size: 28rpx;
    line-height: 1.7;
    color: rgba(0, 0, 0, 0.8);
    white-space: pre-wrap;
}

.section-content-pre {
    white-space: pre-wrap;
}

.skill-grid {
    margin-top: 20rpx;
    display: flex;
    flex-wrap: wrap;
    gap: 10rpx 12rpx;
}

.skill-chip {
    min-height: 44rpx;
    padding: 0 14rpx;
}

.skill-chip text {
    font-size: 24rpx;
    line-height: 1.3;
    color: #252525;
}

.detail-spacer {
    height: calc(150rpx + env(safe-area-inset-bottom));
}

.action-bar {
    padding: 18rpx 57rpx calc(24rpx + env(safe-area-inset-bottom));
    z-index: 5;
}

.send-btn {
    height: 94rpx;
    font-size: 28rpx;
}

.send-btn[disabled] {
    opacity: 0.65;
    color: #ffffff;
}

.project-picker-popup,
.purchase-popup {
    padding: 40rpx;
    padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
    background: #ffffff;
}

.popup-title {
    font-size: 36rpx;
    font-weight: 700;
    color: #111111;
}

.project-loading {
    padding: 60rpx 0;
    display: flex;
    justify-content: center;
}

.project-list {
    max-height: 50vh;
}

.project-item {
    display: flex;
    align-items: center;
    padding: 30rpx 16rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.project-item:last-child {
    border-bottom: none;
}

.project-item-name {
    display: block;
    font-size: 32rpx;
    font-weight: 500;
    color: #111111;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.project-item-desc {
    display: block;
    font-size: 24rpx;
    color: #777777;
    margin-top: 4rpx;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.project-empty {
    padding: 40rpx 0;
}

.product-info {
    gap: 30rpx;
    padding: 40rpx;
    margin-bottom: 40rpx;
}

.product-icon {
    font-size: 48rpx;
}

.product-detail {
    flex: 1;
}

.product-name {
    display: block;
    font-size: 32rpx;
    font-weight: 600;
    color: #111111;
    margin-bottom: 8rpx;
}

.product-desc {
    font-size: 24rpx;
    color: #777777;
}

.product-price {
    font-size: 32rpx;
    font-weight: 600;
    color: #559dfc;
}

.quantity-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 0;
    border-bottom: 1rpx solid #f0f0f0;
}

.quantity-label,
.total-label {
    font-size: 32rpx;
    color: #111111;
}

.total-section {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 32rpx 0;
}

.total-price {
    font-size: 44rpx;
    font-weight: 700;
    color: #ff4d4d;
}

.purchase-btn {
    margin-top: 16rpx;
    background: #559dfc !important;
    color: #ffffff !important;
    border: none !important;
}

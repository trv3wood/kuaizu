<!-- pages/my-orders/my-orders.wxml -->
<view class="orders-container">
    <!-- 标签栏 -->
    <view class="tabs">
        <view class="tab-item {{activeTab === index ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="name" data-index="{{index}}" bindtap="handleTabChange">
            {{item.name}}
        </view>
    </view>
    <!-- 加载中 -->
    <view class="loading-container" wx:if="{{loading}}">
        <van-loading size="24px">加载中...</van-loading>
    </view>
    <!-- 订单列表 -->
    <view class="order-list" wx:elif="{{orders.length > 0}}">
        <view class="order-card" wx:for="{{orders}}" wx:key="id" data-order="{{item}}" bindtap="handleOrderTap">
            <view class="order-header">
                <text class="order-time">{{item.formattedTime}}</text>
                <text class="order-status status-{{item.status}}">{{item.statusText}}</text>
            </view>
            <view class="order-body">
                <view class="order-info">
                    <text class="product-name">{{item.productName || '商品'}}</text>
                </view>
                <view class="order-price">
                    <text class="price">{{item.formattedPrice}}</text>
                </view>
            </view>
            <view class="order-footer" wx:if="{{item.status === 0}}">
                <button class="pay-btn" catchtap="handlePayOrder" data-order="{{item}}">
                    立即支付
                </button>
            </view>
        </view>
        <!-- 加载更多 -->
        <view class="load-more" wx:if="{{loadingMore}}">
            <van-loading size="20px">加载中...</van-loading>
        </view>
        <view class="no-more" wx:elif="{{!hasMore}}">
            <text>没有更多了</text>
        </view>
    </view>
    <!-- 空状态 -->
    <view class="empty-container" wx:else>
        <van-empty description="暂无订单">
            <button class="empty-btn" bindtap="goShopping">去购买</button>
        </van-empty>
    </view>
</view>
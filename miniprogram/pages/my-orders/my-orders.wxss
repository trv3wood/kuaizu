/* pages/my-orders/my-orders.wxss */
.orders-container {
    min-height: 100vh;
    background: #f5f6fa;
}

/* 标签栏 */
.tabs {
    display: flex;
    background: #fff;
    padding: 0 32rpx;
    border-bottom: 1rpx solid #eee;
}

.tab-item {
    flex: 1;
    text-align: center;
    padding: 28rpx 0;
    font-size: 28rpx;
    color: #666;
    position: relative;
}

.tab-item.active {
    color: #667eea;
    font-weight: 500;
}

.tab-item.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 48rpx;
    height: 4rpx;
    background: #667eea;
    border-radius: 2rpx;
}

/* 加载中 */
.loading-container {
    padding: 100rpx 0;
    display: flex;
    justify-content: center;
}

/* 订单列表 */
.order-list {
    padding: 24rpx;
}

.order-card {
    background: #fff;
    border-radius: 16rpx;
    padding: 24rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.order-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 20rpx;
    border-bottom: 1rpx solid #f5f5f5;
}

.order-time {
    font-size: 24rpx;
    color: #999;
}

.order-status {
    font-size: 24rpx;
    padding: 4rpx 12rpx;
    border-radius: 8rpx;
}

.order-status.status-0 {
    color: #ff976a;
    background: rgba(255, 151, 106, 0.1);
}

.order-status.status-1 {
    color: #07c160;
    background: rgba(7, 193, 96, 0.1);
}

.order-status.status-2,
.order-status.status-3 {
    color: #999;
    background: #f5f5f5;
}

.order-body {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 0;
}

.order-info {
    flex: 1;
}

.product-name {
    font-size: 28rpx;
    color: #333;
    font-weight: 500;
}

.order-price {
    text-align: right;
}

.price {
    font-size: 32rpx;
    color: #333;
    font-weight: bold;
}

.order-footer {
    padding-top: 20rpx;
    border-top: 1rpx solid #f5f5f5;
    display: flex;
    justify-content: flex-end;
}

.pay-btn {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
    font-size: 26rpx;
    padding: 12rpx 32rpx;
    border-radius: 32rpx;
    border: none;
}

.pay-btn::after {
    border: none;
}

/* 加载更多 */
.load-more,
.no-more {
    padding: 32rpx;
    text-align: center;
}

.no-more text {
    font-size: 24rpx;
    color: #999;
}

/* 空状态 */
.empty-container {
    padding: 100rpx 0;
}

.empty-btn {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
    font-size: 28rpx;
    padding: 20rpx 48rpx;
    border-radius: 40rpx;
    border: none;
    margin-top: 32rpx;
}

.empty-btn::after {
    border: none;
}
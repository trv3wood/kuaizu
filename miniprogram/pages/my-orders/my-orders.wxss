/* pages/my-orders/my-orders.wxss */
.orders-container {
    padding-bottom: env(safe-area-inset-bottom);
}

/* 标签栏 */
.tabs {
    display: flex;
    background: var(--card-bg);
    padding: 0 40rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
    flex: 1;
    text-align: center;
    padding: 28rpx 0;
    font-size: 28rpx;
    color: var(--text-gray);
    position: relative;
}

.tab-item.active {
    color: var(--primary-color);
    font-weight: 500;
}

.tab-item.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 48rpx;
    height: 4rpx;
    background: var(--primary-color);
    border-radius: 2rpx;
}

/* 订单列表 */
.order-list {
    padding: 30rpx;
}

.order-card {
    padding: 30rpx;
    margin-bottom: 30rpx;
}

.order-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 20rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.order-id {
    font-size: 24rpx;
    color: var(--text-gray);
}

.order-status {
    font-size: 24rpx;
    padding: 4rpx 12rpx;
    border-radius: 16rpx;
}

.order-status.status-0 {
    color: var(--text-gray);
    background: #f5f7fa;
}

.order-status.status-1 {
    color: #10B981;
    /* Success Green */
    background: #d1fae5;
}

.order-status.status-2 {
    color: #ff4d4d;
    background: #fff0f0;
}

.order-status.status-3 {
    color: var(--text-gray);
    background: #f5f7fa;
}

.order-body {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx 0;
}

.order-info {
    flex: 1;
}

.product-name {
    font-size: 32rpx;
    color: var(--text-main);
    font-weight: 500;
}

.order-price {
    text-align: right;
}

.price {
    font-size: 36rpx;
    color: var(--text-main);
    font-weight: bold;
}

/* 详细信息 */
.order-detail {
    padding: 16rpx 0;
    border-top: 1rpx solid #f0f0f0;
}

.detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 8rpx 0;
}

.detail-label {
    font-size: 24rpx;
    color: var(--text-gray);
}

.detail-value {
    font-size: 24rpx;
    color: var(--text-gray);
}

.order-footer {
    padding-top: 20rpx;
    border-top: 1rpx solid #f0f0f0;
    display: flex;
    justify-content: flex-end;
    gap: 16rpx;
}

.cancel-btn {
    padding: 12rpx 32rpx;
}

.pay-btn {
    padding: 12rpx 32rpx;
    box-shadow: var(--shadow-sm);
}

/* 加载更多 */
.load-more,
.no-more {
    padding: 40rpx;
    text-align: center;
}

.no-more text {
    font-size: 28rpx;
    color: var(--text-gray);
}

/* 空状态 */
.empty-container {
    padding: 100rpx 0;
}

.empty-btn {
    padding: 20rpx 48rpx;
    margin-top: 40rpx;
    box-shadow: var(--shadow-sm);
}

/* pages/projects/projects.wxss */

.project-list {
  padding: 0 22rpx;
}

.project-card {
  background: var(--card-bg);
  border-radius: var(--radius-xl);
  margin-bottom: 34rpx;
  padding: 22rpx 30rpx 32rpx;
  box-shadow: 4rpx 4rpx 12rpx rgba(0, 0, 0, 0.14);
}

.project-card:active {
  transform: scale(0.985);
}

.card-top {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  position: relative;
  min-height: 48rpx;
}

.direction-icon {
  font-size: 36rpx;
  line-height: 1;
}

.view-badge {
  position: absolute;
  right: 0;
  top: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.view-text {
  font-size: 30rpx;
  line-height: 1;
  color: #989da5;
  font-weight: 700;
}

.project-name {
  display: block;
  margin: 18rpx auto 22rpx;
  max-width: 100%;
  text-align: center;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 800;
  color: #111111;
}

.school-pill-wrap {
  text-align: center;
}

.school-pill {
  display: inline-flex;
  margin: 0 auto;
  max-width: 100%;
  min-height: 54rpx;
  padding: 0 24rpx;
  border-radius: var(--radius-pill);
  background: var(--bg-pill-blue);
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.school-pill-icon {
  font-size: 24rpx;
  line-height: 1;
}

.school-pill-text {
  font-size: 22rpx;
  line-height: 1.2;
  color: #101010;
  font-weight: 700;
}

.page-footer {
  padding: 90rpx 0 40rpx;
  gap: 10rpx;
}

.filter-direction-grid {
  display: flex;
  align-items: stretch;
  justify-content: space-between;
}

.direction-tile {
  width: 91px;
  height: 97px;
  border-radius: 20px;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
}

.direction-tile.active {
  background: #cff8ff;
}

.direction-tile-label {
  font-size: 30rpx;
  line-height: 44rpx;
  color: #111111;
  font-weight: 700;
}

.direction-tile-icon {
  font-size: 40rpx;
  line-height: 1;
}

.cross-school-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22rpx;
  min-height: 66rpx;
}

.cross-school-option {
  min-width: 112rpx;
  height: 62rpx;
  padding: 0 18rpx;
  border-radius: 31rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  line-height: 44rpx;
  color: rgba(0, 0, 0, 0.5);
}

.cross-school-option.active {
  background: var(--bg-pill-blue);
  color: #111111;
  font-weight: 500;
}

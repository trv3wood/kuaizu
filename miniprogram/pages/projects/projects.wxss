/* pages/projects/projects.wxss */
.projects-container {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 搜索栏 */
.search-bar {
  background: var(--card-bg);
  padding: 16rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* 加载中 */
.loading-container {
  padding: 100rpx 0;
  display: flex;
  justify-content: center;
}

/* 项目列表 */
.project-list {
  padding: 30rpx;
}

.project-card {
  background: var(--card-bg);
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s;
}

.project-card:active {
  transform: scale(0.98);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.project-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-right: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 卡片描述 */
.card-description {
  margin-bottom: 20rpx;
}

.description-text {
  font-size: 28rpx;
  color: var(--text-gray);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 卡片底部信息 */
.card-footer {
  display: flex;
  gap: 40rpx;
}

.info-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.info-text {
  font-size: 24rpx;
  color: var(--text-gray);
}

/* 加载更多 */
.load-more,
.no-more {
  padding: 40rpx;
  text-align: center;
}

.no-more text {
  font-size: 24rpx;
  color: var(--text-gray);
}

/* 空状态 */
.empty-container {
  padding: 100rpx 0;
}


/* 筛选面板 */
.filter-panel {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--card-bg);
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
}

.filter-content {
  flex: 1;
  overflow-y: auto;
  padding: 30rpx;
}

.filter-section {
  margin-bottom: 48rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
  margin-bottom: 20rpx;
}

.picker-value {
  padding: 20rpx 24rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 32rpx;
  color: var(--text-main);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.option-item {
  padding: 16rpx 32rpx;
  background: #f5f7fa;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--text-gray);
  transition: all 0.2s;
}

.option-item.active {
  background: #f5f7fa;
  color: var(--text-main);
}

/* 筛选操作 */
.filter-actions {
  display: flex;
  gap: 16rpx;
  padding: 30rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f0f0;
}

.reset-btn,
.apply-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  border-radius: 44rpx;
  border: none;
}

.reset-btn {
  background: #f0f0f0;
  color: var(--text-main);
}

.apply-btn {
  background: var(--primary-color);
  color: #ffffff;
}

.reset-btn::after,
.apply-btn::after {
  border: none;
}

/* 学校搜索弹出层 */
.picker-popup {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.picker-header {
  padding: 40rpx 30rpx;
  text-align: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-main);
}

.picker-search {
  padding: 16rpx 0;
}

.picker-list {
  flex: 1;
  height: 0;
}

.picker-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 40rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-item:active {
  background: #f0f0f0;
}

.picker-empty {
  padding: 60rpx;
  text-align: center;
  color: var(--text-gray);
  font-size: 28rpx;
}
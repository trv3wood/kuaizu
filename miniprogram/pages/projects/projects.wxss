/* pages/projects/projects.wxss */
.projects-container {
  min-height: 100vh;
  background: var(--color-bg-base);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 搜索栏 */
.search-bar {
  background: var(--color-bg-card);
  padding: 16rpx 24rpx;
  box-shadow: var(--shadow-sm);
}

/* 加载中 */
.loading-container {
  padding: 100rpx 0;
  display: flex;
  justify-content: center;
}

/* 项目列表 */
.project-list {
  padding: var(--spacing-sm);
}

.project-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm);
  margin-bottom: var(--spacing-sm);
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s;
}

.project-card:active {
  transform: scale(0.98);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-xs);
}

.project-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-text-main);
  margin-right: var(--spacing-xs);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 卡片描述 */
.card-description {
  margin-bottom: 20rpx;
}

.description-text {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 卡片底部信息 */
.card-footer {
  display: flex;
  gap: var(--spacing-md);
}

.info-item {
  display: flex;
  align-items: center;
  gap: var(--spacing-xxs);
}

.info-text {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* 加载更多 */
.load-more,
.no-more {
  padding: var(--spacing-md);
  text-align: center;
}

.no-more text {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* 空状态 */
.empty-container {
  padding: 100rpx 0;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary-dark) 100%);
  box-shadow: var(--shadow-float);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  transition: transform 0.2s;
}

.fab:active {
  transform: scale(0.95);
}

/* 筛选面板 */
.filter-panel {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-card);
}

.filter-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-md) var(--spacing-sm);
  border-bottom: 1rpx solid var(--color-border);
}

.filter-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-text-main);
}

.filter-content {
  flex: 1;
  overflow-y: auto;
  padding: var(--spacing-sm);
}

.filter-section {
  margin-bottom: 48rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-main);
  margin-bottom: 20rpx;
}

.picker-value {
  padding: 20rpx 24rpx;
  background: var(--color-bg-base);
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--color-text-main);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-xs);
}

.option-item {
  padding: 16rpx 32rpx;
  background: var(--color-bg-base);
  border-radius: 32rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  transition: all 0.2s;
}

.option-item.active {
  background: var(--color-primary);
  color: #fff;
}

/* 筛选操作 */
.filter-actions {
  display: flex;
  gap: var(--spacing-xs);
  padding: var(--spacing-sm);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--color-border);
}

.reset-btn,
.apply-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  border-radius: 44rpx;
  border: none;
}

.reset-btn {
  background: var(--color-bg-base);
  color: var(--color-text-secondary);
}

.apply-btn {
  background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary-dark) 100%);
  color: #fff;
}

.reset-btn::after,
.apply-btn::after {
  border: none;
}

/* 学校搜索弹出层 */
.picker-popup {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.picker-header {
  padding: var(--spacing-md) var(--spacing-sm);
  text-align: center;
  border-bottom: 1rpx solid var(--color-border);
}

.picker-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--color-text-main);
}

.picker-search {
  padding: 16rpx 0;
}

.picker-list {
  flex: 1;
  height: 0;
}

.picker-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-sm) var(--spacing-md);
  border-bottom: 1rpx solid var(--color-divider);
}

.picker-item:active {
  background: var(--color-bg-base);
}

.picker-empty {
  padding: 60rpx;
  text-align: center;
  color: var(--color-text-tertiary);
  font-size: 28rpx;
}
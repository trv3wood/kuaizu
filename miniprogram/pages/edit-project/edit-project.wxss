/* pages/edit-project/edit-project.wxss */
.edit-project-container {
    min-height: 100vh;
    background: #f5f6fa;
    padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 表单区域 */
.form-section {
    padding: 24rpx;
}

.form-group {
    background: #fff;
    border-radius: 16rpx;
    padding: 24rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.form-label {
    font-size: 28rpx;
    font-weight: 500;
    color: #333;
    margin-bottom: 16rpx;
    display: block;
}

.form-label.required::after {
    content: ' *';
    color: #ee0a24;
}

/* Stepper */
.stepper-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.stepper-hint {
    font-size: 26rpx;
    color: #999;
}

/* 方向选择 */
.direction-options {
    display: flex;
    gap: 16rpx;
}

.direction-item {
    flex: 1;
    background: #f8f9fa;
    border: 2rpx solid transparent;
    border-radius: 12rpx;
    padding: 20rpx 16rpx;
    text-align: center;
    transition: all 0.3s;
}

.direction-item.active {
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
    border-color: #667eea;
}

.direction-label {
    font-size: 28rpx;
    font-weight: 500;
    color: #333;
    margin-bottom: 8rpx;
}

.direction-item.active .direction-label {
    color: #667eea;
}

.direction-desc {
    font-size: 22rpx;
    color: #999;
}

.direction-item.active .direction-desc {
    color: #764ba2;
}

/* Placeholder样式 */
.placeholder {
    color: #c8c9cc !important;
}

/* 提交区域 */
.submit-section {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #fff;
    padding: 24rpx 32rpx;
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.submit-hint {
    display: block;
    text-align: center;
    font-size: 24rpx;
    color: #999;
    margin-top: 16rpx;
}

/* 学校选择器 */
.school-picker {
    height: 100%;
    display: flex;
    flex-direction: column;
}

.picker-header {
    padding: 32rpx;
    text-align: center;
}

.picker-title {
    font-size: 32rpx;
    font-weight: bold;
    color: #333;
}

.school-list {
    flex: 1;
    padding: 0 24rpx;
}

.school-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 16rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.school-item:active {
    background: #f8f9fa;
}

.school-item.active {
    background: rgba(102, 126, 234, 0.05);
}

.school-name {
    font-size: 28rpx;
    color: #333;
}

.school-item.active .school-name {
    color: #667eea;
    font-weight: 500;
}

.no-schools {
    padding: 60rpx;
    text-align: center;
    color: #999;
    font-size: 28rpx;
}
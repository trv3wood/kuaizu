/* pages/edit-project/edit-project.wxss */
.edit-project-container {
    min-height: 100vh;
    background: var(--color-bg-base);
    padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 表单区域 */
.form-section {
    padding: var(--spacing-sm);
}

.form-group {
    background: var(--color-bg-card);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
    box-shadow: var(--shadow-sm);
}

.form-label {
    font-size: 28rpx;
    font-weight: 500;
    color: var(--color-text-main);
    margin-bottom: var(--spacing-xs);
    display: block;
}

.form-label.required::after {
    content: ' *';
    color: var(--color-danger);
}

/* Stepper */
.stepper-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.stepper-hint {
    font-size: 26rpx;
    color: var(--color-text-tertiary);
}

/* 方向选择 */
.direction-options {
    display: flex;
    gap: var(--spacing-xs);
}

.direction-item {
    flex: 1;
    background: var(--color-bg-base);
    border: 2rpx solid transparent;
    border-radius: 12rpx;
    padding: 20rpx 16rpx;
    text-align: center;
    transition: all 0.3s;
}

.direction-item.active {
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(118, 75, 162, 0.1) 100%);
    border-color: var(--color-primary);
}

.direction-label {
    font-size: 28rpx;
    font-weight: 500;
    color: var(--color-text-main);
    margin-bottom: 8rpx;
}

.direction-item.active .direction-label {
    color: var(--color-primary);
}

.direction-desc {
    font-size: 22rpx;
    color: var(--color-text-tertiary);
}

.direction-item.active .direction-desc {
    color: var(--color-primary-dark);
}

/* Placeholder样式 */
.placeholder {
    color: var(--color-text-tertiary) !important;
}

/* 提交区域 */
.submit-section {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--color-bg-card);
    padding: var(--spacing-sm) var(--spacing-md);
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.submit-hint {
    display: block;
    text-align: center;
    font-size: 24rpx;
    color: var(--color-text-tertiary);
    margin-top: var(--spacing-xs);
}

/* 学校选择器 */
.school-picker {
    height: 100%;
    display: flex;
    flex-direction: column;
}

.picker-header {
    padding: 32rpx;
    text-align: center;
}

.picker-title {
    font-size: 32rpx;
    font-weight: bold;
    color: var(--color-text-main);
}

.school-list {
    flex: 1;
    padding: 0 var(--spacing-sm);
}

.school-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 16rpx;
    border-bottom: 1rpx solid var(--color-divider);
}

.school-item:active {
    background: var(--color-bg-base);
}

.school-item.active {
    background: rgba(102, 126, 234, 0.05);
}

.school-name {
    font-size: 28rpx;
    color: var(--color-text-main);
}

.school-item.active .school-name {
    color: var(--color-primary);
    font-weight: 500;
}

.no-schools {
    padding: 60rpx;
    text-align: center;
    color: var(--color-text-tertiary);
    font-size: 28rpx;
}
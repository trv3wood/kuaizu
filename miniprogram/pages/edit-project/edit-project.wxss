/* pages/edit-project/edit-project.wxss */
.edit-project-container {
    min-height: 100vh;
    background: var(--bg-color);
    padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 表单区域 */
.form-section {
    padding: 30rpx;
}

.form-group {
    background: var(--card-bg);
    border-radius: 24rpx;
    padding: 30rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.form-label {
    font-size: 28rpx;
    font-weight: 500;
    color: var(--text-main);
    margin-bottom: 16rpx;
    display: block;
}

.form-label.required::after {
    content: ' *';
    color: #ff4d4d;
}

/* Stepper */
.stepper-wrapper {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.stepper-hint {
    font-size: 24rpx;
    color: var(--text-gray);
}

/* 方向选择 */
.direction-options {
    display: flex;
    gap: 16rpx;
}

.direction-item {
    flex: 1;
    background: var(--card-bg);
    border: 2rpx solid transparent;
    border-radius: 24rpx;
    padding: 20rpx 16rpx;
    text-align: center;
    transition: all 0.3s;
}

.direction-item.active {
    background: #f5f7fa;
    border-color: var(--text-gray);
}

.direction-label {
    font-size: 28rpx;
    font-weight: 500;
    color: var(--text-main);
    margin-bottom: 8rpx;
}

.direction-item.active .direction-label {
    color: var(--text-main);
}

.direction-desc {
    font-size: 24rpx;
    color: var(--text-gray);
}

.direction-item.active .direction-desc {
    color: var(--text-main);
}

/* 标签选择（跨校 / 学历） */
.tag-options {
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.tag-item {
    padding: 12rpx 36rpx;
    border-radius: 100rpx;
    font-size: 26rpx;
    color: var(--text-gray);
    background: var(--bg-color);
    border: 2rpx solid transparent;
    transition: all 0.2s;
}

.tag-item.active {
    color: var(--text-main);
    background: #f5f7fa;
    border-color: var(--text-gray);
    font-weight: 500;
}

/* Placeholder样式 */
.placeholder {
    color: var(--text-gray) !important;
}

/* 提交区域 */
.submit-section {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--card-bg);
    padding: 30rpx 40rpx;
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.submit-hint {
    display: block;
    text-align: center;
    font-size: 24rpx;
    color: var(--text-gray);
    margin-top: 16rpx;
}

/* 学校选择器 */
.school-picker {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--card-bg);
}

.picker-header {
    padding: 32rpx;
    text-align: center;
}

.picker-title {
    font-size: 32rpx;
    font-weight: bold;
    color: var(--text-main);
}

.school-list {
    flex: 1;
    padding: 0 30rpx;
}

.school-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24rpx 16rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.school-item:active {
    background: #f0f0f0;
}

.school-item.active {
    background: #f5f7fa;
}

.school-name {
    font-size: 32rpx;
    color: var(--text-main);
}

.school-item.active .school-name {
    color: var(--text-main);
    font-weight: 500;
}

.no-schools {
    padding: 60rpx;
    text-align: center;
    color: var(--text-gray);
    font-size: 28rpx;
}
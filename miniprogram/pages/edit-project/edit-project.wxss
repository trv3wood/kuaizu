/* pages/edit-project/edit-project.wxss */

/* ===== Page background ===== */
.edit-project-container {
    min-height: 100vh;
    background: linear-gradient(to bottom, var(--bg-gradient-end) 0%, var(--bg-gradient-mid) 42%, var(--bg-gradient-start) 100%);
    padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ===== Form section ===== */
.form-section {
    padding: 20rpx 44rpx;
    display: flex;
    flex-direction: column;
    gap: 24rpx;
}

/* ===== Card base ===== */
.form-card {
    background: var(--card-bg);
    border-radius: var(--radius-md);
    padding: 28rpx 36rpx;
    box-shadow: var(--shadow-sm);
}

.form-card--inline {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

/* ===== Card title (所有卡的标题) ===== */
.card-title {
    font-size: 34rpx;
    font-weight: 500;
    color: #000000;
    line-height: 44rpx;
}

/* ===== Toggle buttons (接受 / 不接受) ===== */
.toggle-group {
    display: flex;
    align-items: center;
    gap: 8rpx;
}

.toggle-item {
    padding: 8rpx 28rpx;
    border-radius: 40rpx;
    font-size: 30rpx;
    color: rgba(0,0,0,0.5);
    transition: all 0.2s ease;
    line-height: 44rpx;
}

.toggle-item.active {
    background: var(--bg-pill-blue);
    color: #000000;
}

/* ===== Direction row (项目类型 3列) ===== */
.direction-row {
    display: flex;
    gap: 16rpx;
    margin-top: 24rpx;
}

.direction-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20rpx 8rpx;
    border-radius: 16rpx;
    border: 2rpx solid transparent;
    transition: all 0.2s ease;
}

.direction-col.active {
    background: #f5f7fa;
    border-color: #d0d0d0;
}

.direction-name {
    font-size: 30rpx;
    font-weight: 500;
    color: #000000;
    margin-bottom: 6rpx;
}

.direction-sub {
    font-size: 22rpx;
    color: rgba(0,0,0,0.45);
}

/* ===== School row (所属学校) ===== */
.school-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 20rpx;
    padding-bottom: 16rpx;
}

.school-text {
    font-size: 30rpx;
    color: #333333;
}

.school-text.placeholder {
    color: #c3c3c3;
}

.school-divider {
    height: 1rpx;
    background: #eeeeee;
}

/* ===== Bottom bar & publish button ===== */
.bottom-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #ffffff;
    padding: 24rpx 44rpx;
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.publish-btn {
    background: #3e84fa;
    color: #ffffff;
    border-radius: var(--radius-xl);
    text-align: center;
    font-size: 34rpx;
    font-weight: 600;
    line-height: 102rpx;
}

/* ===== Overrides for van-field word limit ===== */
.form-card .van-field__word-limit {
    font-size: 24rpx !important;
    color: rgba(0,0,0,0.8) !important;
}

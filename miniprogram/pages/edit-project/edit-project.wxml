<!-- pages/edit-project/edit-project.wxml -->
<view class="edit-project-container">
    <!-- 表单内容 -->
    <view class="form-section">
        <!-- 项目名称 -->
        <view class="form-card ui-card ui-card--md ui-card--shadow-sm">
            <view class="card-title ui-form-title">项目名称</view>
            <van-field
                value="{{form.name}}"
                placeholder="输入项目名称，不超过20字"
                maxlength="20"
                show-word-limit
                border="{{false}}"
                bind:change="onNameInput"
                custom-style="padding: 10rpx 0 0; font-size: 26rpx;"
                placeholder-style="color: rgba(144,144,144,0.6); font-size: 26rpx;"
            />
        </view>

        <!-- 项目描述 -->
        <view class="form-card ui-card ui-card--md ui-card--shadow-sm">
            <view class="card-title ui-form-title">项目描述</view>
            <van-field
                value="{{form.description}}"
                type="textarea"
                placeholder="描述你的项目，包括项目背景、目标和需要的人才类型…"
                autosize="{{ { minHeight: 60 } }}"
                maxlength="1000"
                show-word-limit
                border="{{false}}"
                bind:change="onDescriptionInput"
                custom-style="padding: 10rpx 0 0; font-size: 26rpx;"
                placeholder-style="color: rgba(144,144,144,0.6); font-size: 26rpx;"
            />
        </view>

        <!-- 团队人数 -->
        <view class="form-card form-card--inline ui-card ui-card--md ui-card--shadow-sm ui-card--row">
            <view class="card-title ui-form-title">团队人数</view>
            <van-stepper value="{{form.memberCount}}" min="1" max="50" bind:change="onMemberCountChange" />
        </view>

        <!-- 是否接受跨校 -->
        <view class="form-card form-card--inline ui-card ui-card--md ui-card--shadow-sm ui-card--row">
            <view class="card-title ui-form-title">是否接受跨校</view>
            <view class="toggle-group">
                <view class="toggle-item ui-pill {{form.isCrossSchool === 1 ? 'active' : ''}}" bindtap="onCrossSchoolSelect" data-value="{{1}}">接受</view>
                <view class="toggle-item ui-pill {{form.isCrossSchool === 0 ? 'active' : ''}}" bindtap="onCrossSchoolSelect" data-value="{{0}}">不接受</view>
            </view>
        </view>

        <!-- 项目类型 -->
        <view class="form-card ui-card ui-card--md ui-card--shadow-sm">
            <view class="card-title ui-form-title">项目类型</view>
            <view class="direction-row">
                <view wx:for="{{directions}}" wx:key="value"
                    class="direction-col {{form.direction === item.value ? 'active' : ''}}"
                    bindtap="onDirectionSelect" data-value="{{item.value}}">
                    <view class="direction-name">{{item.label}}</view>
                    <view class="direction-sub">{{item.desc}}</view>
                </view>
            </view>
        </view>

        <!-- 所属学校 -->
        <view class="form-card ui-card ui-card--md ui-card--shadow-sm" wx:if="{{!isEdit}}">
            <view class="card-title ui-form-title">所属学校</view>
            <view class="school-row" bindtap="onSchoolClick">
                <text class="school-text {{schoolId ? '' : 'placeholder'}}">{{schoolId ? schoolName : '选择学校'}}</text>
                <van-icon name="arrow" color="#999" size="16px" />
            </view>
            <view class="school-divider"></view>
        </view>
    </view>

    <!-- 提交按钮 -->
    <view class="bottom-bar ui-bottom-bar ui-bottom-bar--solid">
        <view class="publish-btn ui-btn ui-btn--block ui-btn--pill ui-btn--xl ui-btn--primary {{submitting ? 'disabled' : ''}}" bindtap="handleSubmit">
            {{submitting ? '提交中...' : (isEdit ? '保存修改' : '发布项目')}}
        </view>
    </view>
</view>

/* pages/my-projects/my-projects.wxss */

.my-projects-container {
    min-height: 100vh;
    background: #f6f7fb;
    position: relative;
    padding-bottom: env(safe-area-inset-bottom);
}

.page-background {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 700rpx;
    background: linear-gradient(180deg, #c4f1ff 0%, #eaf4fc 35%, #fafbfc 100%);
    z-index: 0;
}

.page-content {
    position: relative;
    z-index: 1;
    padding: 60rpx 44rpx;
}

.page-header { margin-bottom: 60rpx; }
.page-title {
    font-size: 48rpx;
    font-weight: 700;
    color: #000;
    margin-bottom: 24rpx;
}
.page-description {
    font-size: 24rpx;
    color: rgba(0, 0, 0, 0.5);
    line-height: 36rpx;
}

/* Loading */
.loading-container {
    padding: 200rpx 0;
    text-align: center;
}

/* Project Card */
.project-item {
    margin-bottom: 40rpx;
}

.project-card {
    background: #ffffff;
    border-radius: 40rpx;
    padding: 40rpx;
    box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
    position: relative;
}

.card-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24rpx;
}

.status-dot {
    width: 24rpx;
    height: 24rpx;
    border-radius: 50%;
    background: #ccc;
    margin-right: 12rpx;
    display: inline-block;
}
.status-dot.active { background: #35e08e; }
.status-text { font-size: 24rpx; color: #35e08e; font-weight: 700; }

.edit-btn { padding: 10rpx; color: #868686; }

.project-title {
    font-size: 40rpx;
    font-weight: 700;
    color: #000;
    margin-bottom: 40rpx;
    line-height: 56rpx;
}

.card-footer-row {
    display: flex;
    align-items: center;
    gap: 20rpx;
}

.promote-btn {
    flex: 1;
    background: linear-gradient(180deg, #ffd56e 0%, #ffeec4 100%);
    border-radius: 20rpx;
    height: 64rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8rpx;
    font-size: 32rpx;
    font-weight: 700;
    box-shadow: 0 4rpx 12rpx rgba(255, 213, 110, 0.4);
}

.megaphone-icon { width: 32rpx; height: 32rpx; }

.complete-btn {
    width: 130rpx;
    height: 64rpx;
    background: #5cd4fe;
    border-radius: 20rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 24rpx;
    font-weight: 700;
    box-shadow: 0 4rpx 12rpx rgba(92, 212, 254, 0.4);
}

.expand-icon { margin-left: auto; }

/* Applicant List */
.applicant-list {
    margin-top: -20rpx;
    background: #fff;
    padding: 40rpx 40rpx 20rpx;
    border-radius: 0 0 40rpx 40rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.applicant-card {
    background: #ffffff;
    border-radius: 40rpx;
    padding: 30rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 0 16rpx rgba(0, 0, 0, 0.1);
    position: relative;
    overflow: hidden;
}

.promotion-source {
    position: absolute;
    top: 20rpx;
    left: 20rpx;
    font-size: 22rpx;
    color: #7c7c7c;
    font-weight: bold;
}

.applicant-main {
    display: flex;
    gap: 24rpx;
    margin-top: 10rpx;
}

.avatar-container {
    position: relative;
    width: 120rpx;
    height: 120rpx;
}

.applicant-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
}

.grade-badge {
    position: absolute;
    bottom: -10rpx;
    left: 50%;
    transform: translateX(-50%);
    background: #559dfc;
    color: #fff;
    font-size: 20rpx;
    padding: 4rpx 12rpx;
    border-radius: 20rpx;
    white-space: nowrap;
    font-weight: bold;
}

.applicant-info { flex: 1; }

.applicant-name-row {
    display: flex;
    align-items: center;
    gap: 12rpx;
    margin-bottom: 8rpx;
}

.applicant-name {
    font-size: 36rpx;
    font-weight: 700;
}

.mbti-tag {
    background: #ffd05b;
    color: #fff;
    font-size: 24rpx;
    padding: 4rpx 16rpx;
    border-radius: 20rpx;
    font-weight: bold;
    margin-left: auto;
}

.applicant-school {
    font-size: 24rpx;
    color: #a4a4a4;
    font-weight: 500;
    margin-bottom: 16rpx;
}

.skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
}

.skill-tag {
    background: #f5f5f5;
    color: #000;
    font-size: 20rpx;
    padding: 4rpx 16rpx;
    border-radius: 8rpx;
    font-weight: 700;
}

.applicant-actions {
    margin-top: 24rpx;
}

.divider {
    height: 2rpx;
    background: #f5f5f5;
    margin-bottom: 24rpx;
}

.action-buttons {
    display: flex;
    justify-content: flex-end;
    gap: 24rpx;
    align-items: center;
}

.action-icon {
    width: 56rpx;
    height: 56rpx;
}

.status-pill {
    padding: 8rpx 32rpx;
    border-radius: 40rpx;
    font-size: 24rpx;
    font-weight: bold;
    color: #fff;
}
.status-pill.passed { background: #43d28d; }
.status-pill.rejected { background: #d81e06; }

/* Empty State */
.empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 100rpx;
}

.empty-icon-wrapper {
    width: 200rpx;
    height: 200rpx;
    background: #e0e0e0;
    border-radius: 50%;
    margin-bottom: 40rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.empty-img { width: 100rpx; height: 100rpx; opacity: 0.5; }

.empty-text {
    font-size: 28rpx;
    color: #999;
    margin-bottom: 60rpx;
}

.create-project-btn {
    width: 320rpx;
    height: 100rpx;
    background: #55b6ff;
    color: #fff;
    border-radius: 50rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 32rpx;
    font-weight: 700;
    box-shadow: 0 8rpx 24rpx rgba(85, 182, 255, 0.4);
}

.list-footer {
    padding: 40rpx;
    text-align: center;
    font-size: 24rpx;
    color: #999;
}

.promotion-dialog {
    padding: 40rpx;
}

.promotion-dialog-tip {
    margin-bottom: 30rpx;
    font-size: 28rpx;
    color: #666;
    line-height: 1.6;
}

.promotion-price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20rpx;
    font-size: 28rpx;
    color: #333;
}

.promotion-price {
    color: #ee0a24;
    font-weight: 700;
}

.promotion-total-row {
    margin-top: 30rpx;
    padding-top: 30rpx;
    border-top: 1px solid #f5f5f5;
    text-align: right;
}

.promotion-total-label {
    margin-right: 10rpx;
    font-size: 28rpx;
    color: #666;
}

.promotion-total-value {
    color: #ee0a24;
    font-size: 36rpx;
    font-weight: 700;
}

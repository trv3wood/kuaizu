/* pages/my-projects/my-projects.wxss */
.my-projects-container {
    min-height: 100vh;
    background: var(--md-sys-color-background);
    padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* Loading */
.loading-container {
    padding: 100rpx 0;
    display: flex;
    justify-content: center;
}

/* Project List */
.project-list {
    height: 100vh;
    padding: var(--spacing-sm);
}

.project-card {
    background: var(--md-sys-color-surface-container-lowest);
    border-radius: var(--md-sys-shape-corner-medium);
    margin-bottom: var(--spacing-sm);
    overflow: hidden;
    box-shadow: var(--md-sys-elevation-1);
}

/* Project Header */
.project-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--spacing-sm);
    border-bottom: 1rpx solid var(--md-sys-color-outline-variant);
    transition: background 0.2s;
}

.project-header:active {
    background: var(--md-sys-color-surface-container);
}

.header-left {
    flex: 1;
    margin-right: var(--spacing-xs);
}

.project-name {
    font-size: var(--md-sys-typescale-title-medium);
    font-weight: bold;
    color: var(--md-sys-color-on-surface);
    display: block;
    margin-bottom: 12rpx;
}

.project-meta {
    display: flex;
    gap: var(--spacing-xs);
}

.meta-item {
    font-size: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-outline);
}

.header-right {
    display: flex;
    align-items: center;
    gap: 12rpx;
}

.delete-icon,
.edit-icon {
    padding: 8rpx;
    transition: transform 0.2s;
}

.delete-icon:active,
.edit-icon:active {
    transform: scale(0.9);
}

/* Promote Container */
.promote-container {
    display: flex;
    align-items: center;
    padding: 8rpx 16rpx;
    background: var(--md-sys-color-error-container);
    border: 1rpx solid var(--md-sys-color-error);
    border-radius: var(--md-sys-shape-corner-full);
    margin-right: 10px;
    transition: all 0.3s ease;
    box-shadow: var(--md-sys-elevation-1);
}

.promote-container:active {
    transform: scale(0.95);
    box-shadow: var(--md-sys-elevation-2);
}

.promote-icon {
    margin-right: var(--spacing-xxs);
    animation: firePulse 2s infinite;
}

.promote-text {
    font-size: var(--md-sys-typescale-label-small);
    font-weight: bold;
    color: var(--md-sys-color-on-error-container);
}

@keyframes firePulse {
    0% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.1);
    }

    100% {
        transform: scale(1);
    }
}

/* Applications Section */
.applications-section {
    background: var(--md-sys-color-surface-container-low);
}

.applications-loading {
    padding: 60rpx;
    display: flex;
    justify-content: center;
}

.applications-list {
    padding: var(--spacing-xs) 0;
}

.application-item {
    background: var(--md-sys-color-surface-container-lowest);
    margin: 0 16rpx 16rpx;
    padding: 20rpx;
    border-radius: var(--md-sys-shape-corner-medium);
    box-shadow: var(--md-sys-elevation-1);
}

/* Applicant Header */
.applicant-header {
    display: flex;
    align-items: center;
    margin-bottom: var(--spacing-xs);
}

.avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    margin-right: var(--spacing-xs);
    flex-shrink: 0;
}

.applicant-info {
    flex: 1;
}

.applicant-name {
    font-size: var(--md-sys-typescale-body-large);
    font-weight: 500;
    color: var(--md-sys-color-on-surface);
    display: block;
    margin-bottom: var(--spacing-xxs);
}

.applicant-meta {
    font-size: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-outline);
}

.application-status {
    flex-shrink: 0;
}

/* Application Details */
.application-details {
    margin-bottom: var(--spacing-xs);
}

.detail-row {
    margin-bottom: 12rpx;
    display: flex;
    gap: var(--spacing-xxs);
}

.detail-row:last-child {
    margin-bottom: 0;
}

.detail-label {
    font-size: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface-variant);
    flex-shrink: 0;
}

.detail-value {
    font-size: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface);
    flex: 1;
    word-break: break-all;
}

.detail-value.reply {
    color: var(--md-sys-color-primary);
}

/* Action Buttons */
.application-actions {
    display: flex;
    gap: var(--spacing-xs);
    justify-content: flex-end;
    padding-top: var(--spacing-xs);
    border-top: 1rpx solid var(--md-sys-color-outline-variant);
}

/* Empty States */
.applications-empty {
    padding: 40rpx 0;
}

.empty-container {
    padding: 100rpx 0;
}

/* Load More */
.load-more,
.no-more {
    padding: var(--spacing-md);
    text-align: center;
}

.no-more text {
    font-size: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-outline);
}

/* Dialog Content */
.dialog-content {
    padding: var(--spacing-sm);
}

.dialog-hint {
    display: block;
    font-size: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-on-surface-variant);
    margin-bottom: 20rpx;
}
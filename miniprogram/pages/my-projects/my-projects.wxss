/* pages/my-projects/my-projects.wxss */
.my-projects-container {
    min-height: 100vh;
    background: var(--bg-color);
    padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* Loading */
.loading-container {
    padding: 100rpx 0;
    display: flex;
    justify-content: center;
}

/* Project List */
.project-list {
    height: 100vh;
    padding: 30rpx;
}

.project-card {
    background: var(--card-bg);
    border-radius: 24rpx;
    margin-bottom: 30rpx;
    overflow: hidden;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* Project Header */
.project-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 30rpx;
    border-bottom: 1rpx solid #f0f0f0;
    transition: background 0.2s;
}

.project-header:active {
    background: #f5f7fa;
}

.header-left {
    flex: 1;
    margin-right: 16rpx;
}

.project-name {
    font-size: 32rpx;
    font-weight: bold;
    color: var(--text-main);
    display: block;
    margin-bottom: 12rpx;
}

.project-meta {
    display: flex;
    gap: 16rpx;
}

.meta-item {
    font-size: 24rpx;
    color: var(--text-gray);
}

.header-right {
    display: flex;
    align-items: center;
    gap: 12rpx;
}

.delete-icon,
.edit-icon {
    padding: 8rpx;
    transition: transform 0.2s;
}

.delete-icon:active,
.edit-icon:active {
    transform: scale(0.9);
}

/* Promote Container */
.promote-container {
    display: flex;
    align-items: center;
    padding: 8rpx 16rpx;
    background: #fff0f0;
    border: 1rpx solid #ff4d4d;
    border-radius: 100rpx;
    margin-right: 10px;
    transition: all 0.3s ease;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.promote-container:active {
    transform: scale(0.95);
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.promote-icon {
    margin-right: 8rpx;
    animation: firePulse 2s infinite;
}

.promote-text {
    font-size: 20rpx;
    font-weight: bold;
    color: #ff4d4d;
}

@keyframes firePulse {
    0% {
        transform: scale(1);
    }

    50% {
        transform: scale(1.1);
    }

    100% {
        transform: scale(1);
    }
}

/* Applications Section */
.applications-section {
    background: var(--bg-color);
}

.applications-loading {
    padding: 60rpx;
    display: flex;
    justify-content: center;
}

.applications-list {
    padding: 16rpx 0;
}

.application-item {
    background: var(--card-bg);
    margin: 0 16rpx 16rpx;
    padding: 20rpx;
    border-radius: 24rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

/* Applicant Header */
.applicant-header {
    display: flex;
    align-items: center;
    margin-bottom: 16rpx;
}

.avatar {
    width: 80rpx;
    height: 80rpx;
    border-radius: 50%;
    margin-right: 16rpx;
    flex-shrink: 0;
}

.applicant-info {
    flex: 1;
}

.applicant-name {
    font-size: 32rpx;
    font-weight: 500;
    color: var(--text-main);
    display: block;
    margin-bottom: 8rpx;
}

.applicant-meta {
    font-size: 24rpx;
    color: var(--text-gray);
}

.application-status {
    flex-shrink: 0;
}

/* Application Details */
.application-details {
    margin-bottom: 16rpx;
}

.detail-row {
    margin-bottom: 12rpx;
    display: flex;
    gap: 8rpx;
}

.detail-row:last-child {
    margin-bottom: 0;
}

.detail-label {
    font-size: 28rpx;
    color: var(--text-gray);
    flex-shrink: 0;
}

.detail-value {
    font-size: 28rpx;
    color: var(--text-main);
    flex: 1;
    word-break: break-all;
}

.detail-value.reply {
    color: var(--primary-color);
}

/* Action Buttons */
.application-actions {
    display: flex;
    gap: 16rpx;
    justify-content: flex-end;
    padding-top: 16rpx;
    border-top: 1rpx solid #f0f0f0;
}

/* Empty States */
.applications-empty {
    padding: 40rpx 0;
}

.empty-container {
    padding: 100rpx 0;
}

/* Load More */
.load-more,
.no-more {
    padding: 40rpx;
    text-align: center;
}

.no-more text {
    font-size: 28rpx;
    color: var(--text-gray);
}

/* Dialog Content */
.dialog-content {
    padding: 30rpx;
}

.dialog-hint {
    display: block;
    font-size: 28rpx;
    color: var(--text-gray);
    margin-bottom: 20rpx;
}
/* pages/edit-profile/edit-profile.wxss */
.edit-profile-container {
    min-height: 100vh;
    background: var(--md-sys-color-background);
    padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 头像区域 */
.avatar-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--spacing-lg) 0;
    background: var(--md-sys-color-surface-container-lowest);
}

.avatar-wrapper {
    position: relative;
    width: 160rpx;
    height: 160rpx;
}

.avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--md-sys-color-surface-container-high);
}

.avatar-mask {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.avatar-edit-icon {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 48rpx;
    height: 48rpx;
    background: var(--md-sys-color-primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 4rpx solid var(--md-sys-color-surface-container-lowest);
    color: var(--md-sys-color-on-primary);
}

.avatar-hint {
    margin-top: 16rpx;
    font-size: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-outline);
}

/* 表单区域 */
.picker-value {
    color: var(--md-sys-color-on-surface);
}

/* 保存按钮 */
.save-section {
    padding: 48rpx var(--spacing-md);
}

.save-btn {
    width: 100%;
    height: 96rpx;
    line-height: 96rpx;
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    font-size: var(--md-sys-typescale-label-large);
    font-weight: 500;
    border-radius: 48rpx;
    border: none;
    box-shadow: var(--md-sys-elevation-2);
}

.save-btn[disabled] {
    background: var(--md-sys-color-on-surface);
    opacity: 0.12;
    color: var(--md-sys-color-on-surface);
}

.save-btn::after {
    border: none;
}

/* 选择器弹出层 */
.picker-popup {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--md-sys-color-surface);
}

.picker-header {
    padding: 32rpx;
    text-align: center;
    border-bottom: 1rpx solid var(--md-sys-color-outline-variant);
}

.picker-title {
    font-size: var(--md-sys-typescale-title-medium);
    font-weight: 500;
    color: var(--md-sys-color-on-surface);
}

.picker-search {
    padding: var(--spacing-xs);
    background: var(--md-sys-color-surface);
}

.picker-list {
    flex: 1;
    overflow-y: auto;
}

.picker-group-title {
    padding: 24rpx 32rpx 12rpx;
    font-size: var(--md-sys-typescale-label-medium);
    color: var(--md-sys-color-outline);
    background: var(--md-sys-color-surface-container);
}

.picker-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28rpx 32rpx;
    background: var(--md-sys-color-surface-container-lowest);
    border-bottom: 1rpx solid var(--md-sys-color-outline-variant);
}

.picker-item text {
    font-size: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface);
}

.picker-item:active {
    background: var(--md-sys-color-surface-container-high);
}

.picker-empty {
    padding: 80rpx 32rpx;
    text-align: center;
    color: var(--md-sys-color-outline);
    font-size: var(--md-sys-typescale-body-medium);
}
/* pages/edit-profile/edit-profile.wxss */

/* ===== 容器 ===== */
.edit-profile-container {
    min-height: 100vh;
    background: var(--bg-page-muted);
    padding: 0 44rpx calc(200rpx + env(safe-area-inset-bottom));
    box-sizing: border-box;
    position: relative;
    z-index: 1;
}

.edit-profile-container::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 800rpx;
    background: linear-gradient(180deg, #e8f9ff 0%, #f6fafd 13%, var(--bg-page-muted) 100%);
    z-index: -1;
}

/* ===== 头像 ===== */
.avatar-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 40rpx 0 24rpx;
}

.avatar-wrapper {
    position: relative;
    width: 180rpx;
    height: 180rpx;
    border-radius: 50%;
    overflow: hidden;
    background: #f0f0f0;
}

.avatar {
    width: 100%;
    height: 100%;
}

.avatar-mask {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.change-hint {
    margin-top: 16rpx;
    font-size: 24rpx;
    font-weight: bold;
    color: #acacac;
}

/* ===== 模块标题 ===== */
.section-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #000000;
    text-align: center;
    margin-bottom: 24rpx;
}

.edit-section {
    margin-bottom: 40rpx;
}

/* ===== 白色卡片 ===== */
.edit-card {
    padding: 10rpx 44rpx;
}

.edit-card.textarea-card {
    padding: 0;
    overflow: hidden;
}

/* ===== 表单行 ===== */
.form-item .form-value.disabled {
    color: #868686;
}

/* ===== MBTI 选择器 ===== */
.mbti-selector-container {
    padding: 24rpx 0;
}

.mbti-pills {
    display: flex;
    justify-content: flex-end;
    gap: 16rpx;
    margin-top: 10rpx;
}

.mbti-pill-group {
    display: flex;
    flex-direction: column;
    gap: 12rpx;
    background: #f7f8fa;
    border-radius: 40rpx;
    padding: 8rpx;
}

.mbti-pill {
    width: 100rpx;
    height: 100rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 40rpx;
    background: transparent;
    transition: background 0.2s;
}

.mbti-pill.active {
    background: var(--bg-pill-blue);
}

.mbti-pill .main {
    font-size: 28rpx;
    font-weight: bold;
    color: #000000;
}

.mbti-pill .sub {
    font-size: 22rpx;
    font-weight: bold;
    color: #000000;
}

.mbti-pill:not(.active) .main,
.mbti-pill:not(.active) .sub {
    opacity: 0.5;
}

/* ===== 文本域 ===== */
.edit-textarea {
    width: 100%;
    min-height: 200rpx;
    padding: 32rpx 44rpx;
    box-sizing: border-box;
    font-size: 28rpx;
    font-weight: bold;
    color: #000;
    line-height: 40rpx;
}

/* ===== 标签编辑 ===== */
.tag-edit-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24rpx 44rpx !important;
}

.tag-hint {
    font-size: 24rpx;
    font-weight: bold;
    color: #868686;
    line-height: 40rpx;
}

.add-tag-btn {
    width: 140rpx;
    flex-shrink: 0;
}

.current-tags {
    margin-top: 24rpx;
}

/* ===== 底部固定按钮 ===== */
.edit-footer {
    padding: 24rpx 54rpx calc(44rpx + env(safe-area-inset-bottom));
}

.cancel-btn {
    flex: 1;
}

.save-btn {
    flex: 2;
}

/* ===== Picker 弹出层 (保留原有) ===== */
.picker-popup {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #fff;
}

.picker-header {
    padding: 32rpx;
    text-align: center;
    border-bottom: 1rpx solid #f0f0f0;
}

.picker-title {
    font-size: 32rpx;
    font-weight: 500;
    color: #000;
}

.picker-search {
    padding: 16rpx;
}

.picker-list {
    flex: 1;
    overflow-y: auto;
}

.picker-loading {
    padding: 40rpx;
    text-align: center;
}

.picker-group-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24rpx 32rpx 12rpx;
    font-size: 24rpx;
    color: #999;
    background: #f5f7fa;
}

.picker-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28rpx 32rpx;
    background: #fff;
    border-bottom: 1rpx solid #f0f0f0;
}

.picker-item text {
    font-size: 32rpx;
    color: #000;
}

.picker-item-indent {
    padding-left: 64rpx;
}

.picker-item:active {
    background: #f0f0f0;
}

.picker-empty {
    padding: 80rpx 32rpx;
    text-align: center;
    color: #999;
    font-size: 28rpx;
}

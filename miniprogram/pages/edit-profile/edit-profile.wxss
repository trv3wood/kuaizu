/* pages/edit-profile/edit-profile.wxss */
.edit-profile-container {
    min-height: 100vh;
    background: var(--bg-color);
    padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 头像区域 */
.avatar-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: var(--spacing-lg) 0;
    background: var(--card-bg);
}

.avatar-wrapper {
    position: relative;
    width: 160rpx;
    height: 160rpx;
}

.avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #f0f0f0;
}

.avatar-mask {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.avatar-edit-icon {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 48rpx;
    height: 48rpx;
    background: var(--primary-color);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 4rpx solid var(--card-bg);
    color: #ffffff;
}

.avatar-hint {
    margin-top: 16rpx;
    font-size: 28rpx;
    color: var(--text-gray);
}

/* 表单区域 */
.picker-value {
    color: var(--text-main);
}

/* 保存按钮 */
.save-section {
    padding: 48rpx 40rpx;
}

.save-btn {
    width: 100%;
    height: 96rpx;
    line-height: 96rpx;
    background: var(--primary-color);
    color: #ffffff;
    font-size: 28rpx;
    font-weight: 500;
    border-radius: 48rpx;
    border: none;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.save-btn[disabled] {
    background: var(--text-main);
    opacity: 0.12;
    color: var(--text-main);
}

.save-btn::after {
    border: none;
}

/* 选择器弹出层 */
.picker-popup {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--card-bg);
}

.picker-header {
    padding: 32rpx;
    text-align: center;
    border-bottom: 1rpx solid #f0f0f0;
}

.picker-title {
    font-size: 32rpx;
    font-weight: 500;
    color: var(--text-main);
}

.picker-search {
    padding: 16rpx;
    background: var(--card-bg);
}

.picker-list {
    flex: 1;
    overflow-y: auto;
}

.picker-group-title {
    padding: 24rpx 32rpx 12rpx;
    font-size: 24rpx;
    color: var(--text-gray);
    background: #f5f7fa;
}

.picker-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28rpx 32rpx;
    background: var(--card-bg);
    border-bottom: 1rpx solid #f0f0f0;
}

.picker-item text {
    font-size: 32rpx;
    color: var(--text-main);
}

.picker-item:active {
    background: #f0f0f0;
}

.picker-empty {
    padding: 80rpx 32rpx;
    text-align: center;
    color: var(--text-gray);
    font-size: 28rpx;
}
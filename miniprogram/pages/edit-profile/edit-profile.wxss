/* pages/edit-profile/edit-profile.wxss */
.edit-profile-container {
    min-height: 100vh;
    background: #f5f6fa;
    padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 头像区域 */
.avatar-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 48rpx 0;
    background: #fff;
}

.avatar-wrapper {
    position: relative;
    width: 160rpx;
    height: 160rpx;
}

.avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #f0f0f0;
}

.avatar-mask {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
}

.avatar-edit-icon {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 48rpx;
    height: 48rpx;
    background: #667eea;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 4rpx solid #fff;
}

.avatar-hint {
    margin-top: 16rpx;
    font-size: 26rpx;
    color: #999;
}

/* 表单区域 */
.picker-value {
    color: #323233;
}

/* 保存按钮 */
.save-section {
    padding: 48rpx 32rpx;
}

.save-btn {
    width: 100%;
    height: 96rpx;
    line-height: 96rpx;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
    font-size: 32rpx;
    font-weight: 500;
    border-radius: 48rpx;
    border: none;
}

.save-btn[disabled] {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    opacity: 0.7;
}

.save-btn::after {
    border: none;
}

/* 选择器弹出层 */
.picker-popup {
    display: flex;
    flex-direction: column;
    height: 100%;
}

.picker-header {
    padding: 32rpx;
    text-align: center;
    border-bottom: 1rpx solid #eee;
}

.picker-title {
    font-size: 32rpx;
    font-weight: 500;
    color: #333;
}

.picker-search {
    padding: 16rpx;
    background: #fff;
}

.picker-list {
    flex: 1;
    overflow-y: auto;
}

.picker-group-title {
    padding: 24rpx 32rpx 12rpx;
    font-size: 26rpx;
    color: #999;
    background: #f5f6fa;
}

.picker-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 28rpx 32rpx;
    background: #fff;
    border-bottom: 1rpx solid #f5f5f5;
}

.picker-item text {
    font-size: 30rpx;
    color: #333;
}

.picker-item:active {
    background: #f5f6fa;
}

.picker-empty {
    padding: 80rpx 32rpx;
    text-align: center;
    color: #999;
    font-size: 28rpx;
}
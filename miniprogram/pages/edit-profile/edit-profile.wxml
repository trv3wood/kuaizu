<!-- pages/edit-profile/edit-profile.wxml -->
<view class="edit-profile-container">
    <!-- 头像区域 -->
    <view class="avatar-section" bindtap="handleChooseAvatar">
        <view class="avatar-wrapper">
            <image class="avatar" src="{{form.avatarUrl}}" mode="aspectFill" />
            <view class="avatar-mask" wx:if="{{uploading}}">
                <van-loading size="24px" color="#fff" />
            </view>
        </view>
        <text class="change-hint">点击更换头像</text>
    </view>

    <!-- 基本信息 -->
    <view class="edit-section">
        <view class="section-title">基本信息</view>
        <view class="edit-card ui-card ui-card--xl">
            <view class="form-item ui-form-row">
                <text class="label ui-form-label">昵称</text>
                <input class="form-value ui-form-value" value="{{form.nickname}}" data-field="nickname" bindinput="handleNativeInput" />
            </view>
            <view class="form-item ui-form-row">
                <text class="label ui-form-label">手机号</text>
                <input class="form-value ui-form-value ui-form-value--muted disabled" value="{{form.phone}}" disabled />
            </view>
            <view class="form-item ui-form-row">
                <text class="label ui-form-label">邮箱</text>
                <input class="form-value ui-form-value" value="{{form.email}}" data-field="email" bindinput="handleNativeInput" placeholder="请输入邮箱" />
            </view>
            <view class="form-item ui-form-row">
                <text class="label ui-form-label">微信号</text>
                <input class="form-value ui-form-value" value="{{form.wechat}}" data-field="wechat" bindinput="handleNativeInput" placeholder="请输入微信号" />
            </view>
            <!-- MBTI 选择器 -->
            <view class="mbti-selector-container">
                <text class="label ui-form-label">MBTI</text>
                <view class="mbti-pills">
                    <!-- E/I -->
                    <view class="mbti-pill-group">
                        <view class="mbti-pill {{mbtiArray[0] === 'E' ? 'active' : ''}}" bindtap="toggleMbti" data-idx="0" data-val="E">
                            <text class="main">E</text>
                            <text class="sub">（外向）</text>
                        </view>
                        <view class="mbti-pill {{mbtiArray[0] === 'I' ? 'active' : ''}}" bindtap="toggleMbti" data-idx="0" data-val="I">
                            <text class="main">I</text>
                            <text class="sub">（内向）</text>
                        </view>
                    </view>
                    <!-- S/N -->
                    <view class="mbti-pill-group">
                        <view class="mbti-pill {{mbtiArray[1] === 'S' ? 'active' : ''}}" bindtap="toggleMbti" data-idx="1" data-val="S">
                            <text class="main">S</text>
                            <text class="sub">（实感）</text>
                        </view>
                        <view class="mbti-pill {{mbtiArray[1] === 'N' ? 'active' : ''}}" bindtap="toggleMbti" data-idx="1" data-val="N">
                            <text class="main">N</text>
                            <text class="sub">（直觉）</text>
                        </view>
                    </view>
                    <!-- T/F -->
                    <view class="mbti-pill-group">
                        <view class="mbti-pill {{mbtiArray[2] === 'T' ? 'active' : ''}}" bindtap="toggleMbti" data-idx="2" data-val="T">
                            <text class="main">T</text>
                            <text class="sub">（思考）</text>
                        </view>
                        <view class="mbti-pill {{mbtiArray[2] === 'F' ? 'active' : ''}}" bindtap="toggleMbti" data-idx="2" data-val="F">
                            <text class="main">F</text>
                            <text class="sub">（情感）</text>
                        </view>
                    </view>
                    <!-- J/P -->
                    <view class="mbti-pill-group">
                        <view class="mbti-pill {{mbtiArray[3] === 'J' ? 'active' : ''}}" bindtap="toggleMbti" data-idx="3" data-val="J">
                            <text class="main">J</text>
                            <text class="sub">（判断）</text>
                        </view>
                        <view class="mbti-pill {{mbtiArray[3] === 'P' ? 'active' : ''}}" bindtap="toggleMbti" data-idx="3" data-val="P">
                            <text class="main">P</text>
                            <text class="sub">（知觉）</text>
                        </view>
                    </view>
                </view>
            </view>
        </view>
    </view>

    <!-- 学业信息 -->
    <view class="edit-section">
        <view class="section-title">学业信息</view>
        <view class="edit-card ui-card ui-card--xl">
            <view class="form-item arrow ui-form-row ui-form-row--arrow" bindtap="handleShowSchoolPicker">
                <text class="label ui-form-label">学校</text>
                <text class="form-value ui-form-value">{{selectedSchoolName || '请选择'}}</text>
                <van-icon name="arrow" color="#868686" />
            </view>
            <view class="form-item arrow ui-form-row ui-form-row--arrow" bindtap="showMajorPicker">
                <text class="label ui-form-label">专业</text>
                <text class="form-value ui-form-value">{{majorName || '请选择'}}</text>
                <van-icon name="arrow" color="#868686" />
            </view>
            <view class="form-item arrow ui-form-row ui-form-row--arrow">
                <text class="label ui-form-label">入学年份</text>
                <picker mode="selector" range="{{gradeOptions}}" value="{{gradeIndex}}" bindchange="handleGradeChange">
                    <text class="form-value ui-form-value">{{gradeIndex >= 0 ? gradeOptions[gradeIndex] : '请选择'}}</text>
                </picker>
                <van-icon name="arrow" color="#868686" />
            </view>
            <view class="form-item arrow ui-form-row ui-form-row--arrow" bindtap="goToCert">
                <text class="label ui-form-label">认证状态</text>
                <text class="form-value ui-form-value">{{isVerified ? '已认证' : '未认证'}}</text>
                <van-icon name="arrow" color="#868686" />
            </view>
        </view>
    </view>

    <!-- 自我评价 -->
    <view class="edit-section">
        <view class="section-title">自我评价</view>
        <view class="edit-card textarea-card ui-card ui-card--xl">
            <textarea class="edit-textarea" placeholder="描述你的优势和特点..." value="{{talentForm.selfEvaluation}}" data-field="selfEvaluation" bindinput="handleTalentInput" maxlength="500"></textarea>
        </view>
    </view>

    <!-- 项目经历 -->
    <view class="edit-section">
        <view class="section-title">项目经历</view>
        <view class="edit-card textarea-card ui-card ui-card--xl">
            <textarea class="edit-textarea" placeholder="介绍你参与过的项目..." value="{{talentForm.projectExperience}}" data-field="projectExperience" bindinput="handleTalentInput" maxlength="1000"></textarea>
        </view>
    </view>

    <!-- 标签 -->
    <view class="edit-section">
        <view class="section-title">标签</view>
        <view class="edit-card tag-edit-box ui-card ui-card--xl">
            <view class="tag-hint">
                <view>根据以上内容提取一些鲜明标签，</view>
                <view>让更多优秀的团队快速锁定您。</view>
            </view>
            <view class="add-tag-btn ui-btn ui-btn--lg ui-btn--pill ui-btn--primary" bindtap="handleAddSkill">添加</view>
        </view>
        <view class="current-tags ui-tag-list" wx:if="{{talentForm.skills.length > 0}}">
            <view class="tag-item ui-tag ui-tag--blue ui-tag--pill" wx:for="{{talentForm.skills}}" wx:key="*this">
                <text>{{item}}</text>
                <van-icon name="cross" size="12px" data-index="{{index}}" bindtap="handleRemoveSkill" />
            </view>
        </view>
    </view>
</view>

<!-- 底部固定按钮 -->
<view class="edit-footer ui-bottom-bar ui-bottom-bar--solid ui-bottom-bar__row">
    <view class="cancel-btn ui-btn ui-btn--lg ui-btn--pill ui-btn--secondary" bindtap="handleCancel">取消</view>
    <view class="save-btn ui-btn ui-btn--lg ui-btn--pill ui-btn--primary {{loading ? 'disabled' : ''}}" bindtap="handleSave">保存</view>
</view>

<!-- 学校选择弹出层 -->
<van-popup show="{{showSchoolPicker}}" position="bottom" round closeable bind:close="handleCloseSchoolPicker" custom-style="height: 70vh;">
    <view class="picker-popup">
        <view class="picker-header">
            <text class="picker-title">选择学校</text>
        </view>
        <view class="picker-search">
            <van-search value="{{schoolSearchKeyword}}" placeholder="搜索学校" bind:change="handleSchoolSearch" />
        </view>
        <scroll-view class="picker-list" scroll-y>
            <view class="picker-item" wx:for="{{schools}}" wx:key="id" data-school="{{item}}" bindtap="handleSelectSchool">
                <text>{{item.schoolName}}</text>
                <van-icon wx:if="{{item.id === form.schoolId}}" name="success" color="#3e84fa" />
            </view>
            <view class="picker-empty" wx:if="{{schools.length === 0}}">
                <text>暂无匹配的学校</text>
            </view>
        </scroll-view>
    </view>
</van-popup>

<!-- 专业选择弹出层 -->
<van-popup show="{{showMajorPicker}}" position="bottom" round closeable bind:close="closeMajorPicker" custom-style="height: 70vh;">
    <view class="picker-popup">
        <view class="picker-header">
            <text class="picker-title">选择专业</text>
        </view>
        <view class="picker-search">
            <van-search value="{{majorSearchKeyword}}" placeholder="搜索专业" bind:change="handleMajorSearch" />
        </view>
        <scroll-view class="picker-list" scroll-y>
            <view class="picker-loading" wx:if="{{majorLoading}}">
                <van-loading size="20px">加载中...</van-loading>
            </view>
            <block wx:elif="{{majorClasses.length > 0}}">
                <block wx:for="{{majorClasses}}" wx:key="id" wx:for-item="mc">
                    <view class="picker-group-title" data-class-id="{{mc.id}}" bindtap="handleExpandClass">
                        <text>{{mc.className}}</text>
                        <van-icon name="{{expandedClassId === mc.id ? 'arrow-up' : 'arrow-down'}}" size="14px" color="#999" />
                    </view>
                    <block wx:if="{{expandedClassId === mc.id}}">
                        <view class="picker-item picker-item-indent" wx:for="{{mc.majors}}" wx:key="id" data-major="{{item}}" data-major-class="{{mc}}" bindtap="handleSelectMajor">
                            <text>{{item.majorName}}</text>
                            <van-icon wx:if="{{item.id === form.majorId}}" name="success" color="#3e84fa" />
                        </view>
                    </block>
                </block>
            </block>
            <view class="picker-empty" wx:else>
                <text>暂无专业数据</text>
            </view>
        </scroll-view>
    </view>
</van-popup>

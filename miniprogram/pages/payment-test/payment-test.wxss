/* pages/payment-test/payment-test.wxss */
.payment-test-container {
    min-height: 100vh;
    background: var(--color-bg-base);
    padding-bottom: 200rpx;
}

/* 标题区域 */
.section-title {
    padding: 48rpx 32rpx 32rpx;
    text-align: center;
}

.title {
    display: block;
    font-size: 40rpx;
    font-weight: 700;
    color: var(--color-text-main);
    margin-bottom: 12rpx;
}

.subtitle {
    font-size: 28rpx;
    color: var(--color-text-tertiary);
}

/* 加载中 */
.loading-container {
    display: flex;
    justify-content: center;
    padding: 80rpx 0;
}

/* 商品列表 */
.product-list {
    padding: 0 var(--spacing-sm);
}

.product-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--color-bg-card);
    border-radius: var(--radius-lg);
    padding: var(--spacing-md);
    margin-bottom: 20rpx;
    box-shadow: var(--shadow-sm);
    border: 4rpx solid transparent;
    transition: all 0.3s ease;
}

.product-card.selected {
    border-color: var(--color-primary);
    background: linear-gradient(135deg, rgba(79, 70, 229, 0.05) 0%, rgba(55, 48, 163, 0.05) 100%);
}

.product-info {
    flex: 1;
}

.product-name {
    display: block;
    font-size: 32rpx;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: 8rpx;
}

.product-desc {
    font-size: 26rpx;
    color: var(--color-text-tertiary);
}

.product-price {
    display: flex;
    align-items: center;
    gap: 16rpx;
}

.price {
    font-size: 36rpx;
    font-weight: 700;
    color: var(--color-primary);
}

/* 订单信息 */
.order-info {
    margin: var(--spacing-md) var(--spacing-sm);
    background: var(--color-bg-card);
    border-radius: var(--radius-lg);
    padding: var(--spacing-md);
    box-shadow: var(--shadow-sm);
}

.info-title {
    font-size: 30rpx;
    font-weight: 600;
    color: var(--color-text-main);
    margin-bottom: 20rpx;
    padding-bottom: 16rpx;
    border-bottom: 1rpx solid var(--color-divider);
}

.info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12rpx 0;
}

.label {
    font-size: 28rpx;
    color: var(--color-text-tertiary);
}

.value {
    font-size: 28rpx;
    color: var(--color-text-main);
}

.value.price {
    font-weight: 600;
    color: var(--color-danger);
}

/* 支付区域 */
.pay-section {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--color-bg-card);
    padding: var(--spacing-md);
    box-shadow: var(--shadow-float);
}

.selected-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
}

.selected-name {
    font-size: 30rpx;
    font-weight: 500;
    color: var(--color-text-main);
}

.selected-price {
    font-size: 36rpx;
    font-weight: 700;
    color: var(--color-danger);
}

.no-selection {
    text-align: center;
    margin-bottom: 20rpx;
}

.no-selection text {
    font-size: 28rpx;
    color: var(--color-text-tertiary);
}

/* 空状态 */
.empty-container {
    padding: 80rpx 0;
}
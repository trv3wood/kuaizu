/* pages/payment-test/payment-test.wxss */
.payment-test-container {
    min-height: 100vh;
    background: var(--bg-color);
    padding-bottom: 200rpx;
}

/* 标题区域 */
.section-title {
    padding: 48rpx 32rpx 32rpx;
    text-align: center;
}

.title {
    display: block;
    font-size: 36rpx;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 12rpx;
}

.subtitle {
    font-size: 28rpx;
    color: var(--text-gray);
}

/* 加载中 */
.loading-container {
    display: flex;
    justify-content: center;
    padding: 80rpx 0;
}

/* 商品列表 */
.product-list {
    padding: 0 30rpx;
}

.product-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--card-bg);
    border-radius: 32rpx;
    padding: 40rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
    border: 4rpx solid transparent;
    transition: all 0.3s ease;
}

.product-card.selected {
    border-color: var(--primary-color);
    background: #f5f7fa;
}

.product-info {
    flex: 1;
}

.product-name {
    display: block;
    font-size: 32rpx;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 8rpx;
}

.product-desc {
    font-size: 24rpx;
    color: var(--text-gray);
}

.product-price {
    display: flex;
    align-items: center;
    gap: 16rpx;
}

.price {
    font-size: 36rpx;
    font-weight: 700;
    color: var(--primary-color);
}

/* 订单信息 */
.order-info {
    margin: 40rpx 30rpx;
    background: var(--card-bg);
    border-radius: 32rpx;
    padding: 40rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.info-title {
    font-size: 32rpx;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 20rpx;
    padding-bottom: 16rpx;
    border-bottom: 1rpx solid #f0f0f0;
}

.info-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12rpx 0;
}

.label {
    font-size: 28rpx;
    color: var(--text-gray);
}

.value {
    font-size: 28rpx;
    color: var(--text-main);
}

.value.price {
    font-weight: 600;
    color: #ff4d4d;
}

/* 支付区域 */
.pay-section {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: var(--card-bg);
    padding: 40rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.selected-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20rpx;
}

.selected-name {
    font-size: 32rpx;
    font-weight: 500;
    color: var(--text-main);
}

.selected-price {
    font-size: 36rpx;
    font-weight: 700;
    color: #ff4d4d;
}

.no-selection {
    text-align: center;
    margin-bottom: 20rpx;
}

.no-selection text {
    font-size: 28rpx;
    color: var(--text-gray);
}

/* 空状态 */
.empty-container {
    padding: 80rpx 0;
}
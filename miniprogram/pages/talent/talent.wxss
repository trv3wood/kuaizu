/* pages/talent/talent.wxss */

.talent-list {
  padding: 0 17px;
}

.talent-card {
  background: var(--card-bg);
  border-radius: 20px;
  padding: 16px;
  margin-bottom: 18px;
  box-shadow: 4rpx 4rpx 12rpx rgba(0, 0, 0, 0.14);
}

.talent-card:active {
  transform: scale(0.985);
}

.card-main {
  display: flex;
  align-items: flex-start;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 14px;
  background: #ececec;
}

.card-top-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.name-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #111111;
}

.mbti {
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.school {
  display: block;
  font-size: 24rpx;
  line-height: 1.4;
  color: #777777;
  margin-bottom: 8rpx;
}

.major {
  display: block;
  font-size: 24rpx;
  line-height: 1.4;
  color: #111111;
  margin-bottom: 12rpx;
}

.skills {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 10rpx;
}

.page-footer {
  padding: 40rpx 0 60rpx;
  gap: 8rpx;
}

.picker-loading {
  padding: 120rpx 0;
  display: flex;
  justify-content: center;
}

.picker-group-title {
  background: var(--card-bg);
  border-radius: var(--radius-md);
  padding: 24rpx 24rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 600;
  color: #111111;
}

.picker-item-indent {
  margin-left: 20rpx;
}

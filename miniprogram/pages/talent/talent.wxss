/* pages/talent/talent.wxss */
.talent-container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.hero-header {
  background: #cff4ff;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.12);
  padding: 0 20rpx 26rpx;
}

.hero-nav {
  position: relative;
}

.hero-nav-row {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.nav-action {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back-hidden {
  opacity: 0;
  pointer-events: none;
}

.hero-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 32rpx;
  line-height: 1;
  font-weight: 800;
  color: #101010;
}

.nav-capsule-placeholder {
  width: 176rpx;
  height: 64rpx;
  border-radius: 999rpx;
  opacity: 0;
}

.search-shell {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 6rpx;
}

.search-box {
  flex: 1;
  height: 64rpx;
  background: #ffffff;
  border-radius: 999rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  box-shadow: inset 0 0 0 1rpx rgba(0, 0, 0, 0.08);
}

.search-input {
  flex: 1;
  height: 64rpx;
  margin-left: 14rpx;
  font-size: 26rpx;
  color: #101010;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-trigger {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.content-area {
  padding-top: 26rpx;
}

.loading-container,
.empty-container {
  padding: 140rpx 0;
  display: flex;
  justify-content: center;
}

.talent-list {
  padding: 0 17px;
}

.talent-card {
  background: #ffffff;
  border-radius: 20px;
  padding: 16px;
  margin-bottom: 18px;
  box-shadow: 4rpx 4rpx 12rpx rgba(0, 0, 0, 0.14);
}

.talent-card:active {
  transform: scale(0.985);
}

.card-main {
  display: flex;
  align-items: flex-start;
}

.avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 14px;
  background: #ececec;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-body {
  flex: 1;
  min-width: 0;
}

.card-top-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 4rpx;
}

.name-wrap {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-width: 0;
}

.name {
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #111111;
}

.mbti {
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.school {
  display: block;
  font-size: 24rpx;
  line-height: 1.4;
  color: #777777;
  margin-bottom: 8rpx;
}

.major {
  display: block;
  font-size: 24rpx;
  line-height: 1.4;
  color: #111111;
  margin-bottom: 12rpx;
}

.skills {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 10rpx;
}

.skill-chip {
  min-height: 36rpx;
  padding: 0 10rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.skill-chip text {
  font-size: 20rpx;
  line-height: 24rpx;
  color: #252525;
}

.load-more {
  padding: 28rpx 0 16rpx;
  text-align: center;
}

.page-footer {
  padding: 40rpx 0 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.footer-symbol {
  font-size: 56rpx;
  line-height: 1;
  color: #58a7ff;
}

.footer-line {
  font-size: 28rpx;
  line-height: 1.5;
  color: #111111;
  font-weight: 500;
}

.edit-card-fab {
  position: fixed;
  right: 34rpx;
  bottom: calc(170rpx + env(safe-area-inset-bottom));
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #67adff 0%, #4c95f6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 28rpx rgba(76, 149, 246, 0.34);
  z-index: 10;
}

.edit-card-fab:active {
  transform: scale(0.96);
}

.edit-card-fab::after {
  border: none;
}

.filter-panel {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.filter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 88rpx 18px 20rpx;
  border-bottom: 1rpx solid #e8edf2;
}

.filter-title {
  font-size: 56rpx;
  font-weight: 800;
  color: #111111;
}

.filter-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-content {
  flex: 1;
  overflow-y: auto;
  padding: 34rpx 17px 32rpx;
}

.filter-section {
  margin-bottom: 52rpx;
}

.section-title {
  display: block;
  font-size: 30rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: #111111;
  margin-bottom: 28rpx;
}

.picker-value {
  min-height: 82rpx;
  background: #f5f7fa;
  border-radius: 41rpx;
  padding: 0 28rpx 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  font-weight: 500;
  color: #111111;
}

.filter-actions {
  display: flex;
  gap: 12px;
  padding: 18rpx 9px calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e8edf2;
  background: #ffffff;
}

.reset-btn,
.apply-btn {
  flex: 1;
  height: 45px;
  border-radius: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
}

.reset-btn {
  background: #f0f0f0;
  color: #111111;
}

.apply-btn {
  background: linear-gradient(90deg, #5fa6ff 0%, #4f92f2 100%);
  color: #ffffff;
}

.reset-btn::after,
.apply-btn::after {
  border: none;
}

.picker-popup {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #f5f7fa;
}

.picker-header {
  padding: 36rpx 32rpx 20rpx;
  text-align: center;
}

.picker-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #111111;
}

.picker-search {
  padding: 0 24rpx 16rpx;
}

.picker-list {
  flex: 1;
  padding: 0 24rpx 24rpx;
}

.picker-item {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #111111;
}

.picker-empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #97a0aa;
}

.picker-loading {
  padding: 120rpx 0;
  display: flex;
  justify-content: center;
}

.picker-group-title {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx 24rpx;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: 600;
  color: #111111;
}

.picker-item-indent {
  margin-left: 20rpx;
}

<!-- pages/talent/talent.wxml -->
<view class="talent-container">
  <view class="hero-header">
    <view class="hero-nav" style="padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + navBarHeight}}px;">
      <view class="hero-nav-row">
        <view class="nav-action {{showBackButton ? '' : 'nav-back-hidden'}}" bindtap="handleBack">
          <van-icon name="arrow-left" size="18px" color="#101010" />
        </view>
        <text class="hero-title">校园人才</text>
        <view class="nav-capsule-placeholder"></view>
      </view>
    </view>

    <view class="search-shell">
      <view class="search-box">
        <van-icon name="search" size="16px" color="#a8a8a8" />
        <input class="search-input" value="{{keyword}}" placeholder="搜索人才" confirm-type="search" bindinput="handleKeywordInput" bindconfirm="handleSearch" />
        <view class="search-clear" wx:if="{{keyword}}" bindtap="handleSearchCancel">
          <van-icon name="cross" size="14px" color="#b8b8b8" />
        </view>
      </view>
      <view class="filter-trigger" bindtap="showFilter">
        <van-icon name="filter-o" size="22px" color="#55606f" />
      </view>
    </view>
  </view>

  <view class="content-area">
    <view class="loading-container" wx:if="{{listLoading}}">
      <van-loading size="24px" color="#5bb4ff">加载中...</van-loading>
    </view>

    <block wx:elif="{{talents.length > 0}}">
      <view class="talent-list">
        <view class="talent-card" wx:for="{{talents}}" wx:key="id" data-id="{{item.id}}" bindtap="handleTalentTap">
          <view class="card-main">
            <image wx:if="{{item.avatarUrl}}" class="avatar" src="{{item.avatarUrl}}" mode="aspectFill" />
            <view wx:else class="avatar avatar-placeholder">
              <van-icon name="contact" size="28px" color="#b7bcc5" />
            </view>
            <view class="card-body">
              <view class="card-top-row">
                <view class="name-wrap">
                  <text class="name">{{item.nickname || '匿名用户'}}</text>
                </view>
                <text class="mbti" wx:if="{{item.mbti}}" style="color: {{item.mbtiColor}};">{{item.mbti}}</text>
              </view>

              <text class="school">{{item.schoolLabel}}</text>
              <text class="major">专业：{{item.majorLabel}}</text>

              <view class="skills" wx:if="{{item.displaySkills.length > 0}}">
                <view class="skill-chip" wx:for="{{item.displaySkills}}" wx:key="*this">
                  <text>{{item}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="load-more" wx:if="{{listLoadingMore}}">
        <van-loading size="20px" color="#5bb4ff">加载中...</van-loading>
      </view>

      <view class="page-footer" wx:elif="{{!listHasMore}}">
        <text class="footer-symbol">∞</text>
        <text class="footer-line">无限可能</text>
        <text class="footer-line">待你上线</text>
      </view>
    </block>

    <view class="empty-container" wx:else>
      <van-empty description="暂无人才" />
    </view>
  </view>

  <button class="edit-card-fab" bindtap="handleEditCard">
    <van-icon name="idcard-o" size="26px" color="#ffffff" />
  </button>

  <van-popup show="{{showFilterPopup}}" position="right" custom-style="width: 312px; max-width: 83%; height: 100%;" bind:close="closeFilter">
    <view class="filter-panel">
      <view class="filter-header">
        <text class="filter-title">筛选</text>
        <view class="filter-close" bindtap="closeFilter">
          <van-icon name="cross" size="22px" color="#101010" />
        </view>
      </view>
      <view class="filter-content">
        <view class="filter-section">
          <text class="section-title">学校</text>
          <view class="picker-value" bindtap="handleShowSchoolFilter">
            <text>{{selectedSchoolName || '全部学校'}}</text>
            <van-icon name="arrow" size="14px" color="#7d8a98" />
          </view>
        </view>

        <view class="filter-section">
          <text class="section-title">专业</text>
          <view class="picker-value" bindtap="handleShowMajorFilter">
            <text>{{selectedMajorName || '全部专业'}}</text>
            <van-icon name="arrow" size="14px" color="#7d8a98" />
          </view>
        </view>
      </view>
      <view class="filter-actions">
        <button class="reset-btn" bindtap="resetFilter">重置</button>
        <button class="apply-btn" bindtap="filteredSearch">确定</button>
      </view>
    </view>
  </van-popup>
  <!-- 学校搜索弹出层 -->
  <van-popup show="{{showSchoolPicker}}" position="bottom" round closeable bind:close="closeSchoolPicker" custom-style="height: 70vh;">
    <view class="picker-popup">
      <view class="picker-header">
        <text class="picker-title">选择学校</text>
      </view>
      <view class="picker-search">
        <van-search value="{{schoolSearchKeyword}}" placeholder="搜索学校" bind:change="handleSchoolSearch" />
      </view>
      <scroll-view class="picker-list" scroll-y>
        <view class="picker-item" wx:for="{{schools}}" wx:key="id" data-school="{{item}}" bindtap="handleSelectSchoolFilter">
          <text>{{item.schoolName}}</text>
          <van-icon wx:if="{{item.id === filters.schoolId}}" name="success" color="#5bb4ff" />
        </view>
        <view class="picker-empty" wx:if="{{schools.length === 0}}">
          <text>暂无匹配的学校</text>
        </view>
      </scroll-view>
    </view>
  </van-popup>
  <!-- 专业搜索弹出层 -->
  <van-popup show="{{showMajorPicker}}" position="bottom" round closeable bind:close="closeMajorPicker" custom-style="height: 70vh;">
    <view class="picker-popup">
      <view class="picker-header">
        <text class="picker-title">选择专业</text>
      </view>
      <view class="picker-search">
        <van-search value="{{majorSearchKeyword}}" placeholder="搜索专业" bind:change="handleMajorSearch" />
      </view>
      <scroll-view class="picker-list" scroll-y>
        <view class="picker-loading" wx:if="{{majorLoading}}">
          <van-loading size="20px">加载中...</van-loading>
        </view>
        <block wx:elif="{{majorClasses.length > 0}}">
          <block wx:for="{{majorClasses}}" wx:key="id" wx:for-item="mc">
            <!-- 大类标题 -->
            <view class="picker-group-title" data-class-id="{{mc.id}}" bindtap="handleExpandClass">
              <text>{{mc.className}}</text>
              <van-icon name="{{expandedClassId === mc.id ? 'arrow-up' : 'arrow-down'}}" size="14px" color="#999" />
            </view>
            <!-- 专业列表 -->
            <block wx:if="{{expandedClassId === mc.id}}">
              <view class="picker-item picker-item-indent" wx:for="{{mc.majors}}" wx:key="id" data-major="{{item}}" data-major-class="{{mc}}" bindtap="handleSelectMajor">
                <text>{{item.majorName}}</text>
                <van-icon wx:if="{{item.id === filters.majorId}}" name="success" color="#5bb4ff" />
              </view>
            </block>
          </block>
        </block>
        <view class="picker-empty" wx:else>
          <text>暂无专业数据</text>
        </view>
      </scroll-view>
    </view>
  </van-popup>
</view>

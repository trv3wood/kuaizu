/* pages/login/login.wxss */
.login-container {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, var(--bg-color) 0%, #f5f7fa 100%);
    padding: 0 var(--spacing-xl);
    box-sizing: border-box;
}

/* 顶部区域 */
.login-header {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 120rpx;
}

.logo-wrapper {
    margin-bottom: var(--spacing-lg);
}

.logo-circle {
    width: 180rpx;
    height: 180rpx;
    background: #e8f4ff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 12rpx 36rpx rgba(0, 0, 0, 0.12);
}

.logo-text {
    font-size: 48rpx;
    font-weight: bold;
    color: var(--primary-color);
}

.app-name {
    font-size: 40rpx;
    font-weight: bold;
    color: var(--text-main);
    margin-bottom: 16rpx;
}

.app-slogan {
    font-size: 32rpx;
    color: var(--text-gray);
}

/* 中间内容区 */
.login-content {
    padding: 60rpx 0;
}

.feature-list {
    display: flex;
    flex-direction: column;
    gap: 40rpx;
}

.feature-item {
    display: flex;
    align-items: center;
    gap: 20rpx;
    padding: 30rpx 40rpx;
    background: var(--card-bg);
    border-radius: 24rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.feature-text {
    font-size: 32rpx;
    color: var(--text-main);
}

/* 底部登录区 */
.login-footer {
    padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.login-btn {
    width: 100%;
    height: 96rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16rpx;
    border-radius: 48rpx;
    font-size: 28rpx;
    font-weight: 500;
    border: none;
}

.wechat-btn {
    background: #07c160;
    /* WeChat Green standard, keeping specific brand color */
    color: #ffffff;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.wechat-btn[disabled] {
    background: #07c160;
    opacity: 0.7;
}

.btn-text {
    color: #ffffff;
}

.skip-link {
    text-align: center;
    padding: 32rpx 0;
}

.skip-link text {
    font-size: 28rpx;
    color: var(--text-gray);
}

.agreement {
    text-align: center;
}

.agreement-text {
    font-size: 24rpx;
    color: var(--text-gray);
    line-height: 1.6;
}

.agreement .link {
    color: var(--color-primary);
}

/* 手机号绑定弹窗样式 */
.phone-modal {
    width: 600rpx;
    padding: 60rpx 40rpx;
    box-sizing: border-box;
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40rpx;
}

.modal-title {
    font-size: 36rpx;
    font-weight: bold;
    color: var(--color-text-main);
}

.modal-content {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.modal-desc {
    font-size: 28rpx;
    color: var(--color-text-secondary);
    text-align: center;
    margin-bottom: 60rpx;
    line-height: 1.5;
}

.phone-btn {
    width: 100%;
    height: 96rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16rpx;
    border-radius: 48rpx;
    font-size: 32rpx;
    font-weight: 500;
    border: none;
    background: var(--color-primary);
    color: var(--color-text-inverse);
    box-shadow: var(--shadow-lg);
    margin-bottom: 40rpx;
}

.phone-btn[disabled] {
    background: var(--color-primary);
    opacity: 0.7;
}

.modal-tip {
    font-size: 24rpx;
    color: var(--color-text-tertiary);
    text-align: center;
}
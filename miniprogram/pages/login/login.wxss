/* pages/login/login.wxss */
.login-container {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, var(--color-bg-base) 0%, var(--color-bg-card) 100%);
    padding: 0 var(--spacing-xl);
    box-sizing: border-box;
}

/* 顶部区域 */
.login-header {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 120rpx;
}

.logo-wrapper {
    margin-bottom: var(--spacing-lg);
}

.logo-circle {
    width: 180rpx;
    height: 180rpx;
    background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary-dark) 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-float);
}

.logo-text {
    font-size: 48rpx;
    font-weight: bold;
    color: var(--color-text-inverse);
}

.app-name {
    font-size: 48rpx;
    font-weight: bold;
    color: var(--color-text-main);
    margin-bottom: var(--spacing-xs);
}

.app-slogan {
    font-size: 28rpx;
    color: var(--color-text-tertiary);
}

/* 中间内容区 */
.login-content {
    padding: 60rpx 0;
}

.feature-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
}

.feature-item {
    display: flex;
    align-items: center;
    gap: 20rpx;
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--color-bg-card);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
}

.feature-text {
    font-size: 30rpx;
    color: var(--color-text-main);
}

/* 底部登录区 */
.login-footer {
    padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.login-btn {
    width: 100%;
    height: 96rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xs);
    border-radius: 48rpx;
    font-size: 32rpx;
    font-weight: 500;
    border: none;
}

.wechat-btn {
    background: var(--color-success);
    color: var(--color-text-inverse);
    box-shadow: var(--shadow-lg);
}

.wechat-btn[disabled] {
    background: var(--color-success);
    opacity: 0.7;
}

.btn-text {
    color: var(--color-text-inverse);
}

.skip-link {
    text-align: center;
    padding: 32rpx 0;
}

.skip-link text {
    font-size: 28rpx;
    color: var(--color-text-tertiary);
}

.agreement {
    text-align: center;
}

.agreement-text {
    font-size: 24rpx;
    color: var(--color-text-tertiary);
    line-height: 1.6;
}

.agreement .link {
    color: var(--color-primary);
}
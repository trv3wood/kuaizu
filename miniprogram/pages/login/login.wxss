/* pages/login/login.wxss */
.login-container {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, #f8f9fe 0%, #ffffff 100%);
    padding: 0 60rpx;
    box-sizing: border-box;
}

/* 顶部区域 */
.login-header {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 120rpx;
}

.logo-wrapper {
    margin-bottom: 40rpx;
}

.logo-circle {
    width: 180rpx;
    height: 180rpx;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 20rpx 60rpx rgba(102, 126, 234, 0.3);
}

.logo-text {
    font-size: 48rpx;
    font-weight: bold;
    color: #fff;
}

.app-name {
    font-size: 48rpx;
    font-weight: bold;
    color: #333;
    margin-bottom: 16rpx;
}

.app-slogan {
    font-size: 28rpx;
    color: #999;
}

/* 中间内容区 */
.login-content {
    padding: 60rpx 0;
}

.feature-list {
    display: flex;
    flex-direction: column;
    gap: 32rpx;
}

.feature-item {
    display: flex;
    align-items: center;
    gap: 20rpx;
    padding: 24rpx 32rpx;
    background: #fff;
    border-radius: 16rpx;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.feature-text {
    font-size: 30rpx;
    color: #333;
}

/* 底部登录区 */
.login-footer {
    padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.login-btn {
    width: 100%;
    height: 96rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16rpx;
    border-radius: 48rpx;
    font-size: 32rpx;
    font-weight: 500;
    border: none;
}

.wechat-btn {
    background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
    color: #fff;
    box-shadow: 0 8rpx 30rpx rgba(7, 193, 96, 0.3);
}

.wechat-btn[disabled] {
    background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
    opacity: 0.7;
}

.btn-text {
    color: #fff;
}

.skip-link {
    text-align: center;
    padding: 32rpx 0;
}

.skip-link text {
    font-size: 28rpx;
    color: #999;
}

.agreement {
    text-align: center;
}

.agreement-text {
    font-size: 24rpx;
    color: #999;
    line-height: 1.6;
}

.agreement .link {
    color: #667eea;
}
/* pages/login/login.wxss */
.login-container {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background: linear-gradient(180deg, var(--md-sys-color-background) 0%, var(--md-sys-color-surface-container) 100%);
    padding: 0 var(--spacing-xl);
    box-sizing: border-box;
}

/* 顶部区域 */
.login-header {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 120rpx;
}

.logo-wrapper {
    margin-bottom: var(--spacing-lg);
}

.logo-circle {
    width: 180rpx;
    height: 180rpx;
    background: var(--md-sys-color-primary-container);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--md-sys-elevation-3);
}

.logo-text {
    font-size: 48rpx;
    font-weight: bold;
    color: var(--md-sys-color-on-primary-container);
}

.app-name {
    font-size: var(--md-sys-typescale-headline-medium);
    font-weight: bold;
    color: var(--md-sys-color-on-background);
    margin-bottom: var(--spacing-xs);
}

.app-slogan {
    font-size: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface-variant);
}

/* 中间内容区 */
.login-content {
    padding: 60rpx 0;
}

.feature-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
}

.feature-item {
    display: flex;
    align-items: center;
    gap: 20rpx;
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--md-sys-color-surface-container-lowest);
    border-radius: var(--md-sys-shape-corner-medium);
    box-shadow: var(--md-sys-elevation-1);
}

.feature-text {
    font-size: var(--md-sys-typescale-body-large);
    color: var(--md-sys-color-on-surface);
}

/* 底部登录区 */
.login-footer {
    padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.login-btn {
    width: 100%;
    height: 96rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xs);
    border-radius: 48rpx;
    font-size: var(--md-sys-typescale-label-large);
    font-weight: 500;
    border: none;
}

.wechat-btn {
    background: #07c160;
    /* WeChat Green standard, keeping specific brand color */
    color: #ffffff;
    box-shadow: var(--md-sys-elevation-2);
}

.wechat-btn[disabled] {
    background: #07c160;
    opacity: 0.7;
}

.btn-text {
    color: #ffffff;
}

.skip-link {
    text-align: center;
    padding: 32rpx 0;
}

.skip-link text {
    font-size: var(--md-sys-typescale-body-medium);
    color: var(--md-sys-color-outline);
}

.agreement {
    text-align: center;
}

.agreement-text {
    font-size: var(--md-sys-typescale-body-small);
    color: var(--md-sys-color-outline);
    line-height: 1.6;
}

.agreement .link {
    color: var(--color-primary);
}

/* 手机号绑定弹窗样式 */
.phone-modal {
    width: 600rpx;
    padding: 60rpx 40rpx;
    box-sizing: border-box;
}

.modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 40rpx;
}

.modal-title {
    font-size: 36rpx;
    font-weight: bold;
    color: var(--color-text-main);
}

.modal-content {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.modal-desc {
    font-size: 28rpx;
    color: var(--color-text-secondary);
    text-align: center;
    margin-bottom: 60rpx;
    line-height: 1.5;
}

.phone-btn {
    width: 100%;
    height: 96rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--spacing-xs);
    border-radius: 48rpx;
    font-size: 32rpx;
    font-weight: 500;
    border: none;
    background: var(--color-primary);
    color: var(--color-text-inverse);
    box-shadow: var(--shadow-lg);
    margin-bottom: 40rpx;
}

.phone-btn[disabled] {
    background: var(--color-primary);
    opacity: 0.7;
}

.modal-tip {
    font-size: 24rpx;
    color: var(--color-text-tertiary);
    text-align: center;
}
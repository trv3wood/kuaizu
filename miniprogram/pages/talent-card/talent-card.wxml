<!-- pages/talent-card/talent-card.wxml -->
<view class="talent-card-container">
  <view class="hero-nav" style="padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + navBarHeight}}px;">
    <view class="hero-nav-row">
      <view class="nav-action {{showBackButton ? '' : 'nav-back-hidden'}}" bindtap="handleBack">
        <van-icon name="arrow-left" size="18px" color="#101010" />
      </view>
      <view class="nav-capsule-placeholder"></view>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-container" wx:if="{{loading}}">
    <van-loading size="24px">加载中...</van-loading>
  </view>
  <block wx:else>
    <!-- 无名片时提示去创建 -->
    <view class="empty-state" wx:if="{{!profile}}">
      <view class="page-title">{{pageTitle}}</view>
      <view class="page-subtitle">{{pageSubtitle}}</view>
      <view class="primary-action create-btn ui-btn ui-btn--pill ui-btn--lg ui-btn--primary" bindtap="handleEdit">
        <text>创建名片</text>
      </view>
    </view>
    <!-- 查看模式 -->
    <view class="view-mode" wx:else>
      <view class="page-title">{{pageTitle}}</view>
      <view class="page-subtitle">{{pageSubtitle}}</view>
      <view class="card-edit-hint">{{cardHintText}}</view>
      <!-- 核心人才卡片 -->
      <view class="card-wrapper" bindtap="handleEdit">
        <view class="talent-card ui-card ui-card--xl">
          <!-- 左侧边栏色彩 -->
          <view class="card-side-bar">
            <view class="side-blue"></view>
            <view class="side-yellow"></view>
          </view>
          <view class="card-main">
            <!-- 个人基本信息 -->
            <view class="card-header">
              <view class="header-left">
                <view class="name-row">
                  <text class="name">{{displayName}}</text>
                  <auth-badge isVerified="{{isVerified}}" size="compact" />
                </view>
                <view class="school-row">
                  <view class="divider-line"></view>
                  <view class="school-info">
                    <view class="school-name">
                      {{user.school.schoolName || profile.schoolName || ''}}
                    </view>
                    <view class="major-name">
                      {{user.major.majorName || profile.majorName || ''}}
                    </view>
                  </view>
                </view>
              </view>
              <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" />
            </view>
            <!-- 联系信息 -->
            <view class="contact-area">
              <view class="contact-item">
                <van-icon name="phone-o" color="#559dfc" size="14px" />
                <text class="contact-text">电话：{{user.phone || '未填写'}}</text>
              </view>
              <view class="contact-item">
                <van-icon name="chat-o" color="#559dfc" size="14px" />
                <text class="contact-text">微信：{{user.wechat || '未填写'}}</text>
              </view>
              <view class="contact-item">
                <van-icon name="envelop-o" color="#559dfc" size="14px" />
                <text class="contact-text">邮箱：{{user.email || '未填写'}}</text>
              </view>
            </view>
            <!-- MBTI -->
            <view class="mbti-display" wx:if="{{profile.mbti}}">
              <text class="mbti-text">{{profile.mbti}}</text>
              <view class="mbti-shadow-box"></view>
            </view>
          </view>
        </view>
        <!-- 状态提示 -->
        <view class="status-tip {{statusTipClassName}}">
          <text>{{statusTipText}}</text>
        </view>
      </view>
      <!-- 操作按钮 -->
      <view class="bottom-area ui-bottom-bar ui-bottom-bar--transparent">
        <view class="secondary-btns" wx:if="{{viewStrategy.showSecondaryActions}}">
          <view class="action-card ui-card ui-card--xl ui-card--shadow-pop" bindtap="handleEdit">
            <van-icon name="edit" size="24px" />
            <text>编辑名片</text>
          </view>
          <button class="action-card share-btn ui-btn ui-card ui-card--xl ui-card--shadow-pop" open-type="share">
            <van-icon name="share-o" size="24px" />
            <text>分享名片</text>
          </button>
        </view>
        <view class="primary-action ui-btn ui-btn--pill ui-btn--lg {{primaryActionClassName}} {{primaryActionDisabled ? 'disabled' : ''}}" bindtap="handlePrimaryAction">
          <text>{{shelfActionLoading ? '处理中...' : primaryActionText}}</text>
        </view>
      </view>
    </view>
  </block>
</view>

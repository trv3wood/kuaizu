<!-- pages/talent-card/talent-card.wxml -->
<view class="talent-card-container">
    <!-- 加载中 -->
    <view class="loading-container" wx:if="{{loading}}">
        <van-loading size="24px">加载中...</van-loading>
    </view>
    <block wx:else>
        <!-- 查看模式 -->
        <view class="view-mode" wx:if="{{!isEditing && profile}}">
            <!-- 头部卡片 -->
            <view class="profile-header">
                <image class="avatar" src="{{avatarUrl || '/assets/default-avatar.png'}}" mode="aspectFill" />
                <view class="info">
                    <text class="name">{{displayName}}</text>
                    <text class="school">
                        {{user.school.schoolName || ''}} · {{user.major.majorName || ''}}
                    </text>
                </view>
                <van-tag wx:if="{{profile.status === 1}}" type="success" plain>已发布</van-tag>
                <van-tag wx:else type="default" plain>未发布</van-tag>
            </view>
            <!-- 技能标签 -->
            <view class="section">
                <view class="section-title">技能标签</view>
                <view class="skills-list">
                    <van-tag wx:for="{{profile.skills}}" wx:key="*this" type="primary" plain round>
                        {{item}}
                    </van-tag>
                    <text class="empty-hint" wx:if="{{!profile.skills || profile.skills.length === 0}}">
                        暂未添加技能
                    </text>
                </view>
            </view>
            <!-- 简介 -->
            <view class="section">
                <view class="section-title">个人简介</view>
                <text class="section-content">{{profile.intro || '暂无简介'}}</text>
            </view>
            <!-- MBTI -->
            <view class="section" wx:if="{{profile.mbti}}">
                <view class="section-title">MBTI</view>
                <van-tag type="warning" plain size="large">{{profile.mbti}}</van-tag>
            </view>
            <!-- 自我评价 -->
            <view class="section" wx:if="{{form.selfEvaluation}}">
                <view class="section-title">自我评价</view>
                <text class="section-content">{{form.selfEvaluation}}</text>
            </view>
            <!-- 项目经历 -->
            <view class="section" wx:if="{{form.projectExperience}}">
                <view class="section-title">项目经历</view>
                <text class="section-content">{{form.projectExperience}}</text>
            </view>
            <!-- 编辑按钮 -->
            <view class="action-bar">
                <button class="edit-btn" bindtap="handleEdit">编辑名片</button>
            </view>
        </view>
        <!-- 编辑模式 -->
        <view class="edit-mode" wx:else>
            <!-- 技能标签 -->
            <van-cell-group inset title="技能标签 (必填)">
                <view class="skills-edit">
                    <view class="skills-tags">
                        <van-tag wx:for="{{form.skills}}" wx:key="*this" type="primary" closeable data-index="{{index}}" bind:close="handleRemoveSkill">
                            {{item}}
                        </van-tag>
                    </view>
                    <view class="skill-input-row">
                        <input class="skill-input" placeholder="输入技能，如 Python" value="{{skillInput}}" bindinput="handleSkillInput" bindconfirm="handleAddSkill" />
                        <button class="add-skill-btn" bindtap="handleAddSkill">添加</button>
                    </view>
                </view>
            </van-cell-group>
            <!-- 简介 -->
            <van-cell-group inset title="个人简介 (必填)">
                <van-field type="textarea" placeholder="简单介绍一下自己..." value="{{form.intro}}" data-field="intro" bind:input="handleInput" autosize="{{ { minHeight: 80 } }}" />
            </van-cell-group>
            <!-- MBTI -->
            <van-cell-group inset title="MBTI (选填)">
                <van-cell title="MBTI类型" is-link>
                    <picker mode="selector" range="{{mbtiOptions}}" value="{{mbtiIndex}}" bindchange="handleMbtiChange">
                        <view class="picker-value">{{form.mbti || '请选择'}}</view>
                    </picker>
                </van-cell>
            </van-cell-group>
            <!-- 自我评价 -->
            <van-cell-group inset title="自我评价 (选填)">
                <van-field type="textarea" placeholder="描述你的优势和特点..." value="{{form.selfEvaluation}}" data-field="selfEvaluation" bind:input="handleInput" autosize="{{ { minHeight: 80 } }}" />
            </van-cell-group>
            <!-- 项目经历 -->
            <van-cell-group inset title="项目经历 (选填)">
                <van-field type="textarea" placeholder="介绍你参与过的项目..." value="{{form.projectExperience}}" data-field="projectExperience" bind:input="handleInput" autosize="{{ { minHeight: 80 } }}" />
            </van-cell-group>
            <!-- 隐私设置 -->
            <van-cell-group inset title="隐私设置">
                <van-cell title="公开联系方式" center>
                    <switch checked="{{form.isPublicContact}}" bindchange="handleContactSwitch" color="#667eea" />
                </van-cell>
            </van-cell-group>
            <!-- 操作按钮 -->
            <view class="action-bar edit-actions">
                <button class="cancel-btn" bindtap="handleCancel">取消</button>
                <button class="save-btn" loading="{{saving}}" disabled="{{saving}}" bindtap="handleSave">
                    保存
                </button>
            </view>
        </view>
    </block>
</view>
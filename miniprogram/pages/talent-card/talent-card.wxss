/* pages/talent-card/talent-card.wxss */

/* ===== 全局背景 ===== */
.talent-card-container {
  min-height: 100vh;
  padding: 0 44rpx calc(200rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  position: relative;
  z-index: 1;
}

.talent-card-container::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 800rpx;
  background: linear-gradient(180deg, #c4f1ff 0%, #eaf4fc 35%, #fafbfc 100%);
  z-index: -1;
}

/* ===== 加载中 ===== */
.loading-container {
  padding: 180rpx 0;
  display: flex;
  justify-content: center;
}

.hero-nav-row {
  padding: 0 22rpx;
}

/* ===== 空状态 ===== */
.empty-state {
  padding-top: 40rpx;
}

.view-mode {
  padding-top: 40rpx;
}

.empty-state .create-btn {
  margin-top: 80rpx;
}

/* ===== 标题区域 ===== */
.page-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #000000;
  margin-top: 0;
}

.page-subtitle {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.5);
  margin: 12rpx 0 60rpx;
  line-height: 36rpx;
}

.card-edit-hint {
  margin: 0 0 34rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.22);
}

/* ===== 人才卡片 ===== */
.card-wrapper {
  position: relative;
  width: 100%;
}

.talent-card {
  box-shadow: 4rpx 8rpx 32rpx rgba(0, 0, 0, 0.12);
  display: flex;
  height: 420rpx;
  overflow: hidden;
}

.card-side-bar {
  width: 24rpx;
  display: flex;
  flex-direction: column;
}

.side-blue {
  flex: 6;
  background: #559dfc;
}

.side-yellow {
  flex: 4;
  background: #faa051;
}

.card-main {
  flex: 1;
  padding: 40rpx 40rpx 32rpx;
  position: relative;
  display: flex;
  flex-direction: column;
}

.card-header {
  display: flex;
  justify-content: space-between;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.name {
  font-size: 40rpx;
  font-weight: 700;
  color: #000000;
}

.school-row {
  position: relative;
  padding-left: 20rpx;
}

.divider-line {
  position: absolute;
  left: 0;
  top: 0;
  width: 200rpx;
  height: 1rpx;
  background: #000000;
}

.school-info {
  padding-top: 16rpx;
}

.school-name,
.major-name {
  font-size: 20rpx;
  color: #000000;
  line-height: 28rpx;
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.contact-area {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.contact-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.contact-text {
  font-size: 20rpx;
  color: #000000;
  font-weight: 500;
}

.mbti-display {
  position: absolute;
  right: 0;
  bottom: 0;
  height: 80rpx;
  display: flex;
  align-items: center;
}

.mbti-text {
  position: relative;
  z-index: 10;
  font-size: 64rpx;
  font-weight: 700;
  color: #000000;
  padding-right: 48rpx;
}

.mbti-shadow-box {
  position: absolute;
  right: 0;
  bottom: 24rpx;
  width: 130rpx;
  height: 40rpx;
  background: #3e84fa;
  opacity: 0.6;
}

.status-tip {
  text-align: center;
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #faa051;
  font-weight: 600;
}

.status-tip.published {
  color: #55c4a5;
}

.status-tip.reviewing {
  color: #6f8ef6;
}

/* ===== 底部操作区 ===== */
.bottom-area {
  padding: 32rpx 44rpx calc(44rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.secondary-btns {
  display: flex;
  gap: 24rpx;
}

.action-card {
  flex: 1;
  height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 34rpx;
  font-weight: bold;
  color: #000000;
}

.primary-action {
  height: 114rpx;
  box-shadow: 0 8rpx 24rpx rgba(62, 132, 250, 0.3);
}

.primary-action.disabled {
  opacity: 0.6;
  box-shadow: none;
}

.primary-action--light {
  background: #ffffff;
  color: #111111;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.14);
}

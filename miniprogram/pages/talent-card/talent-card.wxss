/* pages/talent-card/talent-card.wxss */
.talent-card-container {
    min-height: 100vh;
    background: #f5f6fa;
    padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 加载中 */
.loading-container {
    padding: 100rpx 0;
    display: flex;
    justify-content: center;
}

/* 查看模式 */
.view-mode {
    padding: 24rpx;
}

.profile-header {
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 20rpx;
    padding: 32rpx;
    margin-bottom: 24rpx;
}

.avatar {
    width: 120rpx;
    height: 120rpx;
    border-radius: 50%;
    border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.info {
    flex: 1;
    margin-left: 24rpx;
}

.name {
    font-size: 36rpx;
    font-weight: bold;
    color: #fff;
    display: block;
}

.school {
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.8);
    margin-top: 8rpx;
}

.section {
    background: #fff;
    border-radius: 16rpx;
    padding: 24rpx;
    margin-bottom: 24rpx;
}

.section-title {
    font-size: 28rpx;
    font-weight: 500;
    color: #333;
    margin-bottom: 16rpx;
}

.section-content {
    font-size: 28rpx;
    color: #666;
    line-height: 1.6;
}

.skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
}

.empty-hint {
    font-size: 26rpx;
    color: #999;
}

/* 编辑模式 */
.edit-mode {
    padding-top: 24rpx;
}

.skills-edit {
    padding: 24rpx;
}

.skills-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin-bottom: 20rpx;
}

.skill-input-row {
    display: flex;
    gap: 16rpx;
}

.skill-input {
    flex: 1;
    height: 72rpx;
    background: #f5f6fa;
    border-radius: 12rpx;
    padding: 0 24rpx;
    font-size: 28rpx;
}

.add-skill-btn {
    width: 120rpx;
    height: 72rpx;
    line-height: 72rpx;
    background: #667eea;
    color: #fff;
    font-size: 26rpx;
    border-radius: 12rpx;
    padding: 0;
    border: none;
}

.add-skill-btn::after {
    border: none;
}

.picker-value {
    color: #323233;
}

/* 操作按钮 */
.action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 24rpx 32rpx;
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    background: #fff;
    box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.edit-btn,
.save-btn {
    flex: 2;
    height: 96rpx;
    line-height: 96rpx;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
    font-size: 32rpx;
    font-weight: 500;
    border-radius: 48rpx;
    border: none;
}

.edit-btn::after,
.save-btn::after {
    border: none;
}

.view-actions,
.edit-actions {
    display: flex;
    gap: 24rpx;
}

.unpublish-btn,
.cancel-btn {
    flex: 1;
    height: 96rpx;
    line-height: 96rpx;
    background: #f5f6fa;
    color: #666;
    font-size: 32rpx;
    border-radius: 48rpx;
    border: none;
}

.unpublish-btn::after,
.cancel-btn::after {
    border: none;
}

.save-btn {
    flex: 2;
}

.save-btn[disabled] {
    opacity: 0.7;
}
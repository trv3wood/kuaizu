/* pages/talent-card/talent-card.wxss */
.talent-card-container {
    min-height: 100vh;
    background: var(--bg-color);
    padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 加载中 */
.loading-container {
    padding: 100rpx 0;
    display: flex;
    justify-content: center;
}

/* 查看模式 */
.view-mode {
    padding: 30rpx;
}

.profile-header {
    display: flex;
    align-items: center;
    background: #e8f4ff;
    border-radius: 32rpx;
    padding: 40rpx;
    margin-bottom: 24rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.avatar {
    width: 120rpx;
    height: 120rpx;
    border-radius: 50%;
    border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.info {
    flex: 1;
    margin-left: 30rpx;
}

.name {
    font-size: 36rpx;
    font-weight: bold;
    color: var(--primary-color);
    display: block;
}

.school {
    font-size: 28rpx;
    color: var(--primary-color);
    opacity: 0.8;
    margin-top: 8rpx;
}

.section {
    background: var(--card-bg);
    border-radius: 24rpx;
    padding: 30rpx;
    margin-bottom: 30rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.section-title {
    font-size: 32rpx;
    font-weight: 500;
    color: var(--text-main);
    margin-bottom: 16rpx;
}

.section-content {
    font-size: 32rpx;
    color: var(--text-gray);
    line-height: 1.6;
}

.skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
}

.empty-hint {
    font-size: 28rpx;
    color: var(--text-gray);
}

/* 编辑模式 */
.edit-mode {
    padding-top: 30rpx;
}

.skills-edit {
    padding: 30rpx;
}

.skills-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin-bottom: 20rpx;
}

.skill-input-row {
    display: flex;
    gap: 16rpx;
}

.skill-input {
    flex: 1;
    height: 72rpx;
    background: #f5f7fa;
    border-radius: 24rpx;
    padding: 0 30rpx;
    font-size: 32rpx;
    color: var(--text-main);
}

.add-skill-btn {
    width: 120rpx;
    height: 72rpx;
    line-height: 72rpx;
    background: var(--primary-color);
    color: #ffffff;
    font-size: 20rpx;
    border-radius: 24rpx;
    padding: 0;
    border: none;
}

.add-skill-btn::after {
    border: none;
}

.picker-value {
    color: var(--text-main);
}

/* 操作按钮 */
.action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 30rpx 40rpx;
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    background: var(--card-bg);
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.edit-btn,
.save-btn {
    flex: 2;
    height: 96rpx;
    line-height: 96rpx;
    background: var(--primary-color);
    color: #ffffff;
    font-size: 28rpx;
    font-weight: 500;
    border-radius: 48rpx;
    border: none;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.edit-btn::after,
.save-btn::after {
    border: none;
}

.view-actions,
.edit-actions {
    display: flex;
    gap: 30rpx;
}

.unpublish-btn,
.cancel-btn {
    flex: 1;
    height: 96rpx;
    line-height: 96rpx;
    background: #f0f0f0;
    color: var(--text-main);
    font-size: 28rpx;
    border-radius: 48rpx;
    border: none;
}

.unpublish-btn::after,
.cancel-btn::after {
    border: none;
}

.save-btn {
    flex: 2;
}

.save-btn[disabled] {
    background: var(--text-main);
    opacity: 0.12;
    color: var(--text-main);
}
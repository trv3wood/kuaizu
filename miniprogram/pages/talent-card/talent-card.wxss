/* pages/talent-card/talent-card.wxss */
.talent-card-container {
    min-height: 100vh;
    background: var(--color-bg-base);
    padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 加载中 */
.loading-container {
    padding: 100rpx 0;
    display: flex;
    justify-content: center;
}

/* 查看模式 */
.view-mode {
    padding: var(--spacing-sm);
}

.profile-header {
    display: flex;
    align-items: center;
    background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary-dark) 100%);
    border-radius: var(--radius-lg);
    padding: var(--spacing-md);
    margin-bottom: 24rpx;
}

.avatar {
    width: 120rpx;
    height: 120rpx;
    border-radius: 50%;
    border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.info {
    flex: 1;
    margin-left: var(--spacing-sm);
}

.name {
    font-size: 36rpx;
    font-weight: bold;
    color: var(--color-text-inverse);
    display: block;
}

.school {
    font-size: 24rpx;
    color: rgba(255, 255, 255, 0.8);
    margin-top: 8rpx;
}

.section {
    background: var(--color-bg-card);
    border-radius: var(--radius-md);
    padding: var(--spacing-sm);
    margin-bottom: var(--spacing-sm);
}

.section-title {
    font-size: 28rpx;
    font-weight: 500;
    color: var(--color-text-main);
    margin-bottom: var(--spacing-xs);
}

.section-content {
    font-size: 28rpx;
    color: var(--color-text-secondary);
    line-height: 1.6;
}

.skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
}

.empty-hint {
    font-size: 26rpx;
    color: var(--color-text-tertiary);
}

/* 编辑模式 */
.edit-mode {
    padding-top: var(--spacing-sm);
}

.skills-edit {
    padding: var(--spacing-sm);
}

.skills-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12rpx;
    margin-bottom: 20rpx;
}

.skill-input-row {
    display: flex;
    gap: var(--spacing-xs);
}

.skill-input {
    flex: 1;
    height: 72rpx;
    background: var(--color-bg-base);
    border-radius: 12rpx;
    padding: 0 var(--spacing-sm);
    font-size: 28rpx;
}

.add-skill-btn {
    width: 120rpx;
    height: 72rpx;
    line-height: 72rpx;
    background: var(--color-primary);
    color: var(--color-text-inverse);
    font-size: 26rpx;
    border-radius: 12rpx;
    padding: 0;
    border: none;
}

.add-skill-btn::after {
    border: none;
}

.picker-value {
    color: var(--color-text-main);
}

/* 操作按钮 */
.action-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--spacing-sm) var(--spacing-md);
    padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
    background: var(--color-bg-card);
    box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.edit-btn,
.save-btn {
    flex: 2;
    height: 96rpx;
    line-height: 96rpx;
    background: linear-gradient(135deg, var(--color-primary-light) 0%, var(--color-primary-dark) 100%);
    color: var(--color-text-inverse);
    font-size: 32rpx;
    font-weight: 500;
    border-radius: 48rpx;
    border: none;
}

.edit-btn::after,
.save-btn::after {
    border: none;
}

.view-actions,
.edit-actions {
    display: flex;
    gap: var(--spacing-sm);
}

.unpublish-btn,
.cancel-btn {
    flex: 1;
    height: 96rpx;
    line-height: 96rpx;
    background: var(--color-bg-base);
    color: var(--color-text-secondary);
    font-size: 32rpx;
    border-radius: 48rpx;
    border: none;
}

.unpublish-btn::after,
.cancel-btn::after {
    border: none;
}

.save-btn {
    flex: 2;
}

.save-btn[disabled] {
    opacity: 0.7;
}
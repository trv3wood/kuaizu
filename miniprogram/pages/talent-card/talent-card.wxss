/* pages/talent-card/talent-card.wxss */

/* ===== 全局背景与布局 ===== */
.talent-card-container {
    min-height: 100vh;
    background: #f6f7fb; /* 编辑模式下的主体背景色 */
    padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
    box-sizing: border-box;
    position: relative;
    z-index: 1;
}

/* 背景渐变遮罩 (只在查看模式常用，但这里可以定义) */
.talent-card-container::before {
    content: "";
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 800rpx;
    background: linear-gradient(180deg, #e8f9ff 0%, #f6fafd 13%, #f6fafd 100%);
    z-index: -1;
}

/* ===== 加载中 ===== */
.loading-container {
    padding: 100rpx 0;
    display: flex;
    justify-content: center;
}

/* ===== 查看模式 (保持原有精美样式) ===== */
.view-mode {
    padding: 0 44rpx;
}

.view-mode .page-title {
    font-size: 48rpx;
    font-weight: 700;
    color: #000000;
    margin-top: 60rpx;
}

.view-mode .page-subtitle {
    font-size: 24rpx;
    color: rgba(0, 0, 0, 0.5);
    margin: 12rpx 0 60rpx;
    line-height: 36rpx;
}

.card-wrapper {
    position: relative;
    width: 100%;
}

.talent-card {
    background: #ffffff;
    border-radius: 40rpx;
    box-shadow: 4rpx 8rpx 32rpx rgba(0, 0, 0, 0.12);
    display: flex;
    height: 420rpx;
    overflow: hidden;
    position: relative;
}

.card-side-bar {
    width: 24rpx;
    display: flex;
    flex-direction: column;
}

.side-blue { flex: 6; background: #559dfc; }
.side-yellow { flex: 4; background: #faa051; }

.card-main {
    flex: 1;
    padding: 40rpx 40rpx 32rpx;
    position: relative;
    display: flex;
    flex-direction: column;
}

.card-header { display: flex; justify-content: space-between; }
.name-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 24rpx; }
.name { font-size: 40rpx; font-weight: 700; color: #000000; }
.unverified-text { font-size: 20rpx; color: rgba(0, 0, 0, 0.3); border: 1rpx solid rgba(0, 0, 0, 0.2); border-radius: 4rpx; padding: 2rpx 8rpx; }
.school-row { position: relative; padding-left: 20rpx; }
.divider-line { position: absolute; left: 0; top: 0; width: 200rpx; height: 1rpx; background: #000000; }
.school-info { padding-top: 16rpx; }
.school-name, .major-name { font-size: 20rpx; color: #000000; line-height: 28rpx; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: #f0f0f0; }

.contact-area { margin-top: 40rpx; display: flex; flex-direction: column; gap: 12rpx; }
.contact-item { display: flex; align-items: center; gap: 12rpx; }
.contact-text { font-size: 20rpx; color: #000000; font-weight: 500; }

.mbti-display { position: absolute; right: 0; bottom: 0; height: 80rpx; display: flex; align-items: center; }
.mbti-text { position: relative; z-index: 10; font-size: 64rpx; font-weight: 700; color: #000000; padding-right: 48rpx; }
.mbti-shadow-box { position: absolute; right: 0; bottom: 24rpx; width: 130rpx; height: 40rpx; background: #3e84fa; opacity: 0.6; }

.status-tip { text-align: center; margin-top: 32rpx; font-size: 28rpx; color: #faa051; font-weight: 600; }
.status-tip.published { color: #3e84fa; }

.bottom-area {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    padding: 32rpx 44rpx calc(44rpx + env(safe-area-inset-bottom));
    display: flex;
    flex-direction: column;
    gap: 28rpx;
    background: transparent;
}

.secondary-btns { display: flex; gap: 24rpx; }
.action-card {
    flex: 1;
    background: #ffffff;
    border-radius: 40rpx;
    height: 140rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16rpx;
    box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
    font-size: 34rpx;
    font-weight: bold;
    color: #000000;
}
.share-btn { padding: 0; margin: 0; border: none; }
.primary-action {
    background: #3e84fa;
    color: #ffffff;
    border-radius: 40rpx;
    height: 114rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 34rpx;
    font-weight: 700;
    box-shadow: 0 8rpx 24rpx rgba(62, 132, 250, 0.3);
}

/* ===== 编辑模式 (Figma: 1:2637) ===== */
.edit-mode {
    padding: 30rpx 44rpx;
}

/* 更换头像部分 */
.edit-avatar-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 40rpx;
}

.avatar-wrapper {
    width: 180rpx;
    height: 180rpx;
    border-radius: 50%;
    background: #f0f0f0;
    overflow: hidden;
    margin-bottom: 16rpx;
}

.edit-avatar {
    width: 100%;
    height: 100%;
}

.change-hint {
    font-size: 24rpx;
    font-weight: bold;
    color: #acacac;
}

/* 模块标题 */
.edit-section-title {
    font-size: 28rpx;
    font-weight: bold;
    color: #000000;
    text-align: center;
    margin-bottom: 24rpx;
}

/* 表单卡片 */
.edit-section {
    margin-bottom: 40rpx;
}

.edit-card {
    background: #ffffff;
    border-radius: 40rpx;
    padding: 10rpx 44rpx;
    box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.edit-card.no-padding {
    padding: 0;
    overflow: hidden;
}

/* 表单行 */
.form-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 88rpx;
    border-bottom: 1rpx solid #f0f0f0;
    padding: 10rpx 0;
}

.form-item:last-child {
    border-bottom: none;
}

.form-item .label {
    font-size: 28rpx;
    font-weight: bold;
    color: #868686;
    min-width: 120rpx;
}

.form-item .value {
    flex: 1;
    text-align: right;
    font-size: 28rpx;
    font-weight: bold;
    color: #000000;
}

.form-item .value.disabled {
    color: #868686;
}

/* MBTI 选择器样式 (垂直排列) */
.mbti-selector-container {
    padding: 24rpx 0;
}

.mbti-pills {
    display: flex;
    justify-content: flex-end;
    gap: 16rpx;
    margin-top: 10rpx;
}

.mbti-pill-group {
    display: flex;
    flex-direction: column;
    gap: 12rpx;
    background: #f7f8fa;
    border-radius: 40rpx;
    padding: 8rpx;
}

.mbti-pill {
    width: 100rpx;
    height: 100rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 40rpx;
    background: transparent;
    transition: all 0.2s;
}

.mbti-pill.active {
    background: #cff2fe;
}

.mbti-pill .main {
    font-size: 28rpx;
    font-weight: bold;
    color: #000000;
}

.mbti-pill .sub {
    font-size: 22rpx;
    font-weight: bold;
    color: #000000;
}

.mbti-pill:not(.active) .main,
.mbti-pill:not(.active) .sub {
    opacity: 0.5;
}

/* 文本域 */
.edit-textarea {
    width: 100%;
    min-height: 200rpx;
    padding: 32rpx 44rpx;
    box-sizing: border-box;
    font-size: 28rpx;
    font-weight: bold;
    color: #868686;
    line-height: 40rpx;
}

/* 标签编辑 */
.tag-edit-box {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24rpx 44rpx;
}

.tag-hint {
    font-size: 24rpx;
    font-weight: bold;
    color: #868686;
    line-height: 40rpx;
}

.add-tag-btn {
    width: 140rpx;
    height: 88rpx;
    line-height: 88rpx;
    text-align: center;
    background: #559dfc;
    color: #ffffff;
    border-radius: 40rpx;
    font-size: 32rpx;
    font-weight: bold;
}

.current-tags {
    margin-top: 24rpx;
    display: flex;
    flex-wrap: wrap;
    gap: 16rpx;
}

.tag-item {
    background: #cff2fe;
    border-radius: 40rpx;
    padding: 8rpx 24rpx;
    display: flex;
    align-items: center;
    gap: 8rpx;
    font-size: 24rpx;
    font-weight: bold;
}

/* 编辑模式底部按钮栏 */
.edit-footer {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    padding: 24rpx 54rpx calc(44rpx + env(safe-area-inset-bottom));
    display: flex;
    gap: 40rpx;
    background: #ffffff;
    box-shadow: 0px -8rpx 8rpx 0px rgba(0, 0, 0, 0.15);
    z-index: 100;
}

.edit-footer .cancel-btn {
    flex: 1;
    height: 88rpx;
    line-height: 88rpx;
    text-align: center;
    background: #ebebeb;
    border-radius: 40rpx;
    font-size: 34rpx;
    font-weight: bold;
    color: #000000;
}

.edit-footer .save-btn {
    flex: 2;
    height: 88rpx;
    line-height: 88rpx;
    text-align: center;
    background: #3e84fa;
    color: #ffffff;
    border-radius: 40rpx;
    font-size: 34rpx;
    font-weight: bold;
}

.edit-footer .save-btn.disabled {
    opacity: 0.6;
}
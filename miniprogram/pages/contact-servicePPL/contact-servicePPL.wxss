/* pages/contact-servicePPL/contact-servicePPL.wxss */

.service-container {
  padding: 0 30rpx;
  display: flex;
  flex-direction: column;
}

.service-card {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background-color: #fff;
  margin-top: 50rpx;
  padding: 30rpx;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.service-card::after {
  border: none;
}

.card-icon {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-icon image {
  width: 100%;
  height: 100%;
}

.card-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: bold;
  margin-left: 30rpx;
}

.card-arrow {
  font-size: 36rpx;
  color: #999;
  font-weight: bold;
}

/* 弹窗样式 */
.popup-content {
  padding: 50rpx 40rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 520rpx;
}

.popup-icon {
  width: 100rpx;
  height: 100rpx;
  margin-bottom: 40rpx;
}

.popup-icon image {
  width: 100%;
  height: 100%;
}

.popup-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15rpx;
  margin-bottom: 60rpx;
}

.popup-text > text {
  font-size: 35rpx;
  font-weight: bold;
}

.phone-number {
  font-size: 55rpx !important;
  font-weight: bold;
  color: #1989fa;
  margin-top: 20rpx;
}

.work-time {
  font-size: 30rpx !important;
  font-weight: normal !important;
  color: #666;
}

.popup-tip {
  font-size: 30rpx;
  color: #999;
  text-align: center;
  line-height: 1.6;
}
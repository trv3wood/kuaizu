/* pages/home/home.wxss */
.guide-container {
  min-height: 100vh;
  background: var(--color-bg-base);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 欢迎区域 */
.welcome-section {
  padding: 80rpx 40rpx 60rpx;
  text-align: center;
}

.welcome-header {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
}

.welcome-title {
  font-size: 56rpx;
  font-weight: bold;
  background: var(--color-text-main);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.welcome-subtitle {
  font-size: 30rpx;
  color: var(--color-text-tertiary);
  letter-spacing: 2rpx;
}

/* 导航卡片区域 */
.nav-cards {
  padding: 0 var(--spacing-md);
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.nav-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 40rpx;
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  box-shadow: var(--shadow-md);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.nav-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
}

.projects-card::before {
  background: var(--color-primary-light);
}

.talent-card::before {
  background: var(--color-primary-light);
}

.nav-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-sm);
}

/* 图标容器 */
.card-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.projects-icon {
  background: var(--color-primary);
}

.talent-icon {
  background: var(--color-primary);
}

/* 卡片内容 */
.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xxs);
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--color-text-main);
  margin-bottom: var(--spacing-xxs);
}

.card-desc {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

/* 箭头 */
.card-arrow {
  flex-shrink: 0;
}

/* 底部提示 */
.guide-footer {
  padding: 60rpx 40rpx;
  text-align: center;
}

.footer-text {
  font-size: 26rpx;
  color: var(--color-text-tertiary);
}
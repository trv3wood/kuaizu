/* pages/home/home.wxss */
.guide-container {
  min-height: 100vh;
  background: var(--bg-color);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 欢迎区域 */
.welcome-section {
  padding: 80rpx 40rpx 60rpx;
  text-align: center;
}

.welcome-header {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.welcome-title {
  font-size: 44rpx;
  font-weight: bold;
  color: var(--primary-color);
  /* Fallback or gradient text if needed */
  background: linear-gradient(45deg, var(--primary-color), var(--text-gray));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.welcome-subtitle {
  font-size: 32rpx;
  color: var(--text-gray);
  letter-spacing: 2rpx;
}

/* 导航卡片区域 */
.nav-cards {
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.nav-card {
  background: var(--card-bg);
  border-radius: 32rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  gap: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  border: 1px solid transparent;
}

.nav-card:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  background-color: #f5f7fa;
}

/* 图标容器 */
.card-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.projects-icon {
  background: #e8f4ff;
  color: var(--primary-color);
}

.talent-icon {
  background: #f5f7fa;
  color: var(--text-main);
}

/* 卡片内容 */
.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: var(--text-main);
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 28rpx;
  color: var(--text-gray);
  line-height: 1.5;
}

/* 箭头 */
.card-arrow {
  flex-shrink: 0;
  color: var(--text-gray);
}

/* 底部提示 */
.guide-footer {
  padding: 60rpx 40rpx;
  text-align: center;
}

.footer-text {
  font-size: 24rpx;
  color: var(--text-gray);
}
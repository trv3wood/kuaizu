/* pages/home/home.wxss */
.guide-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9fe 0%, #f0f2f8 100%);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 欢迎区域 */
.welcome-section {
  padding: 80rpx 40rpx 60rpx;
  text-align: center;
}

.welcome-header {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.welcome-title {
  font-size: 56rpx;
  font-weight: bold;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.welcome-subtitle {
  font-size: 30rpx;
  color: #888;
  letter-spacing: 2rpx;
}

/* 导航卡片区域 */
.nav-cards {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.nav-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  gap: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.nav-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  border-radius: 24rpx 24rpx 0 0;
}

.projects-card::before {
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}

.talent-card::before {
  background: linear-gradient(90deg, #764ba2 0%, #f093fb 100%);
}

.nav-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

/* 图标容器 */
.card-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.projects-icon {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.talent-icon {
  background: linear-gradient(135deg, #764ba2 0%, #f093fb 100%);
}

/* 卡片内容 */
.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
}

/* 箭头 */
.card-arrow {
  flex-shrink: 0;
}

/* 底部提示 */
.guide-footer {
  padding: 60rpx 40rpx;
  text-align: center;
}

.footer-text {
  font-size: 26rpx;
  color: #aaa;
}
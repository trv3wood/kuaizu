<!-- pages/home/home.wxml -->
<view class="home-container">
  <!-- Full-bleed background SVG -->
  <image class="home-bg" src="{{assets.HOME.BACKGROUND}}" mode="aspectFill" />

  <!-- 自定义导航栏 -->
  <view class="custom-nav">
    <view class="brand-block">
      <text class="nav-title">快组校园</text>
      <text class="nav-subtitle">校园组队工具</text>
    </view>
  </view>

  <!-- 主体内容 -->
  <view class="content">
    <!-- 导航卡片区域 -->
    <view class="nav-cards">
      <!-- 探索项目卡片 -->
      <view class="project-card" bindtap="navigateToProjects">
        <view class="card-top">
          <text class="card-title">校园项目</text>
          <image class="card-illustration" src="{{assets.HOME.PROJECT_SEARCH_ICON}}" mode="aspectFit"></image>
        </view>
        <view class="card-divider"></view>
        <view class="card-bottom">
          <image class="desc-icon" src="{{assets.HOME.PROJECT_ICON}}" mode="aspectFit"></image>
          <text class="card-desc">汇聚优质校园项目，你感兴趣的机会都在这里。</text>
        </view>
      </view>
      <!-- 探索人才卡片 -->
      <view class="project-card" bindtap="navigateToTalent">
        <view class="card-top">
          <text class="card-title">校园人才</text>
          <image class="card-illustration" src="{{assets.HOME.TALENT_COUNT_BG}}" mode="aspectFit"></image>
        </view>
        <view class="card-divider"></view>
        <view class="card-bottom">
          <image class="desc-icon" src="{{assets.HOME.TALENT_ICON}}" mode="aspectFit"></image>
          <text class="card-desc">链接优秀校园人才，与你同频的队友都在这里。</text>
        </view>
      </view>
    </view>
    <!-- 底部提示 -->
    <view class="guide-footer">
      <text class="footer-text">快组校园</text>
      <text class="footer-text2">了解快组校园→</text>
    </view>
  </view>
</view>
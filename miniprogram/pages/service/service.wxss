/* pages/service/service.wxss */
.service-container {
  min-height: 100vh;
  background: var(--color-bg-base);
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 快捷数据卡片 */
.quick-stats {
  display: flex;
  gap: var(--spacing-xs);
  padding: var(--spacing-sm);
}

.stat-card {
  flex: 1;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: var(--spacing-md) 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-sm);
}

.stat-icon {
  position: relative;
  margin-bottom: 12rpx;
}

.stat-icon van-tag {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
}

.stat-title {
  font-size: 26rpx;
  color: var(--color-text-main);
}

/* 未登录提示 */
.login-hint {
  margin: var(--spacing-lg) var(--spacing-sm);
  padding: 80rpx 0;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--spacing-xs);
}

.hint-text {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

/* 功能菜单 */
.menu-sections {
  padding-top: 12rpx;
}

.menu-sections van-cell-group {
  margin-bottom: 24rpx;
}